<xsl:template name="renderVaccinationDetailContainer">
    <xsl:param name="vaccinationCode" />
    <xsl:param name="divId" />
    <xsl:param name="parentDivId" />

    <div id="{$divId}" class="panel-collapse collapse d-print-block textSmall vaccinationHistoryContainer" data-parent="#{$parentDivId}">
        <div class="panel-body">
            <div class="headerRowInner">
                <xsl:variable name="hasManualRecommendedVaccination">
                    <xsl:call-template name="hasManualRecommendedVaccinationByVaccinationCode">
                        <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                    </xsl:call-template>
                </xsl:variable>
                <xsl:choose>
                    <xsl:when test="$hasManualRecommendedVaccination = 'true'">
                        <xsl:call-template name="renderNextManualRecommendedVaccinationView">
                            <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                        </xsl:call-template>
                        <p class="vaccinationGuidance">
                            <xsl:variable name="manualRecommendedVaccinationCommentByVaccinationCode">
                                <xsl:call-template name="getManualRecommendedVaccinationCommentByVaccinationCode">
                                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                </xsl:call-template>
                            </xsl:variable>
                            <strong>
                                <xsl:choose>
                                    <xsl:when test="$manualRecommendedVaccinationCommentByVaccinationCode != ''">
                                        <xsl:text>Ärztliche Handlungsempfehlung: </xsl:text>
                                        <xsl:value-of select="$manualRecommendedVaccinationCommentByVaccinationCode" />
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <xsl:text>Ärztliche Handlungsempfehlung</xsl:text>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </strong>
                        </p>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:call-template name="renderAutomatedRecommendedVaccinations">
                            <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                        </xsl:call-template>
                        <p class="vaccinationGuidance">
                            <xsl:variable name="actionCode">
                                <xsl:call-template name="getActionCode">
                                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                </xsl:call-template>
                            </xsl:variable>

                            <strong>
                                <xsl:text>Handlungsempfehlung: </xsl:text>
                                <xsl:choose>
                                    <xsl:when test="$actionCode!=''">
                                        <xsl:call-template name="getImmunizationActionTranslatedLong">
                                            <xsl:with-param name="actionCode" select="$actionCode" />
                                        </xsl:call-template>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <!-- Show default text when no actionCode is available -->
                                        <xsl:call-template name="getImmunizationActionTranslatedLong">
                                            <xsl:with-param name="actionCode" select="'171288004'" />
                                        </xsl:call-template>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </strong>
                        </p>
                    </xsl:otherwise>
                </xsl:choose>

                <xsl:call-template name="renderEntryHistoryContainer">
                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                </xsl:call-template>
            </div>
        </div>
    </div>
</xsl:template>

<xsl:template name="renderOtherHeader">
    <xsl:param name="section" />

    <div id="{$section}TitleContainer" class="container tableHeaderContainer">
        <div class="row sectionRowHeight textNormal">
            <div class="col-6 col-md-3 tableHeaderCol" style="padding: 0 0 0 15px;">
                <div class="justify-content-between">
