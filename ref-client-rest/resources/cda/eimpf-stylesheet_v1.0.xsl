<xsl:template name="renderVaccinationSectionEntryOther">
    <xsl:param name="vaccinationCode" />

    <xsl:variable name="immunizationName">
        <xsl:call-template name="getImmunizationTargetName">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
        </xsl:call-template>
    </xsl:variable>

    <xsl:variable name="searchProduct">
        <xsl:call-template name="getNextImmunizationProductName">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
        </xsl:call-template>
        <xsl:text>;</xsl:text>

        <xsl:for-each select="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']/../n1:code[@code=$vaccinationCode]/../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">

            <xsl:variable name="currentEntryIdRoot" select="../n1:id/@root" />
            <xsl:variable name="currentEntryIdExtension" select="../n1:id/@extension" />

            <xsl:call-template name="getVaccinationProductNameByEntryId">
                <xsl:with-param name="root" select="$currentEntryIdRoot" />
                <xsl:with-param name="extension" select="$currentEntryIdExtension" />
            </xsl:call-template>
            <xsl:text>;</xsl:text>
        </xsl:for-each>
    </xsl:variable>

    <xsl:variable name="lastEventType">
        <xsl:call-template name="getLastEventWithTime">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
        </xsl:call-template>
    </xsl:variable>

    <xsl:variable name="nextVaccinationRange">
        <xsl:call-template name="getNextVaccinationRange">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
        </xsl:call-template>
    </xsl:variable>

    <xsl:variable name="dropDownTitle">
        <xsl:call-template name="getImmunizationTargetName">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
        </xsl:call-template>
    </xsl:variable>

    <div id="row-{$vaccinationCode}" class="panel-group headerRow recommendationOtherRow"
         data-dropdown-title="{$dropDownTitle}" data-filter-target="{$vaccinationCode}" data-search-immunization-name="{$immunizationName}" data-search-immunization-product="{$searchProduct}">
        <div class="panel panel-default textNormal">
            <div class="panel-heading">
                <div class="panel-title">
                    <div class="container vaccinationRowContainer textNormal">
                        <div class="row">
                            <div class="col-6 col-md-3 my-auto my-center">
                                <h3 class="textVaccinationTitle text-break" data-test-id="row-{$vaccinationCode}-col-1">
                                    <xsl:value-of select="$immunizationName" />
                                </h3>
                            </div>
                            <div class="col-6 d-none d-md-block my-auto my-center" />
                            <div class="col-6 col-md-3 my-auto my-center media">
                                <span class="media-body my-auto my-center">
                                    <xsl:value-of select="$lastEventType" />
                                </span>
                                <xsl:if test="($nextVaccinationRange != '' or $lastEventType != '')">
                                    <button class="btn accordion-toggle collapsed accordionButton my-auto my-center" id="row-{$vaccinationCode}-toggle"
                                            data-toggle="collapse"  data-target="#row-{$vaccinationCode}-body" data-parent="#row-{$vaccinationCode}" aria-expanded="false" />
                                </xsl:if>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <xsl:call-template name="renderVaccinationDetailContainer">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
            <xsl:with-param name="divId" select="concat('row-', $vaccinationCode, '-body')" />
            <xsl:with-param name="parentDivId" select="concat('row-', $vaccinationCode)" />
        </xsl:call-template>

    </div>
</xsl:template>

<xsl:template name="renderActionCodeIcon">
    <xsl:param name="vaccinationCode" />

    <xsl:variable name="actionCode">
        <xsl:call-template name="getActionCode">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
        </xsl:call-template>
    </xsl:variable>

    <xsl:choose>
        <xsl:when test="$actionCode='424272000'">
            <xsl:call-template name="renderStatusIcon">
                <xsl:with-param name="img" select="$vaccinationRedFilledLarge" />
                <xsl:with-param name="toolTip">Unzureichende Immunität</xsl:with-param>
            </xsl:call-template>
        </xsl:when>
        <xsl:when test="$actionCode='789540001'">
            <xsl:call-template name="renderStatusIcon">
                <xsl:with-param name="img" select="$vaccinationRedFilledLarge" />
                <xsl:with-param name="toolTip">Impfung überfällig</xsl:with-param>
            </xsl:call-template>
        </xsl:when>
        <xsl:when test="$actionCode='171279008'">
            <xsl:call-template name="renderStatusIcon">
                <xsl:with-param name="img" select="$vaccinationYellowFilledLarge" />
                <xsl:with-param name="toolTip">Impfung fällig</xsl:with-param>
            </xsl:call-template>
        </xsl:when>
        <xsl:when test="$actionCode='789539003'">
            <xsl:call-template name="renderStatusIcon">
                <xsl:with-param name="img" select="$vaccinationYellowFilledLarge" />
                <xsl:with-param name="toolTip">Impftermin anstehend</xsl:with-param>
            </xsl:call-template>
        </xsl:when>
        <xsl:when test="$actionCode='122541000119104'">
            <xsl:call-template name="renderStatusIcon">
                <xsl:with-param name="img" select="$vaccinationGreyFilledLarge" />
                <xsl:with-param name="toolTip">Impfung notwendig</xsl:with-param>
            </xsl:call-template>
        </xsl:when>
        <xsl:when test="$actionCode='191441008'">
            <xsl:call-template name="renderStatusIcon">
                <xsl:with-param name="img" select="$vaccinationGreenFilledLarge" />
                <xsl:with-param name="toolTip">Immunität erworben</xsl:with-param>
            </xsl:call-template>
        </xsl:when>
        <xsl:when test="$actionCode='713404003'">
            <xsl:call-template name="renderStatusIcon">
                <xsl:with-param name="img" select="$vaccinationGreenFilledLarge" />
                <xsl:with-param name="toolTip">Impfung verabreicht</xsl:with-param>
            </xsl:call-template>
        </xsl:when>
        <xsl:when test="$actionCode='171258008'">
            <xsl:call-template name="renderStatusIcon">
                <xsl:with-param name="img" select="$vaccinationGreenFilledLarge" />
                <xsl:with-param name="toolTip">Impfschutz auf dem neuesten Stand</xsl:with-param>
            </xsl:call-template>
        </xsl:when>
        <xsl:when test="$actionCode='161413004'">
            <xsl:call-template name="renderStatusIcon">
                <xsl:with-param name="img" select="$vaccinationGreenFilledLarge" />
                <xsl:with-param name="toolTip">Durchgemachte Infektionskrankheit</xsl:with-param>
            </xsl:call-template>
        </xsl:when>
        <xsl:when test="$actionCode='723620004'">
            <xsl:call-template name="renderStatusIcon">
                <xsl:with-param name="img" select="$vaccinationBlueFilledLarge" />
                <xsl:with-param name="toolTip">Erfordert Impfung</xsl:with-param>
            </xsl:call-template>
        </xsl:when>
        <xsl:when test="$actionCode='171288004' or $actionCode=''">
            <xsl:call-template name="renderStatusIcon">
                <xsl:with-param name="img" select="$vaccinationBlueFilledLarge" />
                <xsl:with-param name="toolTip">Keine Aufzeichnungen über Impfungen</xsl:with-param>
            </xsl:call-template>
        </xsl:when>
        <xsl:otherwise>
            <xsl:text>unbekannter code </xsl:text>
            <xsl:value-of select="$actionCode" />
        </xsl:otherwise>
    </xsl:choose>
</xsl:template>

<xsl:template name="renderStatusIcon">
    <xsl:param name="img" />
    <xsl:param name="toolTip" />
    <img alt="" data-toggle="tooltip" data-placement="top" title="{$toolTip}"  width="20px" class="my-auto my-center" src="data:image/png;base64,{$img}" />
</xsl:template>

<xsl:template name="renderModalVaccinations">
    <xsl:param name="vaccinationCode" />

    <xsl:variable name="actionCode">
        <xsl:call-template name="getActionCode">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
        </xsl:call-template>
    </xsl:variable>

    <xsl:variable name="hasPreviousVaccinations">
        <xsl:call-template name="hasPreviousVaccinations">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
        </xsl:call-template>
    </xsl:variable>

    <div class="modal fade modal-right" id="modalVaccinationsInformation-{$vaccinationCode}" tabindex="-1" role="dialog" aria-labelledby="vaccination-modal-title-{$vaccinationCode}" aria-hidden="true">
        <div class="modal-dialog textNormal" role="document">
            <div class="modal-content">
                <div class="modal-header media">
                    <span class="media-body">
                        <h3 class="modal-title my-auto my-center textLarge text-break" id="vaccination-modal-title-{$vaccinationCode}">
                            <strong>
                                <xsl:call-template name="getImmunizationTargetName">
                                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                </xsl:call-template>
                            </strong>
                        </h3>
                    </span>
                    <span class="media-right my-auto my-center">
                        <xsl:variable name="url">
                            <xsl:call-template name="getInfoButtonLink">
                                <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                            </xsl:call-template>
                        </xsl:variable>
                        <a class="btn infoButton" target="_blank" href="{$url}" />
                    </span>

                    <button type="button" class="btn my-auto my-center modalCloseButton" data-dismiss="modal" aria-label="Close" />
                </div>
                <div class="modal-body">
                    <div class="container">
                        <div class="row modalRow">
                            <div class="col media">
                                <span class="media-body my-auto my-center">
                                    <h4 class="textLarge">
                                        <strong>
                                            <xsl:text>Aktion</xsl:text>
                                        </strong>
                                    </h4>
                                </span>
                                <span class="media-right my-auto my-center">
                                    <xsl:call-template name="renderActionCodeIcon">
                                        <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                    </xsl:call-template>
                                </span>
                            </div>
                        </div>
                        <div class="row modalRow">
                            <div class="col">
                                <h4 class="textLarge">
                                    <strong>
                                        <xsl:text>Empfohlenes Impfdatum</xsl:text>
                                    </strong>
                                </h4>
                                <div class="modalDivider">
                                    <xsl:call-template name="getNextVaccinationRange">
                                        <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                    </xsl:call-template>
                                </div>
                            </div>
                        </div>
                        <div class="row modalRow">
                            <div class="col">
                                <h4 class="textLarge">
                                    <strong>
                                        <xsl:text>Impfdosis</xsl:text>
                                    </strong>
                                </h4>
                                <div class="modalDivider">
                                    <xsl:call-template name="getNextVaccinationDoseAndScheme">
                                        <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                    </xsl:call-template>
                                </div>
                            </div>
                        </div>
                        <div class="row modalRow">
                            <div class="col">
                                <h4 class="textLarge">
                                    <strong>
                                        <xsl:text>Handlungsempfehlung</xsl:text>
                                    </strong>
                                </h4>
                                <div class="modalDivider">
                                    <xsl:choose>
                                        <xsl:when test="$actionCode!=''">
                                            <xsl:call-template name="getImmunizationActionTranslated">
                                                <xsl:with-param name="actionCode" select="$actionCode" />
                                            </xsl:call-template>
                                        </xsl:when>
                                        <xsl:otherwise>
                                            <!-- Show default text when no actionCode is available -->
                                            <xsl:call-template name="getImmunizationActionTranslated">
                                                <xsl:with-param name="actionCode" select="'171288004'" />
                                            </xsl:call-template>
                                        </xsl:otherwise>
                                    </xsl:choose>
                                </div>
                            </div>
                        </div>

                        <xsl:if test="$hasPreviousVaccinations='true'">

                            <xsl:for-each select="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']/../n1:code[@code=$vaccinationCode]/../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">
                                <xsl:sort select="../n1:effectiveTime/@value" order="descending"/>

                                <xsl:if test="position()=1">

                                    <xsl:variable name="currentEntryIdExtension" select="../n1:id/@extension" />
                                    <xsl:variable name="currentEntryIdRoot" select="../n1:id/@root" />

                                    <div class="row modalRow">
                                        <div class="col">
                                            <h4 class="textLarge">
                                                <strong>
                                                    <xsl:text>Letztes Ereignis</xsl:text>
                                                </strong>
                                            </h4>
                                            <div class="modalDivider">
                                                <xsl:call-template name="getVaccinationDateByEntryId">
                                                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                                </xsl:call-template>
                                            </div>
                                            <div class="modalDividerLarge">
                                                <div class="row">
                                                    <div class="col-6">
                                                        <h4 class="textLarge">
                                                            <strong>
                                                                <xsl:text>Impfstoff</xsl:text>
                                                            </strong>
                                                        </h4>
                                                    </div>
                                                    <div class="col-6">
                                                        <h4 class="textLarge">
                                                            <strong>
                                                                <xsl:text>Impfdosis</xsl:text>
                                                            </strong>
                                                        </h4>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modalDivider">
                                                <div class="row">
                                                    <div class="col-6">
                                                        <xsl:call-template name="getVaccinationProductNameByEntryId">
                                                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                                        </xsl:call-template>
                                                    </div>
                                                    <div class="col-6">
                                                        <xsl:call-template name="getVaccinationDoseAndScheme">
                                                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                                        </xsl:call-template>
                                                    </div>
                                                </div>
                                            </div>

                                            <xsl:variable name="authorAvailable">
                                                <xsl:call-template name="isVaccinationAuthorNameAvailable">
                                                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                                </xsl:call-template>
                                            </xsl:variable>

                                            <div class="modalDividerLarge">
                                                <div class="row">
                                                    <div class="col">
                                                        <h4 class="textLarge">
                                                            <strong>
                                                                <xsl:text>Medizinisch verantwortliche Person</xsl:text>
                                                            </strong>
                                                        </h4>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modalDivider">
                                                <div class="row">
                                                    <div class="col">
                                                        <xsl:choose>
                                                            <xsl:when test="$authorAvailable='true'">
                                                                <xsl:call-template name="getVaccinationAuthorNameByEntryId">
                                                                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                                                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                                                </xsl:call-template>
                                                            </xsl:when>
                                                            <xsl:otherwise>
                                                                <xsl:text>Keine Angabe</xsl:text>
                                                            </xsl:otherwise>
                                                        </xsl:choose>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </xsl:if>
                            </xsl:for-each>
                        </xsl:if>
                    </div>

                    <xsl:if test="$hasPreviousVaccinations='true'">
                        <div id="modal-previous-{$vaccinationCode}" class="panel-group">
                            <div class="panel panel-default textNormal">
                                <div class="panel-heading">
                                    <div class="panel-title">

                                        <!-- all previous vaccinations -->
                                        <div class="container modalSectionHeaderContainer">
                                            <div class="row modalSectionHeaderRow">
                                                <div class="col-12 media">
                                                    <div class="media-body">
                                                        <h2 class="textLarge">
                                                            <xsl:text>Alle bisherigen Impfungen</xsl:text>
                                                        </h2>
                                                    </div>
                                                    <button class="media-right btn accordion-toggle collapsed accordionButton my-auto my-center" id="modal-previous-{$vaccinationCode}-toggle"
                                                            data-toggle="collapse"  data-target="#modal-previous-{$vaccinationCode}-body" data-parent="#modal-previous-{$vaccinationCode}" aria-expanded="false" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <xsl:call-template name="renderModalPreviousVaccinations">
                            <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                        </xsl:call-template>
                    </xsl:if>
                </div>
            </div>
        </div>
    </div>
</xsl:template>

<xsl:template name="renderModalPreviousVaccinations">
    <xsl:param name="vaccinationCode" />

    <div id="modal-previous-{$vaccinationCode}-body" class="panel-collapse collapse" data-parent="#modal-previous-{$vaccinationCode}">
        <div class="panel-body">
            <div class="container">
                <xsl:for-each select="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']/../n1:code[@code=$vaccinationCode]/../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">
                    <xsl:sort select="../n1:effectiveTime/@value" order="descending"/>

                    <xsl:variable name="currentEntryIdRoot" select="../n1:id/@root" />
                    <xsl:variable name="currentEntryIdExtension" select="../n1:id/@extension" />

                    <div class="row modalDetailRow">
                        <div class="col">
                            <xsl:call-template name="modalDetailEntry">
                                <xsl:with-param name="title" select="'Datum'" />
                                <xsl:with-param name="body">
                                    <xsl:call-template name="getVaccinationDateByEntryId">
                                        <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                        <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                    </xsl:call-template>
                                </xsl:with-param>
                            </xsl:call-template>
                            <xsl:call-template name="modalDetailEntry">
                                <xsl:with-param name="title" select="'Impfstoff'" />
                                <xsl:with-param name="body">
                                    <xsl:call-template name="getVaccinationProductNameByEntryId">
                                        <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                        <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                    </xsl:call-template>
                                </xsl:with-param>
                            </xsl:call-template>
                            <xsl:call-template name="modalDetailEntry">
                                <xsl:with-param name="title" select="'Impfdosis'" />
                                <xsl:with-param name="body">
                                    <xsl:call-template name="getVaccinationDoseAndScheme">
                                        <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                        <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                    </xsl:call-template>
                                </xsl:with-param>
                            </xsl:call-template>

                            <xsl:variable name="authorAvailable">
                                <xsl:call-template name="isVaccinationAuthorNameAvailable">
                                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                </xsl:call-template>
                            </xsl:variable>

                            <xsl:call-template name="modalDetailEntry">
                                <xsl:with-param name="title" select="'Medizinisch verantwortliche Person'" />
                                <xsl:with-param name="body">
                                    <xsl:choose>
                                        <xsl:when test="$authorAvailable='true'">
                                            <xsl:call-template name="getVaccinationAuthorNameByEntryId">
                                                <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                                <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                            </xsl:call-template>
                                        </xsl:when>
                                        <xsl:otherwise>
                                            <xsl:text>Keine Angabe</xsl:text>
                                        </xsl:otherwise>
                                    </xsl:choose>
                                </xsl:with-param>
                            </xsl:call-template>
                        </div>
                    </div>
                </xsl:for-each>
            </div>
        </div>
    </div>

</xsl:template>

<xsl:template name="modalDetailEntry">
    <xsl:param name="title" />
    <xsl:param name="body" />

    <div class="modalDetailEntrySection">
        <div>
            <strong>
                <xsl:copy-of select="$title" />
            </strong>
        </div>
        <div>
            <xsl:copy-of select="$body" />
        </div>
