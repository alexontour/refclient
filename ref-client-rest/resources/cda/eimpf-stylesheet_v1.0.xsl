                                    </xsl:if>

                                    <xsl:if test="$antiBodyAuthorDeviceName != ''">
                                        <xsl:value-of select="$antiBodyAuthorDeviceName" />
                                        <br />
                                    </xsl:if>

                                    <xsl:if test="$antiBodyAuthorRole != ''">
                                        <xsl:value-of select="$antiBodyAuthorRole" />
                                        <br />
                                    </xsl:if>

                                    <xsl:if test="$antiBodyAuthorOrganizationName != ''">
                                        <xsl:value-of select="$antiBodyAuthorOrganizationName" />
                                        <br />
                                    </xsl:if>

                                    <xsl:if test="$antiBodyAuthorOrganizationAddress != ''">
                                        <xsl:copy-of select="$antiBodyAuthorOrganizationAddress" />
                                        <br />
                                    </xsl:if>

                                    <xsl:if test="$antiBodyAuthorOrganizationTelecom != ''">
                                        <xsl:copy-of select="$antiBodyAuthorOrganizationTelecom" />
                                        <br />
                                    </xsl:if>
                                </xsl:with-param>
                                <xsl:with-param name="underlined" select="string(true())" />
                            </xsl:call-template>
                        </xsl:when>
                        <xsl:otherwise>
                            <xsl:call-template name="renderVaccinationDetails">
                                <xsl:with-param name="title">
                                    <xsl:text>Med. verantwortl. Person:</xsl:text>
                                </xsl:with-param>
                                <xsl:with-param name="text">
                                    <xsl:text>Keine Angabe</xsl:text>
                                </xsl:with-param>
                                <xsl:with-param name="underlined" select="string(true())" />
                            </xsl:call-template>
                        </xsl:otherwise>
                    </xsl:choose>

                    <xsl:variable name="participantVRFName">
                        <xsl:call-template name="getAntiBodyParticipantVRFNameByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:variable name="participantVRFOrganizationName">
                        <xsl:call-template name="getAntiBodyParticipantVRFOrganizationNameByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:variable name="participantVRFAddress">
                        <xsl:call-template name="getAntiBodyParticipantVRFAddressByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:variable name="participantVRFTelecom">
                        <xsl:call-template name="getAntiBodyParticipantVRFTelecomByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:variable name="participantVRFTime">
                        <xsl:call-template name="getAntiBodyParticipantVRFTimeByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
