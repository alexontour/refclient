    <xsl:template name="getVaccinationSchemeByEntryId">
        <xsl:param name="root" />
        <xsl:param name="extension" />

        <xsl:variable name="entry" select="//n1:id[(@extension=$extension and @root=$root) or ((not(@extension) or @extension = '') and (not($extension) or $extension = '') and @root=$root)]" />

        <xsl:variable name="code">
            <xsl:value-of select="$entry/../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']/../n1:precondition/n1:criterion/n1:code/@code" />
        </xsl:variable>

        <xsl:variable name="resolvedVaccinationScheme">
            <xsl:call-template name="getImmunizationScheme">
                <xsl:with-param name="code" select="$code"/>
            </xsl:call-template>
        </xsl:variable>

        <xsl:choose>
            <xsl:when test="$resolvedVaccinationScheme != ''">
                <xsl:value-of select="$resolvedVaccinationScheme" />
            </xsl:when>
            <xsl:otherwise>
                <xsl:variable name="displayName">
                    <xsl:value-of select="$entry/../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']/../n1:precondition/n1:criterion/n1:code/@displayName" />
                </xsl:variable>
                <xsl:choose>
                    <xsl:when test="$displayName != '' and $code != ''">
                        <xsl:value-of select="$displayName"/>
                        <xsl:text> (</xsl:text>
                        <xsl:value-of select="$code" />
                        <xsl:text>)</xsl:text>
                    </xsl:when>
                    <xsl:when test="$displayName != '' and $code = ''">
                        <xsl:value-of select="$displayName"/>
                    </xsl:when>
                    <xsl:when test="$displayName = '' and $code != ''">
                        <xsl:value-of select="$code" />
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:text>unbekanntes Impfschema</xsl:text>
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>

    <xsl:template name="getVaccinationDoseAndScheme">
