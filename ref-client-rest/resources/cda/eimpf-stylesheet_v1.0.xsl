                                            <xsl:value-of select="$diseaseAuthorRole" />
                                            <br />
                                        </xsl:if>

                                        <xsl:if test="$diseaseAuthorOrganizationName != ''">
                                            <xsl:value-of select="$diseaseAuthorOrganizationName" />
                                            <br />
                                        </xsl:if>

                                        <xsl:if test="$diseaseAuthorOrganizationAddress != ''">
                                            <xsl:copy-of select="$diseaseAuthorOrganizationAddress" />
                                            <br />
                                        </xsl:if>

                                        <xsl:if test="$diseaseAuthorOrganizationTelecom != ''">
                                            <xsl:copy-of select="$diseaseAuthorOrganizationTelecom" />
                                            <br />
                                        </xsl:if>
                                    </xsl:with-param>
                                    <xsl:with-param name="underlined" select="string(true())" />
                                </xsl:call-template>
