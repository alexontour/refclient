                            <xsl:text>Einträge</xsl:text>
                        </button>
                        <div class="dropdown-menu" id="{$section}DropDown" data-test-id="{$section}DropDown">
                            <a class="dropdown-item {$section}-dropdown-item textSmall" data-dropdown-target="show-all" data-test-id="{$section}-dropdown-show-all">Alle</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-none d-md-block col-md-6 d-print-block tableHeaderCol">
                <div class="row sectionRowHeight">
                </div>
            </div>
            <div class="col-6 col-md-3 d-print-block tableHeaderCol align-self-center">
