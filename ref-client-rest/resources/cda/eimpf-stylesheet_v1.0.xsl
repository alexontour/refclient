    <xsl:template name="getImmunizationActionTranslated">
        <xsl:param name="actionCode" />
        
        <xsl:choose>
            <xsl:when test="$actionCode='122541000119104'">Noch keine Handlung nötig</xsl:when>
            <xsl:when test="$actionCode='161413004'">Keine Handlung nötig</xsl:when>
            <xsl:when test="$actionCode='171258008'">Keine Handlung nötig</xsl:when>
            <xsl:when test="$actionCode='171279008'">Impfung fällig - bitte Termin vereinbaren</xsl:when>
            <xsl:when test="$actionCode='171288004'">Keine Daten erfasst - bitte Termin vereinbaren</xsl:when>
            <xsl:when test="$actionCode='191441008'">Keine Handlung nötig</xsl:when>
            <xsl:when test="$actionCode='266758009'">Derzeit keine Handlung erforderlich.</xsl:when>
            <xsl:when test="$actionCode='424272000'">Impfung fällig - bitte Termin vereinbaren</xsl:when>
            <xsl:when test="$actionCode='713404003'">Keine Handlung nötig</xsl:when>
            <xsl:when test="$actionCode='723620004'">Ärztliche Abklärung empfohlen - Keine Terminberechnung möglich</xsl:when>
            <xsl:when test="$actionCode='789539003'">Impfung fällig - bitte Termin vereinbaren</xsl:when>
            <xsl:when test="$actionCode='789540001'">Impfung fällig - bitte Termin vereinbaren</xsl:when>
            <xsl:otherwise><xsl:text>unbekannter Code (</xsl:text><xsl:value-of select="$actionCode" /><xsl:text>)</xsl:text></xsl:otherwise>
        
        </xsl:choose>
    
    </xsl:template>
    
    <xsl:template name="getImmunizationActionTranslatedLong">
        <xsl:param name="actionCode" />
        
        <xsl:choose>
            <xsl:when test="$actionCode='122541000119104'">Laut Impfplan Österreich ist zukünftig eine Impfung fällig. Aktuell ist keine Handlung erfoderlich.</xsl:when>
            <xsl:when test="$actionCode='161413004'">Laut Impfplan Österreich ist aufgrund durchgemachter Erkrankung aktuell keine Impfung erforderlich.</xsl:when>
            <xsl:when test="$actionCode='171258008'">Laut Impfplan Österreich ist aktuell keine Impfung erforderlich.</xsl:when>
            <xsl:when test="$actionCode='171279008'">Laut Impfplan Österreich ist eine Impfung fällig. Bitte vereinbaren Sie einen Impftermin.</xsl:when>
            <xsl:when test="$actionCode='171288004'">Es wurden noch keine Daten erfasst. Laut Impfplan Österreich ist eine Impfung für Sie prinzipiell empfohlen. Bitte vereinbaren Sie einen Termin zur ärztlichen Abklärung/Nachtragung.</xsl:when>
            <xsl:when test="$actionCode='191441008'">Laut Impfplan Österreich ist aufgrund durchgemachter Erkrankung keine Impfung empfohlen.</xsl:when>
            <xsl:when test="$actionCode='266758009'">Derzeit besteht eine Ausnahme von der Impfpflicht gegen COVID-19.</xsl:when>
            <xsl:when test="$actionCode='424272000'">Das laut Impfplan Österreich empfohlene Impfdatum ist bereits überschritten. Bitte vereinbaren Sie einen Termin zur ärztlichen Abklärung.</xsl:when>
            <xsl:when test="$actionCode='713404003'">Laut Impfplan Österreich ist keine weitere Impfung erforderlich.</xsl:when>
            <xsl:when test="$actionCode='723620004'">Laut Impfplan Österreich ist eine Impfung für Sie prinzipiell empfohlen. Mit den vorhandenen Daten konnte kein empfohlenes Impfdatum ermittelt werden. Bitte vereinbaren Sie einen
 Termin zur ärztlichen Abklärung.</xsl:when>
