    <xsl:template name="getPatientLanguageCommunication">
        <xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:languageCommunication">
            <xsl:call-template name="getLanguageAbility">
                <xsl:with-param name="patient" select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient"/>
            </xsl:call-template>
        </xsl:if>
    </xsl:template>

    <!--
         Im Leitfaden steht, dass dieses Kennzeichen alternativ angegeben werden kann, wenn der Todeszeitpunkt nicht bekannt ist.
         Das bedeutet aber auch, dass das Todesdatum auch nicht immer befüllt sein muss.
         Bitte immer beide Elemente prüfen - sobald entweder deceasedInd = true oder ein deceasedTime befüllt ist, muss das Kreuz Icon angezeigt werden.
         see https://jira-neu.elga.gv.at/browse/REFERENZ-605
    -->
    <xsl:template name="showPatientDeceasedIndicator">
        <xsl:choose>
            <xsl:when test="//n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/*[local-name()='deceasedTime'] or
                            //n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/*[local-name()='deceasedInd']/@value='true'">
                <xsl:value-of select="string(true())"/>
            </xsl:when>
            <xsl:otherwise>
                <xsl:value-of select="string(false())"/>
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>

    <!--
        Das Todesdatum nur anzeigen, wenn deceasedTime angegeben ist.
        see https://jira-neu.elga.gv.at/browse/REFERENZ-605
    -->
    <xsl:template name="hasPatientDeceasedDate">
        <xsl:choose>
            <xsl:when test="//n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/*[local-name()='deceasedTime']">
                <xsl:value-of select="string(true())"/>
            </xsl:when>
            <xsl:otherwise>
                <xsl:value-of select="string(false())"/>
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>

    <xsl:template name="getPatientDeceasedDate">
        <xsl:call-template name="getDate">
            <xsl:with-param name="node" select="//n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/*[local-name()='deceasedTime']"/>
        </xsl:call-template>
    </xsl:template>

    <xsl:key name="languageCodeGrouping" match="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:languageCommunication" use="n1:languageCode/@code"/>

    <xsl:template name="getLanguageAbility">
        <xsl:param name="patient"/>

        <xsl:if test="not($patient/n1:languageCommunication)">
            <xsl:text>unbekannt</xsl:text>
        </xsl:if>

        <xsl:for-each select="$patient/n1:languageCommunication[generate-id() = generate-id(key('languageCodeGrouping', n1:languageCode/@code))]">

            <xsl:call-template name="getELGAHumanLanguage">
                <xsl:with-param name="code" select="n1:languageCode/@code"/>
            </xsl:call-template>

            <xsl:if test="contains(n1:languageCode/@code, '-')">
                <xsl:text> (</xsl:text>
                <xsl:value-of select="n1:languageCode/@code"/>
                <xsl:text>)</xsl:text>
            </xsl:if>

            <xsl:if test="n1:modeCode/@code or n1:proficiencyLevelCode/@code">

                <xsl:text> (</xsl:text>

                <xsl:call-template name="getLanguageAbilityForLanguage">
                    <xsl:with-param name="code" select="n1:languageCode/@code"/>
                    <xsl:with-param name="patient" select="$patient"/>
                </xsl:call-template>

                <xsl:text>)</xsl:text>

            </xsl:if>

            <xsl:if test="n1:preferenceInd/@value='true'">
                <xsl:text>, bevorzugt</xsl:text>
            </xsl:if>

            <xsl:call-template name="separatorValue"/>
        </xsl:for-each>

    </xsl:template>

    <xsl:template name="getLanguageAbilityForLanguage">
        <xsl:param name="code"/>
        <xsl:param name="patient"/>

        <xsl:for-each select="$patient/n1:languageCommunication/n1:languageCode[@code=$code]">

            <xsl:if test="../n1:languageCode/@code=$code">

                <xsl:if test="../n1:modeCode/@code">
                    <xsl:call-template name="getELGALanguageAbilityMode">
                        <xsl:with-param name="code" select="../n1:modeCode/@code"/>
                    </xsl:call-template>
                    <xsl:text>: </xsl:text>
                </xsl:if>

                <xsl:if test="../n1:proficiencyLevelCode/@code">
                    <xsl:call-template name="getELGAProficiencyLevelCode">
                        <xsl:with-param name="code" select="../n1:proficiencyLevelCode/@code"/>
                    </xsl:call-template>
                </xsl:if>

                <xsl:if test="position() &lt; count($patient/n1:languageCommunication/n1:languageCode[@code=$code])">
                    <xsl:text>, </xsl:text>
                </xsl:if>

            </xsl:if>
        </xsl:for-each>

    </xsl:template>

    <xsl:template name="isVaccination">
        <xsl:param name="root" />
        <xsl:param name="extension" />

        <xsl:choose>
            <xsl:when test="//n1:substanceAdministration[n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']]/n1:id[(@extension=$extension and @root=$root) or ((not(@extension) or @extension = '') and (not($extension) or $extension = '') and @root=$root)]">
                <xsl:value-of select="string(true())" />
            </xsl:when>
            <xsl:otherwise>
                <xsl:value-of select="string(false())" />
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>

    <xsl:template name="getLastEntryIdExtensionFromVaccinationCode">
        <xsl:param name="vaccinationCode" />

        <xsl:variable name="vaccinationCodeReverseMapping">
            <xsl:call-template name="getImmunizationDiseaseMappingReverse">
                <xsl:with-param name="code" select="$vaccinationCode" />
            </xsl:call-template>
        </xsl:variable>

        <xsl:for-each select="//n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1'] and ../n1:entryRelationship/n1:observation/n1:code[@code=$vaccinationCode]]/@value |
                                                //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16'] and ../../../n1:code[@code=$vaccinationCode]]/@value |
                                                //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9'] and ../n1:value[@code=$vaccinationCodeReverseMapping]]/n1:low/@value |
                                                //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9'] and ../n1:value[@code=$vaccinationCodeReverseMapping] and n1:low[@nullFlavor='UNK']]/n1:high/@value">
            <xsl:sort select="." order="descending" />
            <xsl:sort select="./../../n1:id/@root" />
            <xsl:sort select="./../../n1:id/@extension" />
            <xsl:sort select="./../../../n1:id/@root" />
            <xsl:sort select="./../../../n1:id/@extension" />

            <xsl:if test="position()=1">
                <xsl:choose>
                    <xsl:when test="./../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">
                        <xsl:value-of select="./../../n1:id/@extension" />
                    </xsl:when>
                    <xsl:when test="./../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']">
                        <xsl:value-of select="./../../n1:id/@extension" />
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:value-of select="./../../../n1:id/@extension" />
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:if>
        </xsl:for-each>
    </xsl:template>

    <xsl:template name="getLastEntryIdRootFromVaccinationCode">
        <xsl:param name="vaccinationCode" />

        <xsl:variable name="vaccinationCodeReverseMapping">
            <xsl:call-template name="getImmunizationDiseaseMappingReverse">
                <xsl:with-param name="code" select="$vaccinationCode" />
            </xsl:call-template>
        </xsl:variable>

        <xsl:for-each select="//n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1'] and ../n1:entryRelationship/n1:observation/n1:code[@code=$vaccinationCode]]/@value |
                                                //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16'] and ../../../n1:code[@code=$vaccinationCode]]/@value |
                                                //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9'] and ../n1:value[@code=$vaccinationCodeReverseMapping]]/n1:low/@value |
                                                //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9'] and ../n1:value[@code=$vaccinationCodeReverseMapping] and n1:low[@nullFlavor='UNK']]/n1:high/@value">
            <xsl:sort select="." order="descending" />
            <xsl:sort select="./../../n1:id/@root" />
            <xsl:sort select="./../../n1:id/@extension" />
            <xsl:sort select="./../../../n1:id/@root" />
            <xsl:sort select="./../../../n1:id/@extension" />

            <xsl:if test="position()=1">
                <xsl:choose>
                    <xsl:when test="./../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">
                        <xsl:value-of select="./../../n1:id/@root" />
                    </xsl:when>
                    <xsl:when test="./../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']">
                        <xsl:value-of select="./../../n1:id/@root" />
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:value-of select="./../../../n1:id/@root" />
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:if>
        </xsl:for-each>
    </xsl:template>

    <xsl:template name="isAntiBody">
        <xsl:param name="root" />
        <xsl:param name="extension" />

        <xsl:choose>
            <xsl:when test="//n1:organizer[n1:templateId[@root='1.2.40.0.34.6.0.11.3.18']]/n1:component/n1:observation/
                            n1:id[(@extension=$extension and @root=$root) or ((not(@extension) or @extension = '') and (not($extension) or $extension = '') and @root=$root)]">
                <xsl:value-of select="string(true())" />
            </xsl:when>
            <xsl:otherwise>
                <xsl:value-of select="string(false())" />
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>

    <xsl:template name="getActionCode">
        <xsl:param name="vaccinationCode" />
        <xsl:value-of select="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']/../n1:code[@code=$vaccinationCode]/../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.3']
                              /../../n1:substanceAdministration[@negationInd='false']/n1:code[@codeSystem='2.16.840.1.113883.6.96']/@code" />
    </xsl:template>

    <xsl:template name="getNextVaccinationRange">
        <xsl:param name="vaccinationCode" />

        <xsl:variable name="vaccinationNode" select="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']/../n1:code[@code=$vaccinationCode]/../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.3']/../../n1:substanceAdministration[@negationInd='false']" />

        <xsl:choose>
            <xsl:when test="$vaccinationNode/n1:effectiveTime/@xsi:type='IVL_TS'">

                <xsl:variable name="lowValid">
                    <xsl:call-template name="isDateTimeValid">
                        <xsl:with-param name="node" select="$vaccinationNode/n1:effectiveTime/n1:low" />
                    </xsl:call-template>
                </xsl:variable>

                <xsl:variable name="highValid">
                    <xsl:call-template name="isDateTimeValid">
                        <xsl:with-param name="node" select="$vaccinationNode/n1:effectiveTime/n1:high" />
                    </xsl:call-template>
                </xsl:variable>

                <xsl:choose>
                    <xsl:when test="$lowValid='true' and $highValid='true'">
                        <xsl:call-template name="getDateRangeDistinct">
                            <xsl:with-param name="fromDateNode" select="$vaccinationNode/n1:effectiveTime/n1:low" />
                            <xsl:with-param name="toDateNode" select="$vaccinationNode/n1:effectiveTime/n1:high" />
                            <xsl:with-param name="short" select="string(true())" />
                        </xsl:call-template>
                    </xsl:when>
                    <xsl:otherwise>
                        <!-- low is mandatory -->
                        <xsl:call-template name="getDate">
                            <xsl:with-param name="node" select="$vaccinationNode/n1:effectiveTime/n1:low" />
                            <xsl:with-param name="short" select="string(true())" />
                        </xsl:call-template>
                    </xsl:otherwise>
                </xsl:choose>

            </xsl:when>
            <xsl:otherwise>
                <xsl:variable name="timeValid">
                    <xsl:call-template name="isDateTimeValid">
                        <xsl:with-param name="node" select="$vaccinationNode/n1:effectiveTime" />
                    </xsl:call-template>
                </xsl:variable>
                <xsl:if test="$timeValid='true'">
                    <xsl:call-template name="getDate">
                        <xsl:with-param name="node" select="$vaccinationNode/n1:effectiveTime" />
                        <xsl:with-param name="short" select="string(true())" />
                    </xsl:call-template>
                </xsl:if>
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>

    <xsl:template name="getNextImmunizationProductName">
        <xsl:param name="vaccinationCode" />

        <xsl:variable name="vaccinationNode" select="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']/../n1:code[@code=$vaccinationCode]/../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.3']" />

        <xsl:if test="$vaccinationNode/../n1:consumable/n1:manufacturedProduct/n1:manufacturedMaterial/n1:code[@codeSystem='1.2.40.0.34.4.16']/@code">
            <xsl:call-template name="getImmunizationProduct">
                <xsl:with-param name="code" select="$vaccinationNode/../n1:consumable/n1:manufacturedProduct/n1:manufacturedMaterial/n1:code[@codeSystem='1.2.40.0.34.4.16']/@code"/>
            </xsl:call-template>
        </xsl:if>

        <xsl:if test="$vaccinationNode/../n1:consumable/n1:manufacturedProduct/n1:manufacturedMaterial/n1:code[@nullFlavor='OTH']">
            <xsl:value-of select="$vaccinationNode/../n1:consumable/n1:manufacturedProduct/n1:manufacturedMaterial/n1:code[@nullFlavor='OTH']/n1:translation/@displayName"/>
        </xsl:if>
    </xsl:template>

    <xsl:template name="getLastEventWithTime">
        <xsl:param name="vaccinationCode" />

        <xsl:variable name="lastEventType">
            <xsl:call-template name="getLastEventType">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
            </xsl:call-template>
        </xsl:variable>

        <xsl:choose>
            <xsl:when test="$lastEventType='VACCINATION'">
                <xsl:call-template name="getLastEventTimeImmunization">
                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                </xsl:call-template>
                <xsl:text> Impfung</xsl:text>
                <xsl:variable name="lastDose">
                    <xsl:call-template name="getLastImmunizationDose">
                        <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                    </xsl:call-template>
                </xsl:variable>
                <xsl:if test="$lastDose != ''">
                    <xsl:text> </xsl:text>
                    <xsl:value-of select="$lastDose" />
                </xsl:if>
            </xsl:when>
            <xsl:when test="$lastEventType='ANTIBODY'">
                <xsl:call-template name="getLastEventTimeAntiBody">
                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                </xsl:call-template>
                <xsl:text> Titerbestimmung</xsl:text>
            </xsl:when>
            <xsl:when test="$lastEventType='DISEASE'">
                <xsl:call-template name="getLastEventTimeDisease">
                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                </xsl:call-template>
                <xsl:text> Erkrankung</xsl:text>
            </xsl:when>
            <xsl:otherwise />
        </xsl:choose>
    </xsl:template>

    <xsl:template name="getLastEventTimeImmunization">
        <xsl:param name="vaccinationCode" />

        <xsl:for-each select="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']/../n1:code[@code=$vaccinationCode]/../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1' and ../n1:code[@code='IMMUNIZ']]/../../n1:substanceAdministration[@moodCode='EVN']">
            <xsl:sort select="./n1:effectiveTime/@value" order="descending" />
            <xsl:if test="position()=1">
                <xsl:variable name="isDateValid">
                    <xsl:call-template name="isDateTimeValid">
                        <xsl:with-param name="node" select="./n1:effectiveTime" />
                    </xsl:call-template>
                </xsl:variable>

                <xsl:choose>
                    <xsl:when test="$isDateValid = 'true'">
                        <xsl:call-template name="getDate">
                            <xsl:with-param name="node" select="./n1:effectiveTime"/>
                            <xsl:with-param name="short" select="string(true())" />
                        </xsl:call-template>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:text>unbekanntes Datum</xsl:text>
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:if>
        </xsl:for-each>
    </xsl:template>
    
    <xsl:template name="getLastImmunizationDose">
        <xsl:param name="vaccinationCode" />

        <xsl:for-each select="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']/../n1:code[@code=$vaccinationCode]/../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1' and ../n1:code[@code='IMMUNIZ']]/../../n1:substanceAdministration[@moodCode='EVN']">
            <xsl:sort select="./n1:effectiveTime/@value" order="descending" />
            <xsl:if test="position()=1">
                <xsl:value-of select="./n1:precondition/n1:criterion/n1:value/@code" />
            </xsl:if>
        </xsl:for-each>
    </xsl:template>

    <xsl:template name="getLastEventTimeAntiBody">
        <xsl:param name="vaccinationCode" />

        <xsl:for-each select="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']/../../../n1:code[@code=$vaccinationCode and ../n1:templateId[@root='1.2.40.0.34.6.0.11.3.18']]/../../n1:organizer[@classCode='BATTERY']">
            <xsl:sort select="n1:component/n1:observation[@classCode='OBS' and @moodCode='EVN']/n1:effectiveTime/@value" order="descending" />
            <xsl:if test="position()=1">
                <xsl:variable name="isDateValid">
                    <xsl:call-template name="isDateTimeValid">
                        <xsl:with-param name="node" select="./n1:component/n1:observation[@classCode='OBS' and @moodCode='EVN']/n1:effectiveTime" />
                    </xsl:call-template>
                </xsl:variable>

                <xsl:choose>
                    <xsl:when test="$isDateValid = 'true'">
                        <xsl:call-template name="getDate">
                            <xsl:with-param name="node" select="./n1:component/n1:observation[@classCode='OBS' and @moodCode='EVN']/n1:effectiveTime"/>
                            <xsl:with-param name="short" select="string(true())" />
                        </xsl:call-template>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:text>unbekanntes Datum</xsl:text>
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:if>
        </xsl:for-each>
    </xsl:template>

    <xsl:template name="getLastEventTimeDisease">
        <xsl:param name="vaccinationCode" />

        <xsl:variable name="diseaseCode">
            <xsl:call-template name="getImmunizationDiseaseMappingReverse">
                <xsl:with-param name="code" select="$vaccinationCode" />
            </xsl:call-template>
        </xsl:variable>

        <xsl:for-each select="//n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9'] and ../n1:value[@code=$diseaseCode]]">
            <xsl:sort select="./n1:low/@value" order="descending" />
            <xsl:sort select="./n1:high/@value" order="descending" />
            <xsl:if test="position()=1">
                <xsl:variable name="lowValid">
                    <xsl:call-template name="isDateTimeValid">
                        <xsl:with-param name="node" select="./n1:low" />
                    </xsl:call-template>
                </xsl:variable>

                <xsl:variable name="highValid">
                    <xsl:call-template name="isDateTimeValid">
                        <xsl:with-param name="node" select="./n1:high" />
                    </xsl:call-template>
                </xsl:variable>

                <xsl:choose>
                    <xsl:when test="$lowValid = 'true' and $highValid = 'true'">
                        <xsl:call-template name="getDateRangeDistinct">
                            <xsl:with-param name="fromDateNode" select="./n1:low"/>
                            <xsl:with-param name="toDateNode" select="./n1:high"/>
                            <xsl:with-param name="short" select="string(true())"/>
                        </xsl:call-template>
                    </xsl:when>
                    <xsl:when test="$highValid = 'true'">
                        <!-- fallback for false formatted documents -->
                        <xsl:call-template name="getDate">
                            <xsl:with-param name="node" select="./n1:high"/>
                            <xsl:with-param name="short" select="string(true())"/>
                        </xsl:call-template>
                    </xsl:when>
                    <xsl:when test="$lowValid = 'true'">
                        <xsl:call-template name="getDate">
                            <xsl:with-param name="node" select="./n1:low"/>
                            <xsl:with-param name="short" select="string(true())"/>
                        </xsl:call-template>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:text>unbekanntes Datum</xsl:text>
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:if>
        </xsl:for-each>
    </xsl:template>

    <xsl:template name="getLastEventType">
        <xsl:param name="vaccinationCode" />

        <xsl:variable name="diseaseCode">
            <xsl:call-template name="getImmunizationDiseaseMappingReverse">
                <xsl:with-param name="code" select="$vaccinationCode" />
            </xsl:call-template>
        </xsl:variable>

        <xsl:variable name="lastEventTypeByTime">
            <xsl:call-template name="getLastEventTypeByEventTime">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                <xsl:with-param name="diseaseCode" select="$diseaseCode" />
            </xsl:call-template>
        </xsl:variable>

        <xsl:choose>
            <xsl:when test="$lastEventTypeByTime != ''">
                <xsl:value-of select="$lastEventTypeByTime" />
            </xsl:when>
            <xsl:otherwise>

                <!-- fallback if no date is set -->
                <xsl:variable name="vaccinationNode" select="//n1:substanceAdministration[n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']]/n1:entryRelationship/n1:observation[n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']]/n1:code[@code=$vaccinationCode]"/>
                <xsl:variable name="antiBodyNode" select="//n1:observation[n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']]/../../n1:code[@code=$vaccinationCode]" />
                <xsl:variable name="diseaseNode" select="//n1:observation[n1:templateId[@root='1.2.40.0.34.6.0.11.3.9']]/n1:value[@code=$diseaseCode]" />

                <xsl:for-each select="$vaccinationNode/../../../n1:effectiveTime[@nullFlavor='UNK'] |
                                      $antiBodyNode/../n1:component/n1:observation/n1:effectiveTime[@nullFlavor='UNK'] |
                                      $diseaseNode/../n1:effectiveTime[n1:low[@nullFlavor='UNK'] and n1:high[@nullFlavor='UNK']]">
                    <xsl:if test="position() = (
                                        count($vaccinationNode/../../../n1:effectiveTime[@nullFlavor='UNK']) +
                                        count($antiBodyNode/../n1:component/n1:observation/n1:effectiveTime[@nullFlavor='UNK']) +
                                        count($diseaseNode/../n1:effectiveTime[n1:low[@nullFlavor='UNK'] and n1:high[@nullFlavor='UNK']])
                                        )">
                        <xsl:choose>
                            <xsl:when test="./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">
                                <xsl:text>VACCINATION</xsl:text>
                            </xsl:when>
                            <xsl:when test="./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']">
                                <xsl:text>ANTIBODY</xsl:text>
                            </xsl:when>
                            <xsl:when test="./../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.8']">
                                <xsl:text>DISEASE</xsl:text>
                            </xsl:when>
