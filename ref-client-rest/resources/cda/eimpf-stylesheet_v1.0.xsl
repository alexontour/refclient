                <script type="text/javascript">
                    <xsl:variable name="jsInit">
                        //<![CDATA[

const recommendationContainer = ["recommendationGeneral", "recommendationTravel", "recommendationOther"];
const defaultContainer = ["defaultGeneral", "defaultTravel", "defaultOther"];

function setUpDropdown(section) {

    var sections;
    if(section.startsWith("recommendation")) {
        sections = recommendationContainer;
    } else {
        sections = defaultContainer;
    }

    var selector = sections.map(entry => "#" + entry + "Container > div*[data-dropdown-title]").join(", ")
    $(selector).sort(function(a, b) {
        var aTitle = $(a).attr('data-dropdown-title').toLowerCase();
        var bTitle = $(b).attr('data-dropdown-title').toLowerCase();
        if (aTitle < bTitle) { return -1; }
        if (aTitle > bTitle) { return 1; }
        return 0;
    }).each(function() {
        $('#'+section+'DropDown')
        .append("<a class=\"dropdown-item "+section+"-dropdown-item textSmall\" " +
                    "data-dropdown-target=\""+$(this).attr('data-filter-target')+"\" " +
                    "data-test-id=\""+section+"-dropdown-show-"+$(this).attr('data-filter-target')+"\">" +
                    $(this).attr('data-dropdown-title') +
                "</a>")
    });

    $('.'+section+'-dropdown-item').click(function() {
        var targetId = $(this).attr('data-dropdown-target');

        sections.forEach(sectionToFilter => {
            $('#' + sectionToFilter + 'Container > div*[data-filter-target]').each(function() {
                if(targetId == "show-all") {
                    $(this).removeClass('d-none');
                } else {
                    if($(this).attr('data-filter-target') != targetId) {
                        $(this).addClass('d-none');
                    } else {
                        $(this).removeClass('d-none');
                    }
                }
            });

            showHideParentContainer(sectionToFilter);
        })
    });
}

function showHideParentContainer(section) {

    var allLength = $('#' + section + 'Container > div*[data-filter-target]').length;
    var hiddenLength = $('#' + section + 'Container > div*[data-filter-target].d-none').length;

    if(hiddenLength == allLength) {
       if(section != "general") {
         $("#"+section+"SectionTitleContainer").addClass("d-none");
       }
       $("#"+section+"TitleContainer").addClass("d-none");
       $("#"+section+"Container").addClass("d-none");
    } else {
       $("#"+section+"SectionTitleContainer").removeClass("d-none");
       $("#"+section+"TitleContainer").removeClass("d-none");
       $("#"+section+"Container").removeClass("d-none");
    }
}
function setUpSearch(section) {
    $('#'+section+'SearchInput').on("change paste keyup", function() {
        var searchString = $(this).val().toLowerCase();
        performSearchInSection(searchString);
    });
}

function performSearchInSection(searchString) {
    var keySet = document.getElementById("recommendation-keySetsHeader");
    if(typeof(keySet) != 'undefined' && keySet != null && keySet.style.display != 'none') {
        performSearch(searchString, 'recommendationGeneral');
        performSearch(searchString, 'recommendationTravel');
        performSearch(searchString, 'recommendationOther');
    } else {
        performSearch(searchString, 'defaultGeneral');
        performSearch(searchString, 'defaultTravel');
        performSearch(searchString, 'defaultOther');
    }

    performSearch(searchString, 'manualRecommendation');
    performSearch(searchString, 'vaccinationIndication');
}

function performSearch(searchString, section) {
    $('.'+section+'Row[data-search-immunization-name]').each(function() {
        var searchName = $(this).attr('data-search-immunization-name').toLowerCase();
        var searchProduct = $(this).attr('data-search-immunization-product').toLowerCase();

        if(searchName.indexOf(searchString) >= 0 || searchProduct.indexOf(searchString) >= 0) {
            $(this).removeClass("d-none");
        } else {
            $(this).addClass("d-none");
        }
    });

    var sectionTitleContainer = $('#'+section+'SectionTitleContainer');
    var titleContainer = $('#'+section+'TitleContainer');
    var mainContainer = $('#'+section+'Container');
    if($('.'+section+'Row[data-search-immunization-name]').filter(":not(.d-none)").length > 0) {
        sectionTitleContainer.removeClass("d-none");
        titleContainer.removeClass("d-none");
        mainContainer.removeClass("d-none");
    } else {
        if(section != 'general') {
            sectionTitleContainer.addClass("d-none");
        }
        titleContainer.addClass("d-none");
        mainContainer.addClass("d-none");
    }
}
function sortAndFormatHistoryEntries() {
    $('.sortable').each(function() {
        var container = $(this);
        var childRows = container.children();

        // sort by data-sort-date
        container.empty();
        childRows.sort(function(a, b) {
            var aDate = $(a).attr('data-sort-date');
            var bDate = $(b).attr('data-sort-date');
            if (aDate < bDate) { return 1; }
            if (aDate > bDate) { return -1; }
            return 0;
        }).each(function(index) {
            container.append($(this));
        });
    });
}
const recommendationViews = ["#recommendation-keySetsHeader", "#recommendation-keySetsFooter", "#recommendation-bannerBox", "#recommendation-vaccinationEntries", ".recommendation-entryHistoryTitle"]
const defaultViews = ["#default-vaccinationEntries", "#default-manualRecommendation"]

function toggleVaccinationViews() {
    var showRecommendationView = document.getElementById("enable-recommendation-view").checked

    // clear search
    var searchButton = $("#generalSearchBox")
    if (searchButton.hasClass("isOpen")) {
       $("#generalSearchControl").click()
    }

    if(!showRecommendationView) {
        $.each(recommendationViews, function(index, value){
        	$(value).hide()
        });
        $.each(defaultViews, function(index, value){
        	$(value).show()
        });
    } else {
        $.each(defaultViews, function(index, value){
        	$(value).hide()
        });
        $.each(recommendationViews, function(index, value){
        	$(value).show()
        });
    }
}

                        $(document).ready(function () {
                            // collapse child rows if parent row gets collapsed.
                            $('.panel-collapse').on('hidden.bs.collapse', function () {
                                $(this).find('.collapse').collapse('hide');
                            });

                            // tooltips
                            $('[data-toggle="tooltip"]').tooltip()

                            // dropdowns
                            setUpDropdown('defaultGeneral')
                            setUpDropdown('defaultTravel')
                            setUpDropdown('defaultOther')
                            setUpDropdown('recommendationGeneral')
                            setUpDropdown('recommendationTravel')
                            setUpDropdown('recommendationOther')

                            // search
                            setUpSearch('general')

                            // sort and format
                            sortAndFormatHistoryEntries()

                            // toggle
                            viewToggleInit()
                            $('#enable-recommendation-view').change(function() {
                                toggleVaccinationViews()
                            })
                        });

                        //]]>
