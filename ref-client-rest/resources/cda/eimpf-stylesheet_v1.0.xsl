    <xsl:template name="getDiseaseDateDistinctByEntryId">
        <xsl:param name="root" />
        <xsl:param name="extension" />
        <xsl:param name="short" />
        <xsl:param name="shortLineBreak" />

        <xsl:variable name="entry" select="//n1:id[(@extension=$extension and @root=$root) or ((not(@extension) or @extension = '') and (not($extension) or $extension = '') and @root=$root)]" />

        <xsl:variable name="lowValid">
            <xsl:call-template name="isDateTimeValid">
                <xsl:with-param name="node" select="$entry/../n1:effectiveTime/n1:low" />
            </xsl:call-template>
        </xsl:variable>

        <xsl:variable name="highValid">
            <xsl:call-template name="isDateTimeValid">
                <xsl:with-param name="node" select="$entry/../n1:effectiveTime/n1:high" />
            </xsl:call-template>
        </xsl:variable>

        <xsl:choose>
            <xsl:when test="$lowValid = 'true' and $highValid = 'true'">
                <xsl:call-template name="getDateRangeDistinct">
                    <xsl:with-param name="fromDateNode" select="$entry/../n1:effectiveTime/n1:low"/>
                    <xsl:with-param name="toDateNode" select="$entry/../n1:effectiveTime/n1:high"/>
                    <xsl:with-param name="short" select="$short"/>
                    <xsl:with-param name="shortLineBreak" select="$shortLineBreak" />
                </xsl:call-template>
            </xsl:when>
            <xsl:when test="$highValid = 'true'">
                <!-- fallback for false formatted documents -->
                <xsl:call-template name="getDate">
                    <xsl:with-param name="node" select="$entry/../n1:effectiveTime/n1:high"/>
                    <xsl:with-param name="short" select="$short"/>
                </xsl:call-template>
            </xsl:when>
            <xsl:otherwise>
                <xsl:call-template name="getDate">
                    <xsl:with-param name="node" select="$entry/../n1:effectiveTime/n1:low"/>
                    <xsl:with-param name="short" select="$short"/>
                </xsl:call-template>
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>

