            and n1:templateId[@root='1.2.40.0.34.6.0.11.3.3']
            and n1:author/n1:assignedAuthor/n1:id[@root != '1.2.40.0.34.6.104' or @nullFlavor='UNK']
            and n1:entryRelationship/n1:observation/n1:code[@code = $vaccinationCode]]/n1:entryRelationship/n1:act/n1:templateId[@root='1.2.40.0.34.6.0.11.3.11' or @root='1.2.40.0.34.6.0.11.3.17']/../n1:text/n1:reference/@value"/>

        <xsl:if test="$commentId!=''">
            <xsl:variable name="commentText" select="//*[@ID=substring-after($commentId, '#')]" />
            <xsl:if test="$commentText != ''">
                <xsl:value-of select="$commentText" />
            </xsl:if>
        </xsl:if>
    </xsl:template>

    <xsl:template name="getNextVaccinationDoseAndScheme">
        <xsl:param name="vaccinationCode" />

        <xsl:variable name="hasNextVaccinationDose">
            <xsl:call-template name="hasNextVaccinationDose">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
            </xsl:call-template>
        </xsl:variable>

        <xsl:variable name="hasNextVaccinationScheme">
            <xsl:call-template name="hasNextVaccinationScheme">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
            </xsl:call-template>
        </xsl:variable>

        <xsl:if test="$hasNextVaccinationDose='true'">
            <xsl:call-template name="getNextVaccinationDose">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
            </xsl:call-template>
        </xsl:if>

        <xsl:if test="$hasNextVaccinationDose='true' and $hasNextVaccinationScheme='true'">
            <xsl:text>, </xsl:text>
        </xsl:if>

        <xsl:if test="$hasNextVaccinationScheme='true'">
            <xsl:call-template name="getNextVaccinationScheme">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
            </xsl:call-template>
        </xsl:if>
    </xsl:template>

    <xsl:template name="hasNextVaccinationDose">
        <xsl:param name="vaccinationCode" />

        <xsl:choose>
            <xsl:when test="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']/../n1:code[@code=$vaccinationCode]/../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.3']/../n1:precondition/n1:criterion/n1:value/@code">
                <xsl:value-of select="string(true())" />
            </xsl:when>
            <xsl:otherwise>
                <xsl:value-of select="string(false())" />
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>

    <xsl:template name="getNextVaccinationDose">
        <xsl:param name="vaccinationCode" />

        <xsl:call-template name="getImmunizationDose">
            <xsl:with-param name="code" select="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']/../n1:code[@code=$vaccinationCode]/../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.3']/../n1:precondition/n1:criterion/n1:value/@code"/>
        </xsl:call-template>
    </xsl:template>

    <xsl:template name="hasNextVaccinationScheme">
        <xsl:param name="vaccinationCode" />

        <xsl:choose>
            <xsl:when test="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']/../n1:code[@code=$vaccinationCode]/../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.3']/../n1:precondition/n1:criterion/n1:code/@code">
                <xsl:value-of select="string(true())" />
            </xsl:when>
            <xsl:otherwise>
                <xsl:value-of select="string(false())" />
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>

    <xsl:template name="getNextVaccinationScheme">
        <xsl:param name="vaccinationCode" />

        <xsl:variable name="code">
            <xsl:value-of select="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']/../n1:code[@code=$vaccinationCode]/../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.3']/../n1:precondition/n1:criterion/n1:code/@code" />
        </xsl:variable>

        <xsl:variable name="resolvedVaccinationScheme">
            <xsl:call-template name="getImmunizationScheme">
                <xsl:with-param name="code" select="$code"/>
            </xsl:call-template>
        </xsl:variable>

        <xsl:choose>
            <xsl:when test="$resolvedVaccinationScheme != ''">
                <xsl:value-of select="$resolvedVaccinationScheme" />
            </xsl:when>
            <xsl:otherwise>
                <xsl:variable name="displayName">
                    <xsl:value-of select="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']/../n1:code[@code=$vaccinationCode]/../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.3']/../n1:precondition/n1:criterion/n1:code/@displayName" />
                </xsl:variable>
                <xsl:choose>
                    <xsl:when test="$displayName != '' and $code != ''">
                        <xsl:value-of select="$displayName"/>
                        <xsl:text> (</xsl:text>
                        <xsl:value-of select="$code" />
                        <xsl:text>)</xsl:text>
                    </xsl:when>
                    <xsl:when test="$displayName != '' and $code = ''">
                        <xsl:value-of select="$displayName"/>
                    </xsl:when>
                    <xsl:when test="$displayName = '' and $code != ''">
                        <xsl:text>unbekanntes Impfschema (</xsl:text>
                        <xsl:value-of select="$code" />
                        <xsl:text>)</xsl:text>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:text>unbekanntes Impfschema</xsl:text>
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>

