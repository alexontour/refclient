                                        $('#enable-recommendation-view').bootstrapToggle('on', true)
                                    };
                                ]]>
                            </xsl:when>
                            <xsl:otherwise>
                                <![CDATA[
                                    function viewToggleInit() {
                                        $('#enable-recommendation-view').bootstrapToggle('off', true)
                                    };
                                ]]>
                            </xsl:otherwise>
                        </xsl:choose>
                    </xsl:variable>

                    <xsl:text disable-output-escaping="yes"><![CDATA[//<]]></xsl:text><xsl:text disable-output-escaping="yes">![CDATA[</xsl:text>
                    <xsl:value-of  select="$jsInit" disable-output-escaping="yes"/>
                    <xsl:value-of select="$jsViewToggleInit" disable-output-escaping="yes" />
                    <xsl:text>//]]</xsl:text><xsl:text disable-output-escaping="yes"><![CDATA[>]]></xsl:text>
                </script>
