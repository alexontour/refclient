                                <xsl:with-param name="text" select="$diseaseReleaseTime" />
                                <xsl:with-param name="underlined" select="string(true())" />
                            </xsl:call-template>
                        </xsl:if>

                    </xsl:with-param>
                </xsl:call-template>
            </xsl:if>
        </xsl:for-each>
    </div>
</xsl:template>

<xsl:template name="renderExpandableRowEntry">
