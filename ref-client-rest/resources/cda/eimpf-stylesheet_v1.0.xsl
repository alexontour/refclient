    <xsl:template name="renderELGAImmunizationTargetAndereImpfungen">
        
        <xsl:for-each select="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']/../n1:entryRelationship/n1:observation/n1:code[
@code = '427036009' or @code = '836421005' or @code = '840564009' or @code = '871772009'
]">
            <xsl:variable name="vaccinationCode">
                <xsl:value-of select="@code" />
            </xsl:variable>
            <xsl:variable name="entryIdExtension">
                <xsl:value-of select="./../../../n1:id/@extension" />
            </xsl:variable>
            <xsl:variable name="entryIdRoot">
                <xsl:value-of select="./../../../n1:id/@root" />
            </xsl:variable>
            <xsl:variable name="idMaxTimeExtension">
                <xsl:call-template name="getLastEntryIdExtensionFromVaccinationCode">
                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                </xsl:call-template>
            </xsl:variable>
            <xsl:variable name="idMaxTimeRoot">
                <xsl:call-template name="getLastEntryIdRootFromVaccinationCode">
                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                </xsl:call-template>
            </xsl:variable>
            <xsl:if test="$idMaxTimeExtension=$entryIdExtension and $idMaxTimeRoot=$entryIdRoot">
                <xsl:call-template name="renderVaccinationSectionEntryOther">
                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                    <xsl:with-param name="section" select="'recommendationOther'" />
                </xsl:call-template>
            </xsl:if>
        </xsl:for-each>
    </xsl:template>
    
