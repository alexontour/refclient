                                    </xsl:if>

                                    <xsl:if test="$vaccinationAuthorDeviceName != ''">
                                        <xsl:value-of select="$vaccinationAuthorDeviceName" />
                                        <br />
                                    </xsl:if>

                                    <xsl:if test="$vaccinationAuthorOrganizationRole != ''">
                                        <xsl:value-of select="$vaccinationAuthorOrganizationRole" />
                                        <br />
                                    </xsl:if>

                                    <xsl:if test="$vaccinationAuthorOrganizationName != ''">
                                        <xsl:value-of select="$vaccinationAuthorOrganizationName" />
                                        <br />
                                    </xsl:if>

                                    <xsl:if test="$vaccinationAuthorOrganizationAddress != ''">
                                        <xsl:copy-of select="$vaccinationAuthorOrganizationAddress" />
                                        <br />
                                    </xsl:if>

                                    <xsl:if test="$vaccinationAuthorOrganizationTelecom != ''">
                                        <xsl:copy-of select="$vaccinationAuthorOrganizationTelecom" />
                                        <br />
                                    </xsl:if>
                                </xsl:with-param>
                                <xsl:with-param name="underlined" select="string(true())" />
                            </xsl:call-template>
                        </xsl:when>
                        <xsl:otherwise>
                            <xsl:call-template name="renderVaccinationDetails">
                                <xsl:with-param name="title">
                                    <xsl:text>Med. verantwortl. Person:</xsl:text>
                                </xsl:with-param>
                                <xsl:with-param name="text">
                                    <xsl:text>Keine Angabe</xsl:text>
                                </xsl:with-param>
                                <xsl:with-param name="underlined" select="string(true())" />
                            </xsl:call-template>
                        </xsl:otherwise>
                    </xsl:choose>

                    <xsl:variable name="participantDataEntererName">
                        <xsl:call-template name="getVaccinationDataEntererNameByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:variable name="participantDataEntererOrganizationName">
                        <xsl:call-template name="getVaccinationDataEntererOrganizationNameByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:variable name="participantDataEntererAddress">
                        <xsl:call-template name="getVaccinationDataEntererAddressByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:variable name="participantDataEntererTime">
                        <xsl:call-template name="getVaccinationDataEntererTimeByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:if test="$participantDataEntererName != '' or $participantDataEntererOrganizationName != '' or $participantDataEntererAddress != '' or $participantDataEntererTime != ''">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Eintragende Person:'" />
                            <xsl:with-param name="text">

                                <xsl:if test="$participantDataEntererName != ''">
                                    <xsl:value-of select="$participantDataEntererName" />
                                </xsl:if>

                                <xsl:if test="$participantDataEntererOrganizationName != ''">
                                    <br />
                                    <xsl:value-of select="$participantDataEntererOrganizationName" />
                                </xsl:if>

                                <xsl:if test="$participantDataEntererAddress != ''">
                                    <br />
                                    <xsl:copy-of select="$participantDataEntererAddress" />
                                </xsl:if>

                                <xsl:if test="$participantDataEntererTime != ''">
                                    <br />
                                    <xsl:text>am </xsl:text>
                                    <xsl:copy-of select="$participantDataEntererTime" />
                                </xsl:if>
                            </xsl:with-param>
                            <xsl:with-param name="underlined" select="string(true())" />
                        </xsl:call-template>
                    </xsl:if>

                    <xsl:variable name="participantTranscriberName">
                        <xsl:call-template name="getVaccinationTranscriberNameByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:variable name="participantTranscriberOrganizationName">
                        <xsl:call-template name="getVaccinationTranscriberOrganizationNameByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:variable name="participantTranscriberAddress">
                        <xsl:call-template name="getVaccinationTranscriberAddressByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:variable name="participantTranscriberTelecom">
                        <xsl:call-template name="getVaccinationTranscriberTelecomByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:variable name="participantTranscriberTime">
                        <xsl:call-template name="getVaccinationTranscriberTimeByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:if test="$participantTranscriberName != '' or $participantTranscriberOrganizationName != '' or $participantTranscriberAddress != '' or $participantTranscriberTelecom != '' or $participantTranscriberTime != ''">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Nachtragende Person:'" />
                            <xsl:with-param name="text">

                                <xsl:if test="$participantTranscriberName != ''">
                                    <xsl:value-of select="$participantTranscriberName" />
                                </xsl:if>

                                <xsl:if test="$participantTranscriberOrganizationName != ''">
                                    <br />
                                    <xsl:copy-of select="$participantTranscriberOrganizationName" />
                                </xsl:if>

                                <xsl:if test="$participantTranscriberAddress != ''">
                                    <br />
                                    <xsl:copy-of select="$participantTranscriberAddress" />
                                </xsl:if>

                                <xsl:if test="$participantTranscriberTelecom != ''">
                                    <br />
                                    <xsl:copy-of select="$participantTranscriberTelecom" />
                                </xsl:if>

                                <xsl:if test="$participantTranscriberTime != ''">
                                    <br />
                                    <xsl:text>am </xsl:text>
                                    <xsl:copy-of select="$participantTranscriberTime" />
                                </xsl:if>
                            </xsl:with-param>
                            <xsl:with-param name="underlined" select="string(true())" />
                        </xsl:call-template>
                    </xsl:if>

                    <xsl:variable name="performerName">
                        <xsl:call-template name="getPerformerNameByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="performerAddress">
                        <xsl:call-template name="getPerformerAddressByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="performerTelecom">
                        <xsl:call-template name="getPerformerTelecomByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="performerOrganizationName">
                        <xsl:call-template name="getPerformerOrganizationNameByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="performerOrganizationAddress">
                        <xsl:call-template name="getPerformerOrganizationAddressByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="performerOrganizationTelecom">
                        <xsl:call-template name="getPerformerOrganizationTelecomByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="hasPerformerRole">
                        <xsl:call-template name="hasPerformerRoleByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:if test="$hasPerformerRole = 'true' or $performerName != '' or $performerAddress != '' or $performerTelecom != '' or $performerOrganizationName != '' or $performerOrganizationAddress != '' or $performerOrganizationTelecom != ''">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Impfende Person:'" />
                            <xsl:with-param name="text">

                                <xsl:if test="$performerName != ''">
                                    <xsl:value-of select="$performerName" />
                                </xsl:if>

                                <xsl:if test="$hasPerformerRole = 'true'">
                                    <br />
                                    <xsl:call-template name="getPerformerRoleByEntryId">
                                        <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                        <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                    </xsl:call-template>
                                </xsl:if>

                                <xsl:if test="$performerAddress != ''">
                                    <br />
                                    <xsl:copy-of select="$performerAddress" />
                                </xsl:if>

                                <xsl:if test="$performerTelecom != ''">
                                    <br />
                                    <xsl:copy-of select="$performerTelecom" />
                                </xsl:if>

                                <xsl:if test="$performerOrganizationName != '' or $performerOrganizationAddress != '' or $performerOrganizationTelecom != ''">
                                    <br />
                                    <xsl:if test="$performerOrganizationName != ''">
                                        <br />
                                        <xsl:value-of select="$performerOrganizationName" />
                                    </xsl:if>
                                    <xsl:if test="$performerOrganizationAddress != ''">
                                        <br />
                                        <xsl:copy-of select="$performerOrganizationAddress" />
                                    </xsl:if>
                                    <xsl:if test="$performerOrganizationTelecom != ''">
                                        <br />
                                        <xsl:copy-of select="$performerOrganizationTelecom" />
                                    </xsl:if>
                                </xsl:if>
                            </xsl:with-param>
                            <xsl:with-param name="underlined" select="string(true())" />
                        </xsl:call-template>
                    </xsl:if>

                    <xsl:variable name="participantVRFName">
                        <xsl:call-template name="getVaccinationParticipantVRFNameByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:variable name="participantVRFOrganizationName">
                        <xsl:call-template name="getVaccinationParticipantVRFOrganizationNameByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:variable name="participantVRFAddress">
                        <xsl:call-template name="getVaccinationParticipantVRFAddressByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:variable name="participantVRFTelecom">
                        <xsl:call-template name="getVaccinationParticipantVRFTelecomByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:variable name="participantVRFTime">
                        <xsl:call-template name="getVaccinationParticipantVRFTimeByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:if test="$participantVRFName != '' or $participantVRFOrganizationName != '' or $participantVRFAddress != '' or $participantVRFTelecom != '' or $participantVRFTime != ''">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Korrigiert durch:'" />
                            <xsl:with-param name="text">
                                <xsl:if test="$participantVRFName != ''">
                                    <xsl:value-of select="$participantVRFName" />
                                </xsl:if>

                                <xsl:if test="$participantVRFOrganizationName != ''">
                                    <br />
                                    <xsl:copy-of select="$participantVRFOrganizationName" />
                                </xsl:if>

                                <xsl:if test="$participantVRFAddress != ''">
                                    <br />
                                    <xsl:copy-of select="$participantVRFAddress" />
                                </xsl:if>

                                <xsl:if test="$participantVRFTelecom != ''">
                                    <br />
                                    <xsl:copy-of select="$participantVRFTelecom" />
                                </xsl:if>

                                <xsl:if test="$participantVRFTime != ''">
                                    <br />
                                    <xsl:text>am </xsl:text>
                                    <xsl:copy-of select="$participantVRFTime" />
                                </xsl:if>
                            </xsl:with-param>
                            <xsl:with-param name="underlined" select="string(true())" />
                        </xsl:call-template>
                    </xsl:if>

                    <xsl:variable name="vaccinationReleaseTime">
                        <xsl:call-template name="getVaccinationReleaseTimeByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:if test="$vaccinationReleaseTime != ''">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Freigabezeitpunkt:'" />
                            <xsl:with-param name="text" select="$vaccinationReleaseTime" />
                            <xsl:with-param name="underlined" select="string(true())" />
                        </xsl:call-template>
                    </xsl:if>
                </xsl:with-param>
            </xsl:call-template>
        </xsl:for-each>

        <!-- antibody -->
        <xsl:for-each select="//n1:code[@code=$vaccinationCode]/../n1:component/n1:observation/n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']">

            <xsl:variable name="currentEntryIdExtension" select="./../n1:id/@extension" />
            <xsl:variable name="currentEntryIdRoot" select="./../n1:id/@root" />

            <xsl:variable name="antiBodyDate">
                <xsl:call-template name="getAntiBodyDateByEntryId">
                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="antiBodyAuthorName">
                <xsl:call-template name="getAntiBodyAuthorNameByEntryId">
                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="antiBodyAuthorDeviceName">
                <xsl:call-template name="getAntiBodyAuthorDeviceNameByEntryId">
                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="antiBodyAuthorOrganizationName">
                <xsl:call-template name="getAntiBodyAuthorOrganizationNameByEntryId">
                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="isAntiBodyAuthorDeviceNameAvailable">
                <xsl:call-template name="isAntiBodyAuthorDeviceNameAvailable">
                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="antiBodyComment">
                <xsl:call-template name="getAntiBodyCommentByEntryId">
                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="hasAntiBodyCommentAuthor">
                <xsl:call-template name="hasAntiBodyCommentAuthor">
                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="antiBodyCommentAuthorName">
                <xsl:call-template name="getAntiBodyCommentAuthorNameByEntryId">
                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="hasAntiBodyInterpretation">
                <xsl:call-template name="hasAntiBodyInterpretationByEntryId">
                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="antiBodyInterpretation">
                <xsl:call-template name="getAntiBodyInterpretationByEntryId">
                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="antiBodyAborted">
                <xsl:call-template name="isAntiBodyStatusAborted">
                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:call-template name="renderExpandableRowEntry">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                <xsl:with-param name="rawDate">
                    <xsl:call-template name="getAntiBodyDateRawByEntryId" >
                        <xsl:with-param name="root" select="$currentEntryIdRoot" />
                        <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                    </xsl:call-template>
                </xsl:with-param>
                <xsl:with-param name="header-col-1-test-id" select="concat('row-', $vaccinationCode, '-body-row-col-antibody-', position())" />
                <xsl:with-param name="header-col-1">
                    <xsl:value-of select="$antiBodyDate" />
                </xsl:with-param>
                <xsl:with-param name="header-col-2">

                    <xsl:choose>
                        <xsl:when test="$antiBodyAborted='false'">
                            <xsl:call-template name="getAntiBodySummaryByEntryId">
                                <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                            </xsl:call-template>

                            <xsl:if test="$hasAntiBodyInterpretation='true' and $antiBodyComment=''">
                                <p class="antiBodyInterpretation">
                                    <strong><xsl:text>Ergebnis-Interpretation: </xsl:text></strong>
                                    <xsl:value-of select="$antiBodyInterpretation" />
                                </p>
                            </xsl:if>
                        </xsl:when>
                        <xsl:otherwise>
                            <strong>Storniert: </strong>
                            <xsl:call-template name="getAntiBodyTextByEntryId">
                                <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                            </xsl:call-template>
                        </xsl:otherwise>
                    </xsl:choose>
                </xsl:with-param>
                <xsl:with-param name="header-col-3">
                    <xsl:if test="$antiBodyAborted='false' and $antiBodyComment != ''">
                        <strong>
                            <xsl:choose>
                                <xsl:when test="$hasAntiBodyCommentAuthor='true'">
                                    <xsl:text>Kommentar [</xsl:text>
                                    <xsl:value-of select="$antiBodyCommentAuthorName" />
                                    <xsl:text>]: </xsl:text>
                                </xsl:when>
                                <xsl:otherwise>
                                    <xsl:text>Kommentar: </xsl:text>
                                </xsl:otherwise>
                            </xsl:choose>
                        </strong>
                        <xsl:call-template name="truncate">
                            <xsl:with-param name="text" select="$antiBodyComment" />
                            <xsl:with-param name="maxLength" select="$commentMaxLength" />
                        </xsl:call-template>
                    </xsl:if>
                </xsl:with-param>
                <xsl:with-param name="header-col-4">
                    <xsl:choose>
                        <xsl:when test="$isAntiBodyAuthorDeviceNameAvailable = 'true' and $antiBodyAuthorOrganizationName != ''">
                            <xsl:value-of select="$antiBodyAuthorOrganizationName" />
                        </xsl:when>
                        <xsl:when test="$antiBodyAuthorName = '' and $antiBodyAuthorOrganizationName = ''">
                            <xsl:text>Keine Angabe</xsl:text>
                        </xsl:when>
                        <xsl:otherwise>
                            <xsl:value-of select="$antiBodyAuthorName" />
                            <xsl:if test="$antiBodyAuthorOrganizationName != ''">
                                <br />
                                <xsl:value-of select="$antiBodyAuthorOrganizationName" />
                            </xsl:if>
                        </xsl:otherwise>
                    </xsl:choose>
                </xsl:with-param>
                <xsl:with-param name="header-col-5">
                    <xsl:variable name="antiBodyCertificateAvailable">
                        <xsl:call-template name="hasCertificateLinkForAntiBodyEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:if test="$antiBodyAborted='false' and $antiBodyCertificateAvailable='true'">
                        <xsl:variable name="linkTarget">
                            <xsl:call-template name="getCertificateLinkForAntiBodyEntryId">
                                <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                            </xsl:call-template>
                        </xsl:variable>
                        <xsl:variable name="linkText">
                            <xsl:call-template name="getCertificateLinkTextForAntiBodyEntryId">
                                <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                            </xsl:call-template>
                        </xsl:variable>
                        <a class="certificate" target="_blank">
                            <xsl:attribute name="href">
                                <xsl:value-of select="$linkTarget" />
                            </xsl:attribute>
                            <xsl:value-of select="$linkText" />
                        </a>
                    </xsl:if>
                </xsl:with-param>
                <xsl:with-param name="body-left">
                    <xsl:call-template name="renderVaccinationDetails">
                        <xsl:with-param name="title" select="'Datum:'" />
                        <xsl:with-param name="text" select="$antiBodyDate" />
                    </xsl:call-template>
                    <xsl:if test="$antiBodyAborted='true'">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Status:'" />
                            <xsl:with-param name="text" select="'storniert'" />
                            <xsl:with-param name="textBold" select="string(true())" />
                        </xsl:call-template>
                    </xsl:if>
                    <xsl:call-template name="renderVaccinationDetails">
                        <xsl:with-param name="title" select="'Analyse:'" />
                        <xsl:with-param name="text">
                            <xsl:call-template name="getAntiBodyTextByEntryId">
                                <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                            </xsl:call-template>
                        </xsl:with-param>
                    </xsl:call-template>

                    <xsl:variable name="antiBodyValue">
                        <xsl:call-template name="getAntiBodyValueByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="antiBodyUnit">
                        <xsl:call-template name="getAntiBodyUnitByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:if test="$antiBodyAborted='false' and $antiBodyValue != ''">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Ergebnis:'" />
                            <xsl:with-param name="text">
                                <xsl:value-of select="$antiBodyValue" />
