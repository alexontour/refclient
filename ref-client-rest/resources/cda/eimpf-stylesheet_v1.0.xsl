                                    <xsl:copy-of select="$participantVRFOrganizationName" />
                                </xsl:if>

                                <xsl:if test="$participantVRFAddress != ''">
                                    <br />
                                    <xsl:copy-of select="$participantVRFAddress" />
                                </xsl:if>

                                <xsl:if test="$participantVRFTelecom != ''">
                                    <br />
                                    <xsl:copy-of select="$participantVRFTelecom" />
                                </xsl:if>

                                <xsl:if test="$participantVRFTime != ''">
                                    <br />
                                    <xsl:text>am </xsl:text>
                                    <xsl:copy-of select="$participantVRFTime" />
                                </xsl:if>
                            </xsl:with-param>
                            <xsl:with-param name="underlined" select="string(true())" />
