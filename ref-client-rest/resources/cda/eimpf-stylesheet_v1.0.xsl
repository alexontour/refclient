                        <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                    </xsl:call-template>
                </xsl:variable>

                <xsl:variable name="hasDiseaseCommentAuthor">
                    <xsl:call-template name="hasDiseaseCommentAuthor">
