</xsl:template>

<xsl:template name="renderVaccinationIndicationView">
    <xsl:variable name="hasVaccinationIndication">
        <xsl:call-template name="hasActiveVaccinationIndication" />
    </xsl:variable>

    <xsl:if test="$hasVaccinationIndication='true'">
        <xsl:call-template name="renderChronologicalViewHeader">
            <xsl:with-param name="section" select="'vaccinationIndication'" />
            <xsl:with-param name="title" select="'Indikationsgruppe'" />
            <xsl:with-param name="title2" select="'Indikationszeitraum'" />
            <xsl:with-param name="title4" select="'Medizinisch verantwortliche Person'" />
            <xsl:with-param name="cssOverride" select="'tableHeaderContainerLargeMarginTop'" />
        </xsl:call-template>

        <div id="vaccinationIndicationContainer">
            <!-- entries with known date -->
            <xsl:for-each select="//n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.20']]/n1:low/@value | //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.20'] and n1:low[@nullFlavor='UNK']]/n1:high/@value">
                <xsl:sort select="." order="descending" />
                <xsl:sort select="./../../../n1:id/@root" />
                <xsl:sort select="./../../../n1:id/@extension" />

                <xsl:call-template name="renderVaccinationIndicationEntry">
                    <xsl:with-param name="entryIdRoot" select="./../../../n1:id/@root" />
                    <xsl:with-param name="entryIdExtension" select="./../../../n1:id/@extension" />
                </xsl:call-template>
            </xsl:for-each>

            <!-- entries with unknown date -->
            <xsl:for-each select="//n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.20'] and n1:low/@nullFlavor='UNK' and (n1:high/@nullFlavor='UNK' or not(n1:high))]">
                <xsl:sort select="." order="descending" />
                <xsl:sort select="./../n1:id/@root" />
                <xsl:sort select="./../n1:id/@extension" />

                <xsl:call-template name="renderVaccinationIndicationEntry">
                    <xsl:with-param name="entryIdRoot" select="./../n1:id/@root" />
                    <xsl:with-param name="entryIdExtension" select="./../n1:id/@extension" />
                </xsl:call-template>
            </xsl:for-each>
        </div>
    </xsl:if>
</xsl:template>

<xsl:template name="renderVaccinationIndicationEntry">
    <xsl:param name="entryIdRoot" />
    <xsl:param name="entryIdExtension" />

    <xsl:variable name="isActive">
        <xsl:call-template name="isVaccinationIndicationActive">
            <xsl:with-param name="root" select="$entryIdRoot" />
            <xsl:with-param name="extension" select="$entryIdExtension" />
        </xsl:call-template>
    </xsl:variable>

    <xsl:if test="$isActive='true'">
        <xsl:variable name="entry" select="//n1:id[(@extension=$entryIdExtension and @root=$entryIdRoot) or ((not(@extension) or @extension = '') and (not($entryIdExtension) or $entryIdExtension = '') and @root=$entryIdRoot)]" />
        <xsl:variable name="targetImmunizationCode" select="$entry/../n1:entryRelationship/n1:observation/n1:value/@code" />

        <xsl:variable name="searchName">
            <xsl:call-template name="getSpecialSituationIndication">
                <xsl:with-param name="code" select="$targetImmunizationCode" />
            </xsl:call-template>
        </xsl:variable>

        <xsl:variable name="rowId" select="concat('row-vaccinationindication-', $targetImmunizationCode, '-', position())" />
        <xsl:variable name="section" select="'vaccinationIndication'" />

        <div id="{$rowId}" class="panel-group headerRow {$section}Row" data-search-immunization-name="{$searchName}" data-search-immunization-product="{$searchName}">
            <div class="panel panel-default textNormal">
                <div class="panel-heading">
                    <div class="panel-title">
                        <div class="container vaccinationRowContainer">
                            <div class="row">
                                <div class="col-2 col-23p-vaccination media"  data-test-id="{$rowId}">
                                    <h3 class="my-auto my-center textVaccinationTitle text-break">
                                        <xsl:call-template name="getVaccinationIndicationImmunizationTargetByEntryId">
                                            <xsl:with-param name="root" select="$entryIdRoot" />
                                            <xsl:with-param name="extension" select="$entryIdExtension" />
                                        </xsl:call-template>
                                    </h3>
                                </div>
                                <div class="col-1 col-51p-vaccination my-auto my-center text-break" data-test-id="{$rowId}">
                                    <xsl:call-template name="getVaccinationIndicationDateByEntryId">
                                        <xsl:with-param name="root" select="$entryIdRoot" />
                                        <xsl:with-param name="extension" select="$entryIdExtension" />
                                    </xsl:call-template>
                                </div>
                                <div class="col-1 col-26p-vaccination my-auto my-center text-break" data-test-id="{$rowId}">
                                    <xsl:variable name="vaccinationIndicationAuthorOrganizationName">
                                        <xsl:call-template name="getVaccinationIndicationAuthorOrganizationNameByEntryId">
                                            <xsl:with-param name="root" select="$entryIdRoot" />
                                            <xsl:with-param name="extension" select="$entryIdExtension" />
                                        </xsl:call-template>
                                    </xsl:variable>

                                    <xsl:variable name="vaccinationIndicationAuthorName">
                                        <xsl:call-template name="getVaccinationIndicationAuthorNameByEntryId">
                                            <xsl:with-param name="root" select="$entryIdRoot" />
                                            <xsl:with-param name="extension" select="$entryIdExtension" />
                                        </xsl:call-template>
                                    </xsl:variable>

                                    <xsl:if test="$vaccinationIndicationAuthorName != ''">
                                        <xsl:value-of select="$vaccinationIndicationAuthorName" />
                                    </xsl:if>
                                    <xsl:if test="$vaccinationIndicationAuthorOrganizationName != '' and $vaccinationIndicationAuthorName != ''">
                                        <br />
                                    </xsl:if>
                                    <xsl:if test="$vaccinationIndicationAuthorOrganizationName != ''">
                                        <xsl:value-of select="$vaccinationIndicationAuthorOrganizationName" />
                                    </xsl:if>
                                    <xsl:if test="$vaccinationIndicationAuthorName = '' and $vaccinationIndicationAuthorOrganizationName = ''">
                                        <xsl:text>Keine Angabe</xsl:text>
                                    </xsl:if>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </xsl:if>
</xsl:template>

