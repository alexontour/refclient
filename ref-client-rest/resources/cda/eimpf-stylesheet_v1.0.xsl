    <xsl:template name="getAntiBodyReferenceRangeByEntryId">
        <xsl:param name="root" />
        <xsl:param name="extension" />

        <xsl:variable name="entry" select="//n1:id[(@extension=$extension and @root=$root) or ((not(@extension) or @extension = '') and (not($extension) or $extension = '') and @root=$root)]" />
        <xsl:variable name="observationRangeEntries" select="$entry/../n1:referenceRange/n1:observationRange" />

        <xsl:choose>
            <xsl:when test="$observationRangeEntries/n1:value/@xsi:type='IVL_PQ'">
                <xsl:call-template name="getAntiBodyReferenceRangeIVLPQValueFormatted">
                    <xsl:with-param name="value" select="$observationRangeEntries/n1:value" />
                </xsl:call-template>
            </xsl:when>
            <xsl:when test="$observationRangeEntries/n1:value/@xsi:type='RTO'">
                <xsl:call-template name="getAntiBodyReferenceRangeRTOValueFormatted">
                    <xsl:with-param name="value" select="$observationRangeEntries/n1:value" />
                </xsl:call-template>
            </xsl:when>
            <xsl:otherwise>
                <!-- Can not happen, because data types are checked in hasAntiBodyReferenceRange -->
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>

    <xsl:template name="getAntiBodyReferenceRangeIVLPQValueFormatted">
        <xsl:param name="value" />

        <xsl:if test="$value/n1:low/@value != ''">
            <xsl:choose>
                <xsl:when test="$value/n1:high/@nullFlavor and $value/n1:low/@inclusive='true'">
                    <xsl:text>&#x2265;</xsl:text> <!-- ≥ -->
                </xsl:when>
                <xsl:when test="$value/n1:high/@nullFlavor and $value/n1:low/@inclusive='false'">
                    <xsl:text>&#x003E;</xsl:text> <!-- > -->
                </xsl:when>
            </xsl:choose>
            <xsl:call-template name="formatValueUnitQuantity">
                <xsl:with-param name="element" select="$value/n1:low" />
            </xsl:call-template>
        </xsl:if>

        <xsl:if test="$value/n1:high/@value != ''">
            <xsl:choose>
                <xsl:when test="$value/n1:low/@nullFlavor and $value/n1:high/@inclusive='true'">
                    <xsl:text>&#x2264;</xsl:text> <!-- ≤ -->
                </xsl:when>
                <xsl:when test="$value/n1:low/@nullFlavor and $value/n1:high/@inclusive='false'">
                    <xsl:text>&#x003C;</xsl:text> <!-- < -->
                </xsl:when>
                <xsl:otherwise>
                    <xsl:text> - </xsl:text>
                </xsl:otherwise>
            </xsl:choose>
            <xsl:call-template name="formatValueUnitQuantity">
                <xsl:with-param name="element" select="$value/n1:high" />
            </xsl:call-template>
        </xsl:if>
    </xsl:template>

    <xsl:template name="formatValueUnitQuantity">
        <xsl:param name="element" />

        <xsl:if test="$element/@value != ''">
            <xsl:value-of select="$element/@value" />
            <xsl:if test="$element/@unit != ''">
                <xsl:text> </xsl:text>
                <xsl:value-of select="$element/@unit" />
            </xsl:if>
        </xsl:if>
    </xsl:template>

    <xsl:template name="getAntiBodyReferenceRangeRTOValueFormatted">
        <xsl:param name="value" />

        <xsl:if test="$value/n1:numerator/@value != ''">
            <xsl:value-of select="$value/n1:numerator/@value" />
        </xsl:if>
        <xsl:if test="$value/n1:denominator/n1:high or $value/n1:denominator/n1:low">
            <xsl:text>:</xsl:text>
            <xsl:if test="$value/n1:denominator/n1:low/@value != ''">
                <xsl:choose>
                    <xsl:when test="($value/n1:denominator/n1:high/@nullFlavor or not($value/n1:denominator/n1:high)) and $value/n1:denominator/n1:low/@inclusive='true'">
                        <xsl:text>&#x2265;</xsl:text> <!-- ≥ -->
                    </xsl:when>
                    <xsl:when test="($value/n1:denominator/n1:high/@nullFlavor or not($value/n1:denominator/n1:high)) and $value/n1:denominator/n1:low/@inclusive='false'">
                        <xsl:text>&#x003E;</xsl:text> <!-- > -->
                    </xsl:when>
                </xsl:choose>
                <xsl:value-of select="$value/n1:denominator/n1:low/@value" />
            </xsl:if>
            <xsl:if test="$value/n1:denominator/n1:low/@value != '' and $value/n1:denominator/n1:high/@value != ''">
                <xsl:text>-</xsl:text>
            </xsl:if>
            <xsl:if test="$value/n1:denominator/n1:high/@value != ''">
                <xsl:choose>
                    <xsl:when test="($value/n1:denominator/n1:low/@nullFlavor or not($value/n1:denominator/n1:low)) and $value/n1:denominator/n1:high/@inclusive='true'">
                        <xsl:text>&#x2264;</xsl:text> <!-- ≤ -->
                    </xsl:when>
                    <xsl:when test="($value/n1:denominator/n1:low/@nullFlavor or not($value/n1:denominator/n1:low)) and $value/n1:denominator/n1:high/@inclusive='false'">
                        <xsl:text>&#x003C;</xsl:text> <!-- < -->
                    </xsl:when>
                </xsl:choose>
                <xsl:value-of select="$value/n1:denominator/n1:high/@value" />
            </xsl:if>
        </xsl:if>
    </xsl:template>

