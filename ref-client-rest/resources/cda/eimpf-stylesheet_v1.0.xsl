                            <xsl:if test="$spouseFamilyName!=''">
                                <xsl:call-template name="renderPatientHeaderDetailLine">
                                    <xsl:with-param name="left" select="'Familienname Ehepartner:in'" />
                                    <xsl:with-param name="right" select="$spouseFamilyName"/>
                                </xsl:call-template>
                            </xsl:if>

                            <xsl:variable name="namesBeforeAdoption">
                                <xsl:call-template name="getPatientNamesBeforeAdoption"/>
                            </xsl:variable>
                            <xsl:if test="$namesBeforeAdoption!=''">
                                <xsl:call-template name="renderPatientHeaderDetailLine">
                                    <xsl:with-param name="left" select="'Name vor Adoption'" />
                                    <xsl:with-param name="right" select="$namesBeforeAdoption"/>
                                </xsl:call-template>
                            </xsl:if>

                            <xsl:variable name="birthNames">
                                <xsl:call-template name="getPatientBirthNames"/>
                            </xsl:variable>
                            <xsl:if test="$birthNames!=''">
                                <xsl:call-template name="renderPatientHeaderDetailLine">
                                    <xsl:with-param name="left" select="'Geburtsname'" />
                                    <xsl:with-param name="right" select="$birthNames"/>
                                </xsl:call-template>
                            </xsl:if>

                            <xsl:call-template name="renderPatientHeaderDetailLine">
                                <xsl:with-param name="left" select="'Geburtsdatum'" />
                                <xsl:with-param name="right">
                                    <xsl:call-template name="getPatientDateOfBirth"/>
                                </xsl:with-param>
                            </xsl:call-template>

                            <xsl:variable name="placeOfBirth">
                                <xsl:call-template name="getPatientPlaceOfBirth"/>
                            </xsl:variable>
                            <xsl:if test="$placeOfBirth!=''">
                                <xsl:call-template name="renderPatientHeaderDetailLine">
                                    <xsl:with-param name="left" select="'Geburtsort'" />
                                    <xsl:with-param name="right">
                                        <xsl:value-of select="$placeOfBirth"/>
                                    </xsl:with-param>
                                </xsl:call-template>
                            </xsl:if>

                            <xsl:variable name="hasPatientDeceasedDate">
                                <xsl:call-template name="hasPatientDeceasedDate" />
                            </xsl:variable>
                            <xsl:if test="$hasPatientDeceasedDate='true'">
                                <xsl:call-template name="renderPatientHeaderDetailLine">
                                    <xsl:with-param name="left" select="'Todesdatum'" />
                                    <xsl:with-param name="right">
                                        <xsl:call-template name="getPatientDeceasedDate" />
                                    </xsl:with-param>
                                </xsl:call-template>
                            </xsl:if>

                            <!-- svn number is mandatory; so fixed spacer is ok here -->
                            <xsl:call-template name="patientSpacer" />

                            <xsl:call-template name="renderPatientHeaderDetailLine">
                                <xsl:with-param name="left" select="'SVNR'" />
                                <xsl:with-param name="right">
                                    <xsl:call-template name="getPatientInsuranceNumber"/>
                                </xsl:with-param>
                            </xsl:call-template>

                            <xsl:variable name="maritalStatus">
                                <xsl:call-template name="getPatientMaritalStatus"/>
                            </xsl:variable>
                            <xsl:if test="$maritalStatus!=''">
                                <xsl:call-template name="renderPatientHeaderDetailLine">
                                    <xsl:with-param name="left" select="'Familienstand'" />
                                    <xsl:with-param name="right">
                                        <xsl:value-of select="$maritalStatus"/>
                                    </xsl:with-param>
                                </xsl:call-template>
                            </xsl:if>

                            <xsl:variable name="religiousAffiliation">
                                <xsl:call-template name="getPatientReligiousAffiliation"/>
                            </xsl:variable>
                            <xsl:if test="$religiousAffiliation!=''">
                                <xsl:call-template name="renderPatientHeaderDetailLine">
                                    <xsl:with-param name="left" select="'Religionsgemeinschaft'" />
                                    <xsl:with-param name="right">
                                        <xsl:value-of select="$religiousAffiliation"/>
                                    </xsl:with-param>
                                </xsl:call-template>
                            </xsl:if>

                            <xsl:variable name="communication">
                                <xsl:call-template name="getPatientLanguageCommunication"/>
                            </xsl:variable>
                            <xsl:if test="$communication!=''">
                                <xsl:call-template name="renderPatientHeaderDetailLine">
                                    <xsl:with-param name="left" select="'Gesprochene Sprachen'" />
                                    <xsl:with-param name="right">
                                        <xsl:call-template name="getPatientLanguageCommunication"/>
                                    </xsl:with-param>
                                </xsl:call-template>
                            </xsl:if>

                            <xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:telecom">

                                <xsl:call-template name="patientSpacer"/>

                                <xsl:for-each select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:telecom">
                                    <xsl:call-template name="renderPatientHeaderDetailLine">
                                        <xsl:with-param name="left">
                                            <xsl:call-template name="getTelecomTitle">
                                                <xsl:with-param name="node" select="."/>
                                            </xsl:call-template>
                                            <xsl:text> </xsl:text>
                                            <xsl:call-template name="getTelecomSubTitle">
                                                <xsl:with-param name="node" select="."/>
                                            </xsl:call-template>
                                        </xsl:with-param>
                                        <xsl:with-param name="right">
                                            <xsl:call-template name="getTelecomValue">
                                                <xsl:with-param name="node" select="."/>
                                            </xsl:call-template>
                                        </xsl:with-param>
                                    </xsl:call-template>
                                </xsl:for-each>
                            </xsl:if>
                        </div>
                        <div class="col-6">

                            <xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:addr">
                                <xsl:for-each select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:addr">

                                    <xsl:if test="position() > 1">
                                        <xsl:call-template name="patientSpacer" />
                                    </xsl:if>

                                    <xsl:call-template name="renderPatientHeaderDetailLine">
                                        <xsl:with-param name="left">
                                            <xsl:call-template name="mapTelecomCode">
                                                <xsl:with-param name="code" select="@use"/>
                                            </xsl:call-template>
                                        </xsl:with-param>
                                        <xsl:with-param name="right">
                                            <xsl:call-template name="getAddress">
                                                <xsl:with-param name="node" select="."/>
                                            </xsl:call-template>
                                        </xsl:with-param>
                                    </xsl:call-template>
                                </xsl:for-each>
                            </xsl:if>

                            <xsl:if test="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian">

                                <xsl:call-template name="patientSpacer"/>

                                <xsl:call-template name="renderPatientHeaderDetailLine">
                                    <xsl:with-param name="left" select="'Gesetzliche Vertretung: Erwachsenen-vertretung, obsorgeberechtigte Person, Person mit Vormundschaft'" />
                                    <xsl:with-param name="right">
                                        <xsl:for-each select="/n1:ClinicalDocument/n1:recordTarget/n1:patientRole/n1:patient/n1:guardian">

                                            <xsl:if test="position() > 1">
                                                <xsl:call-template name="patientSpacer"/>
                                            </xsl:if>

                                            <xsl:if test="./n1:guardianPerson/n1:name">
                                                <strong>
                                                    <xsl:call-template name="getName">
                                                        <xsl:with-param name="node" select="./n1:guardianPerson/n1:name"/>
                                                    </xsl:call-template>
                                                    <br />
                                                </strong>
                                            </xsl:if>

                                            <xsl:if test="./n1:guardianOrganization/n1:name">
                                                <strong>
                                                    <xsl:call-template name="getName">
                                                        <xsl:with-param name="node" select="./n1:guardianOrganization/n1:name"/>
                                                    </xsl:call-template>
                                                    <br />
                                                </strong>
                                            </xsl:if>

                                            <xsl:call-template name="getAddress">
                                                <xsl:with-param name="node" select="./n1:addr"/>
                                            </xsl:call-template>
                                            <br />

                                            <xsl:if test="./n1:telecom">
                                                <xsl:call-template name="getAllTelecomEntries">
                                                    <xsl:with-param name="node" select="."/>
                                                </xsl:call-template>
                                            </xsl:if>
                                        </xsl:for-each>
                                    </xsl:with-param>
                                </xsl:call-template>

                            </xsl:if>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</xsl:template>

<xsl:template name="renderPatientHeaderDetailLine">
    <xsl:param name="left" />
    <xsl:param name="leftTestId" select="''" />
    <xsl:param name="right" />

    <div class="row">
        <div class="col-4 text-break" data-test-id="{$leftTestId}">
            <strong>
                <xsl:copy-of select="$left" />
            </strong>
        </div>
        <div class="col-8 text-break">
            <xsl:copy-of select="$right" />
        </div>
    </div>
</xsl:template>

<xsl:template name="patientSpacer">
    <div class="row" style="margin-top: 1em" />
</xsl:template>

<xsl:template name="bannerBox">
    <div id="recommendation-bannerBox" style="{$recommendationDefaultVisibilityStyle}">
        <div class="row">
            <div class="col">
                <div class="banner">
                    <xsl:copy-of select="$bannerText" />
                </div>
            </div>
        </div>
    </div>
</xsl:template>
<xsl:variable name="commentMaxLength" select="150" />

<xsl:template name="renderVaccinations">
    <xsl:call-template name="renderSectionHeader">
        <xsl:with-param name="header" select="'e-Impfpass'" />
        <xsl:with-param name="section" select="'general'" />
    </xsl:call-template>

    <div id="recommendation-vaccinationEntries" style="{$recommendationDefaultVisibilityStyle}">
        <!-- view with recommendations -->
        <!-- general vaccinations -->
        <xsl:call-template name="renderHeader">
            <xsl:with-param name="section" select="'recommendationGeneral'" />
        </xsl:call-template>
        <xsl:call-template name="renderImmunizationEntries">
            <xsl:with-param name="section" select="'recommendationGeneral'" />
        </xsl:call-template>

        <!-- travel vaccinations -->
        <xsl:variable name="hasTravelVaccinations">
            <xsl:call-template name="hasTravelVaccinations" />
        </xsl:variable>
        <xsl:if test="$hasTravelVaccinations='true'">
            <xsl:call-template name="renderSectionHeader">
                <xsl:with-param name="header" select="'Durchgeführte Reise- und Indikationsimpfungen'" />
                <xsl:with-param name="section" select="'recommendationTravel'" />
            </xsl:call-template>
            <xsl:call-template name="renderHeader">
                <xsl:with-param name="section" select="'recommendationTravel'" />
            </xsl:call-template>
            <xsl:call-template name="renderImmunizationEntries">
                <xsl:with-param name="section" select="'recommendationTravel'" />
            </xsl:call-template>
        </xsl:if>

        <!-- other vaccinations -->
        <xsl:variable name="hasOtherVaccinations">
            <xsl:call-template name="hasOtherVaccinations" />
        </xsl:variable>
        <xsl:if test="$hasOtherVaccinations='true'">
            <xsl:call-template name="renderSectionHeader">
                <xsl:with-param name="header" select="'Weitere durchgeführte Impfungen'" />
                <xsl:with-param name="section" select="'recommendationOther'" />
            </xsl:call-template>
            <xsl:call-template name="renderOtherHeader">
                <xsl:with-param name="section" select="'recommendationOther'" />
            </xsl:call-template>
            <xsl:call-template name="renderImmunizationEntries">
                <xsl:with-param name="section" select="'recommendationOther'" />
            </xsl:call-template>
        </xsl:if>
    </div>

    <div id="default-vaccinationEntries" style="{$defaultVisibilityStyle}">
        <!-- chronological view -->
        <xsl:variable name="hasGeneralEntries">
            <xsl:call-template name="hasAppliedGeneralEntries" />
        </xsl:variable>

        <xsl:variable name="hasTravelEntries">
            <xsl:call-template name="hasAppliedTravelEntries" />
        </xsl:variable>

        <xsl:variable name="hasOtherEntries">
            <xsl:call-template name="hasAppliedOtherEntries" />
        </xsl:variable>

        <xsl:choose>
            <xsl:when test="$hasGeneralEntries='true' or $hasTravelEntries='true' or $hasOtherEntries='true'">
                <xsl:choose>
                    <xsl:when test="$disableVaccinationDetails='1'">
                        <xsl:call-template name="renderChronologicalViewHeader">
                            <xsl:with-param name="section" select="'defaultGeneral'" />
                            <xsl:with-param name="title" select="'Einträge'" />
                        </xsl:call-template>
                        <xsl:call-template name="renderChronologicalViewWithoutVaccinationGrouping" />
                    </xsl:when>
                    <xsl:otherwise>
                        <!-- general -->
                        <xsl:if test="$hasGeneralEntries='true'">
                            <xsl:call-template name="renderChronologicalViewHeader">
                                <xsl:with-param name="section" select="'defaultGeneral'" />
                            </xsl:call-template>
                            <xsl:call-template name="getChronologicalVaccinationsBySectionGrouped">
                                <xsl:with-param name="section" select="'defaultGeneral'" />
                            </xsl:call-template>
                        </xsl:if>

                        <!-- travel -->
                        <xsl:if test="$hasTravelEntries='true'">
                            <xsl:call-template name="renderSectionHeader">
                                <xsl:with-param name="header" select="'Durchgeführte Reise- und Indikationsimpfungen'" />
                                <xsl:with-param name="section" select="'defaultTravel'" />
                            </xsl:call-template>
                            <xsl:call-template name="renderChronologicalViewHeader">
                                <xsl:with-param name="section" select="'defaultTravel'" />
                            </xsl:call-template>
                            <xsl:call-template name="getChronologicalVaccinationsBySectionGrouped">
                                <xsl:with-param name="section" select="'defaultTravel'" />
                            </xsl:call-template>
                        </xsl:if>

                        <!-- other -->
                        <xsl:if test="$hasOtherEntries='true'">
                            <xsl:call-template name="renderSectionHeader">
                                <xsl:with-param name="header" select="'Weitere durchgeführte Impfungen'" />
                                <xsl:with-param name="section" select="'defaultOther'" />
                            </xsl:call-template>
                            <xsl:call-template name="renderChronologicalViewHeader">
                                <xsl:with-param name="section" select="'defaultOther'" />
                            </xsl:call-template>
                            <xsl:call-template name="getChronologicalVaccinationsBySectionGrouped">
                                <xsl:with-param name="section" select="'defaultOther'" />
                            </xsl:call-template>
                        </xsl:if>
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:when>
            <xsl:otherwise>
                <xsl:call-template name="renderChronologicalViewHeader">
                    <xsl:with-param name="section" select="'empty'" />
                </xsl:call-template>
                <div class="container">
                    <div class="row">
                        <div class="col emptyView">
                            <xsl:text>Derzeit sind keine Impfungen erfasst!</xsl:text>
                        </div>
                    </div>
                </div>
            </xsl:otherwise>
        </xsl:choose>
    </div>

    <!-- manual recommendation -->
    <xsl:call-template name="renderManualRecommendedVaccinationsView" />

    <!-- vaccination indication -->
    <xsl:call-template name="renderVaccinationIndicationView" />
</xsl:template>

<xsl:template name="renderSectionHeader">
    <xsl:param name="header" />
    <xsl:param name="section" />

    <div id="{$section}SectionTitleContainer" class="container sectionHeaderContainer">
        <div class="row sectionHeaderRow">
            <h2 class="col-12 col-md-6 textLarge my-auto my-center d-print-block">
                <xsl:value-of select="$header" />
            </h2>
            <div class="d-none d-md-block col-md-6 my-auto my-center d-print-none">
                <xsl:if test="$section='general'">
                    <img id="{$section}SearchControl" data-test-id="{$section}SearchControl" class="search-icon float-right" src="data:image/png;base64,{$searchIcon}"/>
                    <div id="{$section}SearchBox" class="form-inline float-right search-box">
                        <input id="{$section}SearchInput" data-test-id="{$section}SearchInput" class="form-control form-control input-block-level search-field" type="text" placeholder="Suche nach Impfung, Impfstoff" aria-label="Suche" />
                    </div>
                </xsl:if>
            </div>
        </div>
    </div>
</xsl:template>

<xsl:template name="renderHeader">
    <xsl:param name="section" />
    <div id="{$section}TitleContainer" class="container tableHeaderContainer">
        <div class="row sectionRowHeight textNormal">
            <div class="col-5 col-md-3 tableHeaderCol" style="padding: 0 0 0 15px;">
                <div class="justify-content-between">
                    <div class="btn-group btn-block">
