<xsl:template name="header">
    <div class="container logoContainer">
        <div class="row">
            <div class="media col-sm-12 col-md-7">
                <span class="media-left">
                    <img alt="" width="60px" src="data:image/png;base64,{$logo}" />
                </span>
                <div class="media-body" style="margin-left: 1em">
                    <div class="row">
                        <div class="col-12">
                            <h1 class="textXLarge marginBottom">
                                <xsl:variable name="toolTip">
                                    <xsl:call-template name="getDocumentTitleMouseOver" />
                                </xsl:variable>
                                <strong data-toggle="tooltip" title="{$toolTip}">Elektronischer Impfpass</strong>
                            </h1>
                        </div>
                        <div class="col-12 d-none d-md-block">
                            <h4 class="textSmall">
                                <xsl:text>Erzeugt am </xsl:text>
                                <xsl:call-template name="getDocumentCreatedDateTime"/>
                                <xsl:text> | Version: </xsl:text>
                                <xsl:call-template name="getDocumentVersion"/>
                                <xsl:variable name="hasStatusCode">
                                    <xsl:call-template name="hasStatusCode" />
                                </xsl:variable>
                                <xsl:if test="$hasStatusCode='true'">
                                    <xsl:text> | Dokumentenstatus: </xsl:text>
                                    <xsl:call-template name="getStatusCode" />
                                </xsl:if>
                                <xsl:if test="$enablePrintButton='1'">
                                    <div class="printPanel d-print-none">
                                        <xsl:text> | </xsl:text>
                                        <a class="printButton" data-toggle="tooltip" data-original-title="Dokument drucken" href="#" onclick="javascript:window.print()" />
                                    </div>
                                </xsl:if>
                            </h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-5 d-none d-md-block">
                <xsl:call-template name="renderKeySets" />
            </div>
        </div>
        <div class="row toggle-row">
            <div class="col-12 text-right">
                <xsl:if test="$disableRecommendationViewToggleButton='0'">
                    <div id="recommendation-view-toggle">
                        <label for="enable-recommendation-view" class="form-check-label view-toggle-label textNormal">Empfehlungen </label>
                        <xsl:choose>
                            <xsl:when test="$enableRecommendationView='1'">
                                <input id="enable-recommendation-view" data-width="90" data-height="20" type="checkbox" data-toggle="toggle" data-on="aktiviert" data-off="deaktiviert" checked="true"></input>
                            </xsl:when>
                            <xsl:otherwise>
                                <input id="enable-recommendation-view" data-width="90" data-height="20" class="off" type="checkbox" data-toggle="toggle" data-on="aktiviert" data-off="deaktiviert"></input>
                            </xsl:otherwise>
                        </xsl:choose>
                    </div>
                </xsl:if>
            </div>
        </div>
    </div>
</xsl:template>
<xsl:template name="patientHeaderBox">
    <div id="patientBox" class="panel-group patientPanel d-block d-print-block">
        <div class="panel panel-default patientBox">
            <div class="panel-heading">
                <div class="panel-title">
                    <div class="container patientContainer">
                        <div class="row">
                            <div class="col-2 my-auto my-center">
                                <h2 class="textLarge">
                                    <xsl:call-template name="getPatientOration"/>
                                    <xsl:text>:</xsl:text>
                                </h2>
                            </div>
                            <div class="col-6 col-lg-7 my-auto my-center">
                                <h2 class="textLarge" style="text-align: center">
                                    <strong><xsl:call-template name="getPatientName"/></strong>

                                    <xsl:variable name="patientSexDefined">
                                        <xsl:call-template name="isPatientSexDefined" />
                                    </xsl:variable>

                                    <xsl:if test="$patientSexDefined='true'">
                                        <span style="text-transform: uppercase">
                                            <xsl:text> (</xsl:text>
                                            <xsl:call-template name="getPatientSexName">
                                                <xsl:with-param name="format" select="'short'" />
                                            </xsl:call-template>
                                            <xsl:text>) </xsl:text>
                                        </span>
                                    </xsl:if>

                                    <xsl:variable name="showPatientDeceasedIndicator">
                                        <xsl:call-template name="showPatientDeceasedIndicator" />
                                    </xsl:variable>

                                    <xsl:if test="$showPatientDeceasedIndicator='true'">
                                        <img alt="" class="deceasedIcon" src="data:image/png;base64,{$patientDeceasedIndicatorWhite}" />
                                    </xsl:if>
                                </h2>
                            </div>
                            <div class="col-3 col-lg-2 my-auto my-center">
                                <h2 class="textLarge" style="text-align: right">
                                    <xsl:text>geb. </xsl:text>
                                    <xsl:call-template name="getPatientDateOfBirthShort"/>
                                </h2>
                            </div>
                            <div class="col-1 my-auto my-center">
                                <button class="btn accordion-toggle collapsed accordionButton d-print-none" id="patientBoxToggle" data-toggle="collapse"  data-target="#patientCollapse" data-parent="#patientBox" aria-expanded="false"></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="patientCollapse" class="panel-collapse collapse d-print-block" data-parent="#patientBox">
            <div class="panel-body">
                <div class="container patientDetailsContainer">
                    <div class="row">
                        <div class="col-6">
                            <xsl:call-template name="renderPatientHeaderDetailLine">
                                <xsl:with-param name="left" select="'Geschlecht:'" />
                                <xsl:with-param name="leftTestId" select="'patient-sex'" />
                                <xsl:with-param name="right">
                                    <xsl:call-template name="getPatientSexName" />
                                </xsl:with-param>
                            </xsl:call-template>

                            <xsl:variable name="spouseFamilyName">
                                <xsl:call-template name="getPatientSpouseFamilyName"/>
