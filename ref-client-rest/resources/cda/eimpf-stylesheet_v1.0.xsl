                        <xsl:if test="$participantVRFName != '' or $participantVRFOrganizationName != '' or $participantVRFAddress != '' or $participantVRFTelecom != '' or $participantVRFTime != ''">
                            <xsl:call-template name="renderVaccinationDetails">
