    <xsl:template name="getVaccinationProductNameByEntryId">
        <xsl:param name="root" />
        <xsl:param name="extension" />

        <xsl:variable name="entry" select="//n1:id[(@extension=$extension and @root=$root) or ((not(@extension) or @extension = '') and (not($extension) or $extension = '') and @root=$root)]" />
        <xsl:variable name="codeNode" select="$entry/../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']/../n1:consumable/n1:manufacturedProduct/n1:manufacturedMaterial/n1:code" />

        <xsl:variable name="immunizationProduct">
            <xsl:if test="$codeNode/@code">
                <xsl:call-template name="getImmunizationProduct">
                    <xsl:with-param name="code" select="$codeNode/@code"/>
                </xsl:call-template>
            </xsl:if>
        </xsl:variable>

        <xsl:choose>
            <xsl:when test="$immunizationProduct!=''">
                <xsl:value-of select="$immunizationProduct" />
            </xsl:when>
            <xsl:otherwise>
                <!-- fallback string -->
                <xsl:if test="$codeNode/@displayName">
                    <xsl:value-of select="$codeNode/@displayName" />
                    <xsl:if test="$codeNode/@code != ''">
                        <xsl:text> </xsl:text>
                    </xsl:if>
                </xsl:if>
                <xsl:if test="$codeNode/@code != '' and $codeNode/@displayName">
                    <xsl:text>(</xsl:text>
                    <xsl:value-of select="$codeNode/@code" />
                    <xsl:text>)</xsl:text>
                </xsl:if>
                <xsl:if test="$codeNode/@code != '' and not($codeNode/@displayName)">
                    <xsl:value-of select="$codeNode/@code" />
                </xsl:if>
                <xsl:if test="($codeNode/@code = '' and $codeNode/@displayName = '') or $codeNode/@nullFlavor='NA'">
                    <xsl:text>Impfstoff nicht angegeben</xsl:text>
                </xsl:if>
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>

