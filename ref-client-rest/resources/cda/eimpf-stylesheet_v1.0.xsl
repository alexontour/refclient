<xsl:template name="renderImmunizationEntries">
    <xsl:param name="section" />

    <div id="{$section}Container">
        <!--
        Render immunization entries for the given section in this order:
        424272000       Rot: Unzureichende Immunität
        789540001       Rot: Impfung überfällig
        789539003       Gelb: Impftermin anstehend
        171279008       Gelb: Impfung fällig
        122541000119104 Grau: Impfung Notwendig
        723620004       Blau: Erfordert Impfung
        171288004       Blau: Keine Aufzeichnungen über Impfungen
        161413004       Grün: Durchgemachte Infektionskrankheit
        171258008       Grün: Impfschutz auf dem neuesten Stand
        191441008       Grün: Immunität erworben
        713404003       Grün: Impfung verabreicht
        -->
        <xsl:call-template name="renderRecommendedEntriesByImmunizationDue">
            <xsl:with-param name="section" select="$section" />
            <xsl:with-param name="code" select="'424272000'" />
        </xsl:call-template>
        <xsl:call-template name="renderRecommendedEntriesByImmunizationDue">
            <xsl:with-param name="section" select="$section" />
            <xsl:with-param name="code" select="'789540001'" />
        </xsl:call-template>
        <xsl:call-template name="renderRecommendedEntriesByImmunizationDue">
            <xsl:with-param name="section" select="$section" />
            <xsl:with-param name="code" select="'789539003'" />
        </xsl:call-template>
        <xsl:call-template name="renderRecommendedEntriesByImmunizationDue">
            <xsl:with-param name="section" select="$section" />
            <xsl:with-param name="code" select="'171279008'" />
        </xsl:call-template>
        <xsl:call-template name="renderRecommendedEntriesByImmunizationDue">
            <xsl:with-param name="section" select="$section" />
            <xsl:with-param name="code" select="'122541000119104'" />
        </xsl:call-template>
        <xsl:call-template name="renderRecommendedEntriesByImmunizationDue">
            <xsl:with-param name="section" select="$section" />
            <xsl:with-param name="code" select="'723620004'" />
        </xsl:call-template>
        <xsl:call-template name="renderRecommendedEntriesByImmunizationDue">
            <xsl:with-param name="section" select="$section" />
            <xsl:with-param name="code" select="'171288004'" />
        </xsl:call-template>

        <xsl:choose>
            <xsl:when test="$section='recommendationGeneral'">
                <xsl:call-template name="renderELGAImmunizationTargetEmpfohleneImpfungen" />
            </xsl:when>
            <xsl:when test="$section='recommendationTravel'">
                <xsl:call-template name="renderELGAImmunizationTargetReiseimpfungen" />
            </xsl:when>
            <xsl:otherwise>
                <xsl:call-template name="renderELGAImmunizationTargetAndereImpfungen" />
            </xsl:otherwise>
        </xsl:choose>

        <xsl:call-template name="renderRecommendedEntriesByImmunizationDue">
            <xsl:with-param name="section" select="$section" />
            <xsl:with-param name="code" select="'161413004'" />
        </xsl:call-template>
        <xsl:call-template name="renderRecommendedEntriesByImmunizationDue">
            <xsl:with-param name="section" select="$section" />
            <xsl:with-param name="code" select="'171258008'" />
        </xsl:call-template>
        <xsl:call-template name="renderRecommendedEntriesByImmunizationDue">
            <xsl:with-param name="section" select="$section" />
            <xsl:with-param name="code" select="'191441008'" />
        </xsl:call-template>
        <xsl:call-template name="renderRecommendedEntriesByImmunizationDue">
            <xsl:with-param name="section" select="$section" />
            <xsl:with-param name="code" select="'713404003'" />
        </xsl:call-template>
    </div>
</xsl:template>

<xsl:template name="renderRecommendedEntriesByImmunizationDue">
    <xsl:param name="section" />
    <xsl:param name="code" />

    <xsl:for-each select="//n1:substanceAdministration[@negationInd='false' and n1:templateId[@root='1.2.40.0.34.6.0.11.3.3'] and n1:code[@code=$code]]">
        <xsl:sort select="./n1:effectiveTime/n1:low/@value" />
        <xsl:sort select="./n1:effectiveTime[n1:low[@nullFlavor='UNK']]/n1:high/@value" />
        <xsl:sort select="./n1:entryRelationship/n1:observation/n1:code/@code" /> <!-- make sort stable -->

        <xsl:variable name="vaccinationCode" select="./n1:entryRelationship/n1:observation/n1:code/@code" />

        <xsl:variable name="correctSection">
            <xsl:call-template name="isInCorrectSection">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                <xsl:with-param name="currentSection" select="$section" />
            </xsl:call-template>
        </xsl:variable>

        <xsl:if test="$correctSection='true'">
            <xsl:call-template name="renderVaccinationSectionEntry">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                <xsl:with-param name="alwaysShowCauseCodedInRecommendationSection" select="string(true())" />
                <xsl:with-param name="section" select="$section" />
            </xsl:call-template>
        </xsl:if>
    </xsl:for-each>
</xsl:template>

<xsl:template name="renderVaccinationSectionEntry">
    <xsl:param name="vaccinationCode" />
    <xsl:param name="alwaysShowCauseCodedInRecommendationSection" select="string(false())" />
    <xsl:param name="section" />

    <xsl:variable name="isGruppenImpfungParent">
        <xsl:call-template name="isGruppenImmunization">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
        </xsl:call-template>
    </xsl:variable>

    <xsl:variable name="isCodedInRecommendationSection">
        <xsl:call-template name="isCodedInRecommendationSection">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
        </xsl:call-template>
    </xsl:variable>

    <xsl:variable name="isInCorrectSection">
        <xsl:call-template name="isInCorrectSection">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
            <xsl:with-param name="currentSection" select="$section" />
        </xsl:call-template>
    </xsl:variable>

    <xsl:variable name="fromImpfplanValueSet">
        <xsl:choose>
            <xsl:when test="$alwaysShowCauseCodedInRecommendationSection='false' and $isCodedInRecommendationSection='false'">
                <xsl:value-of select="string(true())" />
            </xsl:when>
            <xsl:otherwise>
                <xsl:value-of select="string(false())" />
            </xsl:otherwise>
        </xsl:choose>
    </xsl:variable>

    <xsl:if test="$isInCorrectSection = 'true' and $isGruppenImpfungParent = 'false' and ($alwaysShowCauseCodedInRecommendationSection='true' or $fromImpfplanValueSet='true')" >

        <xsl:variable name="actionCode">
            <xsl:call-template name="getActionCode">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
            </xsl:call-template>
        </xsl:variable>

        <xsl:variable name="dropDownTitle">
            <xsl:call-template name="getImmunizationTargetName">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
            </xsl:call-template>
        </xsl:variable>

        <xsl:variable name="searchName">
            <xsl:call-template name="getSearchStringByVaccinationCode">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
            </xsl:call-template>
        </xsl:variable>

        <xsl:variable name="searchProduct">
            <xsl:call-template name="getNextImmunizationProductName">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
            </xsl:call-template>
            <xsl:text>;</xsl:text>

            <xsl:for-each select="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']/../n1:code[@code=$vaccinationCode]/../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">

                <xsl:variable name="currentEntryIdRoot" select="../n1:id/@root" />
                <xsl:variable name="currentEntryIdExtension" select="../n1:id/@extension" />

                <xsl:call-template name="getVaccinationProductNameByEntryId">
                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                </xsl:call-template>
                <xsl:text>;</xsl:text>
            </xsl:for-each>
        </xsl:variable>

        <xsl:variable name="lastEventType">
            <xsl:call-template name="getLastEventWithTime">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
            </xsl:call-template>
        </xsl:variable>

        <xsl:variable name="nextVaccinationRange">
            <xsl:call-template name="getNextVaccinationRange">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
            </xsl:call-template>
        </xsl:variable>

        <div id="row-{$vaccinationCode}" class="panel-group headerRow {$section}Row"
             data-dropdown-title="{$dropDownTitle}" data-filter-target="{$vaccinationCode}" data-search-immunization-name="{$searchName}" data-search-immunization-product="{$searchProduct}">
            <div class="panel panel-default textNormal">
                <div class="panel-heading">
                    <div class="panel-title">
                        <div class="container vaccinationRowContainer">
                            <div class="row">
                                <div class="col-5 col-md-3 media text-break">
                                    <h3 class="media-body my-auto my-center textVaccinationTitle text-break" data-test-id="row-{$vaccinationCode}-col-1">
                                        <xsl:call-template name="getImmunizationTargetName">
                                            <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                        </xsl:call-template>
                                    </h3>
                                    <span class="d-none d-md-block media-right my-auto my-center">
                                        <xsl:variable name="url">
                                            <xsl:call-template name="getInfoButtonLink">
                                                <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                            </xsl:call-template>
                                        </xsl:variable>
                                        <a class="btn infoButton" target="_blank" href="{$url}" />
                                    </span>
                                </div>
                                <div class="col-2 col-md-1 my-auto my-center text-break" style="text-align: center">
                                    <xsl:call-template name="renderActionCodeIcon">
                                        <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                    </xsl:call-template>
                                </div>
                                <div class="col-4 col-md-2 my-auto my-center text-break" data-test-id="row-{$vaccinationCode}-col-3">
                                    <xsl:value-of select="$nextVaccinationRange" />
                                </div>
                                <div class="d-none d-md-block col-md-3 my-auto my-center text-break">
                                    <xsl:choose>
                                        <xsl:when test="$actionCode!=''">
                                            <xsl:call-template name="getImmunizationActionTranslated">
                                                <xsl:with-param name="actionCode" select="$actionCode" />
                                            </xsl:call-template>

                                            <xsl:variable name="comment">
                                                <xsl:call-template name="getRecommendedVaccinationCommentByVaccinationCode">
                                                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                                </xsl:call-template>
                                            </xsl:variable>

                                            <xsl:if test="$comment != ''">
                                                <xsl:variable name="hasCommentAuthor">
                                                    <xsl:call-template name="hasRecommendedVaccinationCommentAuthor">
                                                        <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                                    </xsl:call-template>
                                                </xsl:variable>
                                                <p class="comment">
                                                    <span style="font-weight: bold;">
                                                        <xsl:choose>
                                                            <xsl:when test="$hasCommentAuthor = 'true'">
                                                                <xsl:text>Kommentar [</xsl:text>
                                                                <xsl:call-template name="getRecommendedVaccinationCommentAuthorByVaccinationCode">
                                                                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                                                </xsl:call-template>
                                                                <xsl:text>]: </xsl:text>
                                                            </xsl:when>
                                                            <xsl:otherwise>
                                                                <xsl:text>Kommentar: </xsl:text>
                                                            </xsl:otherwise>
                                                        </xsl:choose>
                                                    </span>
                                                    <xsl:value-of select="$comment" />
                                                </p>
                                            </xsl:if>
                                        </xsl:when>
                                        <xsl:otherwise>
                                            <!-- Show default text when no actionCode is available -->
                                            <xsl:call-template name="getImmunizationActionTranslated">
                                                <xsl:with-param name="actionCode" select="'171288004'" />
                                            </xsl:call-template>
                                        </xsl:otherwise>
                                    </xsl:choose>
                                </div>
                                <div class="col-1 col-md-3 my-auto my-center media text-break">
                                    <span class="d-none d-md-block media-body">
                                        <xsl:value-of select="$lastEventType" />
                                    </span>
                                    <xsl:if test="$nextVaccinationRange != '' or $lastEventType != ''">
                                        <button type="button" class="d-none d-md-block d-print-none media-right btn accordion-toggle collapsed accordionButton my-auto" id="row-{$vaccinationCode}-toggle"
                                                data-test-id="row-{$vaccinationCode}-toggle" data-toggle="collapse"  data-target="#row-{$vaccinationCode}-body" data-parent="#row-{$vaccinationCode}" aria-expanded="false" />
                                        <button type="button" class="d-md-none d-print-none media-right btn my-auto my-center modalVaccinationButton" data-toggle="modal" data-target="#modalVaccinationsInformation-{$vaccinationCode}" />
                                    </xsl:if>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <xsl:call-template name="renderVaccinationDetailContainer">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                <xsl:with-param name="divId" select="concat('row-', $vaccinationCode, '-body')" />
                <xsl:with-param name="parentDivId" select="concat('row-', $vaccinationCode)" />
            </xsl:call-template>

            <xsl:call-template name="renderModalVaccinations">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
            </xsl:call-template>

        </div>
    </xsl:if>
</xsl:template>

<!-- custom group and sort for xslt 1.0 -->
<xsl:template name="getChronologicalVaccinationsBySectionGrouped">
    <xsl:param name="section" />

    <div id="{$section}Container">
        <!-- entries with known date -->
        <xsl:for-each select="//n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16' or @root='1.2.40.0.34.6.0.11.3.1']]/@value |
                    //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9']]/n1:low/@value |
                    //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9'] and n1:low[@nullFlavor='UNK']]/n1:high/@value">
            <xsl:sort select="." order="descending" />
            <xsl:sort select="./../../n1:id/@root" />
            <xsl:sort select="./../../n1:id/@extension" />
            <xsl:sort select="./../../../n1:id/@root" />
            <xsl:sort select="./../../../n1:id/@extension" />

            <xsl:variable name="entryIdRoot">
                <xsl:choose>
                    <xsl:when test="./../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">
                        <xsl:value-of select="./../../n1:id/@root" />
                    </xsl:when>
                    <xsl:when test="./../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']">
                        <xsl:value-of select="./../../n1:id/@root" />
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:value-of select="./../../../n1:id/@root" />
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:variable>

            <xsl:variable name="entryIdExtension">
                <xsl:choose>
                    <xsl:when test="./../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">
                        <xsl:value-of select="./../../n1:id/@extension" />
                    </xsl:when>
                    <xsl:when test="./../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']">
                        <xsl:value-of select="./../../n1:id/@extension" />
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:value-of select="./../../../n1:id/@extension" />
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:variable>

            <xsl:variable name="vaccinationCode">
                <xsl:choose>
                    <xsl:when test="./../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">
                        <xsl:value-of select="./../../n1:entryRelationship/n1:observation[n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']]/n1:code/@code" />
                    </xsl:when>
                    <xsl:when test="./../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']">
                        <xsl:value-of select="./../../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.18']/../n1:code/@code" />
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:call-template name="getImmunizationDiseaseMapping">
                            <xsl:with-param name="code" select="./../../../n1:value/@code" />
                        </xsl:call-template>
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:variable>

            <xsl:variable name="idMaxTimeRoot">
                <xsl:call-template name="getLastEntryIdRootFromVaccinationCode">
                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="idMaxTimeExtension">
                <xsl:call-template name="getLastEntryIdExtensionFromVaccinationCode">
                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="position" select="position()" />

            <xsl:if test="$entryIdRoot = $idMaxTimeRoot and $entryIdExtension = $idMaxTimeExtension">
                <xsl:variable name="isGroupVaccinationParent">
                    <xsl:call-template name="isGruppenImmunization">
                        <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                    </xsl:call-template>
                </xsl:variable>

                <xsl:choose>
                    <xsl:when test="$isGroupVaccinationParent='true'">
                        <xsl:for-each select="//n1:templateId
                                [
                                    @root='1.2.40.0.34.6.0.11.3.1']/../n1:id[((not(@extension) or @extension = '') and
                                    (not($entryIdExtension) or $entryIdExtension = '') and @root=$entryIdRoot) or (@extension=$entryIdExtension and @root=$entryIdRoot)
                                ]
                                /../n1:entryRelationship/n1:observation/n1:code[@code=$vaccinationCode]/../../../n1:entryRelationship/n1:observation">

                            <xsl:variable name="currentVaccinationCode">
                                <xsl:value-of select="./n1:code/@code" />
                            </xsl:variable>

                            <xsl:variable name="idLatestVaccinationRoot">
                                <!-- double-check the latest id, because the vaccination can also be applied as a single vaccination -->
                                <xsl:call-template name="getLastEntryIdRootFromVaccinationCode">
                                    <xsl:with-param name="vaccinationCode" select="$currentVaccinationCode" />
                                </xsl:call-template>
                            </xsl:variable>

                            <xsl:variable name="idLatestVaccinationExtension">
                                <!-- double-check the latest id, because the vaccination can also be applied as a single vaccination -->
                                <xsl:call-template name="getLastEntryIdExtensionFromVaccinationCode">
                                    <xsl:with-param name="vaccinationCode" select="$currentVaccinationCode" />
                                </xsl:call-template>
                            </xsl:variable>

                            <xsl:if test="$idLatestVaccinationRoot=$entryIdRoot and $idLatestVaccinationExtension=$entryIdExtension">
                                <xsl:call-template name="checkChronologicalVaccinationInCorrectSection">
                                    <xsl:with-param name="section" select="$section" />
                                    <xsl:with-param name="entryIdRoot" select="$entryIdRoot" />
                                    <xsl:with-param name="entryIdExtension" select="$entryIdExtension" />
                                    <xsl:with-param name="vaccinationCode" select="$currentVaccinationCode" />
                                    <xsl:with-param name="position" select="$position" />
                                </xsl:call-template>
                            </xsl:if>
                        </xsl:for-each>
                    </xsl:when>
                    <xsl:otherwise>

                        <xsl:variable name="idLatestVaccinationRoot">
                            <!-- double-check the latest id, because the vaccination can also be applied as a single vaccination -->
                            <xsl:call-template name="getLastEntryIdRootFromVaccinationCode">
                                <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                            </xsl:call-template>
                        </xsl:variable>

                        <xsl:variable name="idLatestVaccinationExtension">
                            <!-- double-check the latest id, because the vaccination can also be applied as a single vaccination -->
                            <xsl:call-template name="getLastEntryIdExtensionFromVaccinationCode">
                                <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                            </xsl:call-template>
                        </xsl:variable>

                        <xsl:if test="$idLatestVaccinationRoot=$entryIdRoot and $idLatestVaccinationExtension=$entryIdExtension">
                            <xsl:call-template name="checkChronologicalVaccinationInCorrectSection">
                                <xsl:with-param name="section" select="$section" />
                                <xsl:with-param name="entryIdRoot" select="$entryIdRoot" />
                                <xsl:with-param name="entryIdExtension" select="$entryIdExtension" />
                                <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                                <xsl:with-param name="position" select="$position" />
                                <xsl:with-param name="knownDate" select="string(true())" />
                            </xsl:call-template>
                        </xsl:if>
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:if>
        </xsl:for-each>

        <!-- entries with unknown date -->
        <xsl:for-each select="//n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16' or @root='1.2.40.0.34.6.0.11.3.1'] and @nullFlavor='UNK'] |
                //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9'] and n1:low/@nullFlavor='UNK' and (n1:high/@nullFlavor='UNK' or not(n1:high))]">
            <xsl:sort select="./../n1:id/@root" />
            <xsl:sort select="./../n1:id/@extension" />

            <xsl:variable name="entryIdRoot" select="./../n1:id/@root" />
            <xsl:variable name="entryIdExtension" select="./../n1:id/@extension" />

            <xsl:variable name="vaccinationCode">
                <xsl:choose>
                    <xsl:when test="./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">
                        <xsl:value-of select="./../n1:entryRelationship/n1:observation[n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']]/n1:code/@code" />
                    </xsl:when>
                    <xsl:when test="./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']">
                        <xsl:value-of select="./../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.18']/../n1:code/@code" />
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:call-template name="getImmunizationDiseaseMapping">
                            <xsl:with-param name="code" select="./../n1:value/@code" />
                        </xsl:call-template>
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:variable>

            <xsl:variable name="vaccinationCodeReverseMapping">
                <xsl:choose>
                    <xsl:when test="./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1'] or ./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']">
                        <xsl:call-template name="getImmunizationDiseaseMappingReverse">
                            <xsl:with-param name="code" select="$vaccinationCode" />
                        </xsl:call-template>
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:value-of select="./../n1:value/@code" />
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:variable>

            <xsl:variable name="entryCntWithDate" select="count(
                    //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1'] and ../n1:entryRelationship/n1:observation/n1:code[@code=$vaccinationCode]]/@value |
                    //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16'] and ../../../n1:code[@code=$vaccinationCode]]/@value |
                    //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9'] and ../n1:value[@code=$vaccinationCodeReverseMapping]]/n1:low/@value |
                    //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9'] and ../n1:value[@code=$vaccinationCodeReverseMapping] and n1:low[@nullFlavor='UNK']]/n1:high/@value)" />

            <!-- show entry only if it appears always without a date, otherwise entry with unknown date is part of the vaccination history -->
            <xsl:if test="$entryCntWithDate = 0">
                <xsl:variable name="idOfUnknown">
                    <xsl:choose>
                        <xsl:when test="./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">
                            <xsl:value-of select="generate-id(./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1'])" />
                        </xsl:when>
                        <xsl:when test="./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']">
                            <xsl:value-of select="generate-id(./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16'])" />
                        </xsl:when>
                        <xsl:otherwise>
                            <xsl:value-of select="generate-id(./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9'])" />
                        </xsl:otherwise>
                    </xsl:choose>
                </xsl:variable>

                <xsl:variable name="idOfFirst">
                    <xsl:for-each select="//n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1'] and ../n1:entryRelationship/n1:observation/n1:code[@code=$vaccinationCode] and @nullFlavor='UNK'] |
                            //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16'] and ../../../n1:code[@code=$vaccinationCode] and @nullFlavor='UNK'] |
                            //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9'] and ../n1:value[@code=$vaccinationCodeReverseMapping] and n1:low/@nullFlavor='UNK' and (n1:high/@nullFlavor='UNK' or not(n1:high))]">
                        <xsl:if test="position() = 1">
                            <xsl:choose>
                                <xsl:when test="./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">
                                    <xsl:value-of select="generate-id(./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1'])" />
                                </xsl:when>
                                <xsl:when test="./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']">
                                    <xsl:value-of select="generate-id(./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16'])" />
                                </xsl:when>
                                <xsl:otherwise>
                                    <xsl:value-of select="generate-id(./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9'])" />
                                </xsl:otherwise>
                            </xsl:choose>
                        </xsl:if>
                    </xsl:for-each>
                </xsl:variable>

                <xsl:variable name="position" select="position()" />

                <!-- if entry exists only of unknown dates, show only the first one (the rest will be displayed in the history section) -->
                <xsl:if test="$idOfUnknown = $idOfFirst">

                    <xsl:variable name="isGroupVaccinationParent">
                        <xsl:call-template name="isGruppenImmunization">
                            <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:choose>
                        <xsl:when test="$isGroupVaccinationParent='true'">
                            <xsl:for-each select="//n1:templateId
                                [
                                    @root='1.2.40.0.34.6.0.11.3.1']/../n1:id[((not(@extension) or @extension='') and
                                    (not($entryIdExtension) or $entryIdExtension = '') and @root=$entryIdRoot) or (@extension=$entryIdExtension and @root=$entryIdRoot)
                                ]/../n1:entryRelationship/n1:observation/n1:code[@code=$vaccinationCode]/../../../n1:entryRelationship/n1:observation">

                                <xsl:variable name="currentVaccinationCode">
                                    <xsl:value-of select="./n1:code/@code" />
                                </xsl:variable>

                                <xsl:call-template name="checkChronologicalVaccinationInCorrectSection">
                                    <xsl:with-param name="section" select="$section" />
                                    <xsl:with-param name="entryIdRoot" select="$entryIdRoot" />
                                    <xsl:with-param name="entryIdExtension" select="$entryIdExtension" />
                                    <xsl:with-param name="vaccinationCode" select="$currentVaccinationCode" />
                                    <xsl:with-param name="position" select="$position" />
                                    <xsl:with-param name="knownDate" select="string(false())" />
                                </xsl:call-template>
                            </xsl:for-each>
                        </xsl:when>
                        <xsl:otherwise>
                            <xsl:call-template name="checkChronologicalVaccinationInCorrectSection">
                                <xsl:with-param name="section" select="$section" />
                                <xsl:with-param name="entryIdRoot" select="$entryIdRoot" />
                                <xsl:with-param name="entryIdExtension" select="$entryIdExtension" />
                                <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                                <xsl:with-param name="position" select="$position" />
                            </xsl:call-template>
                        </xsl:otherwise>
                    </xsl:choose>
                </xsl:if>
            </xsl:if>
        </xsl:for-each>
    </div>
</xsl:template>

<xsl:template name="renderChronologicalViewWithoutVaccinationGrouping">
    <div>
        <!-- render elements with known date -->
        <xsl:for-each select="//n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16' or @root='1.2.40.0.34.6.0.11.3.1']]/@value |
                //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9']]/n1:low/@value |
                //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9'] and n1:low[@nullFlavor='UNK']]/n1:high/@value">
            <xsl:sort select="." order="descending" />
            <xsl:sort select="./../../n1:id/@root" />
            <xsl:sort select="./../../n1:id/@extension" />
            <xsl:sort select="./../../../n1:id/@root" />
            <xsl:sort select="./../../../n1:id/@extension" />

            <xsl:variable name="entryIdRoot">
                <xsl:choose>
                    <xsl:when test="./../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">
                        <xsl:value-of select="./../../n1:id/@root" />
                    </xsl:when>
                    <xsl:when test="./../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']">
                        <xsl:value-of select="./../../n1:id/@root" />
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:value-of select="./../../../n1:id/@root" />
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:variable>

            <xsl:variable name="entryIdExtension">
                <xsl:choose>
                    <xsl:when test="./../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">
                        <xsl:value-of select="./../../n1:id/@extension" />
                    </xsl:when>
                    <xsl:when test="./../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']">
                        <xsl:value-of select="./../../n1:id/@extension" />
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:value-of select="./../../../n1:id/@extension" />
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:variable>

            <xsl:variable name="vaccinationCode">
                <xsl:choose>
                    <xsl:when test="./../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">
                        <xsl:value-of select="./../../n1:entryRelationship/n1:observation[n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']]/n1:code/@code" />
                    </xsl:when>
                    <xsl:when test="./../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']">
                        <xsl:value-of select="./../../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.18']/../n1:code/@code" />
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:call-template name="getImmunizationDiseaseMapping">
                            <xsl:with-param name="code" select="./../../../n1:value/@code" />
                        </xsl:call-template>
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:variable>

            <xsl:variable name="isGroupVaccinationParent">
                <xsl:call-template name="isGruppenImmunization">
                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="position" select="position()" />

            <xsl:choose>
                <xsl:when test="$isGroupVaccinationParent='true'">
                    <xsl:for-each select="//n1:templateId
                            [
                                @root='1.2.40.0.34.6.0.11.3.1']/../n1:id[((not(@extension) or @extension = '') and
                                (not($entryIdExtension) or $entryIdExtension = '') and @root=$entryIdRoot) or (@extension=$entryIdExtension and @root=$entryIdRoot)
                            ]/../n1:entryRelationship/n1:observation/n1:code[@code=$vaccinationCode]/../../../n1:entryRelationship/n1:observation">
                        <xsl:variable name="currentVaccinationCode">
                            <xsl:value-of select="./n1:code/@code" />
                        </xsl:variable>
                        <!-- do not show vaccination group parent -->
                        <xsl:if test="$currentVaccinationCode != $vaccinationCode">
                            <xsl:call-template name="renderChronologicalViewContainer">
                                <xsl:with-param name="section" select="'defaultGeneral'" />
                                <xsl:with-param name="entryIdRoot" select="$entryIdRoot" />
                                <xsl:with-param name="entryIdExtension" select="$entryIdExtension" />
                                <xsl:with-param name="vaccinationCode" select="$currentVaccinationCode" />
                                <xsl:with-param name="position" select="$position" />
                                <xsl:with-param name="knownDate" select="string(true())" />
                            </xsl:call-template>
                        </xsl:if>
                    </xsl:for-each>
                </xsl:when>
                <xsl:otherwise>
                    <xsl:call-template name="renderChronologicalViewContainer">
                        <xsl:with-param name="section" select="'defaultGeneral'" />
                        <xsl:with-param name="entryIdRoot" select="$entryIdRoot" />
                        <xsl:with-param name="entryIdExtension" select="$entryIdExtension" />
                        <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                        <xsl:with-param name="position" select="$position" />
                        <xsl:with-param name="knownDate" select="string(true())" />
                    </xsl:call-template>
                </xsl:otherwise>
            </xsl:choose>
        </xsl:for-each>

        <!-- render elements with unknown date -->
        <xsl:for-each select="//n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16' or @root='1.2.40.0.34.6.0.11.3.1'] and @nullFlavor='UNK'] |
                //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9'] and n1:low/@nullFlavor='UNK' and (n1:high/@nullFlavor='UNK' or not(n1:high))]">
            <xsl:sort select="./../n1:id/@root" />
            <xsl:sort select="./../n1:id/@extension" />

            <xsl:variable name="entryIdRoot" select="./../n1:id/@root" />
            <xsl:variable name="entryIdExtension" select="./../n1:id/@extension" />

            <xsl:variable name="vaccinationCode">
                <xsl:choose>
                    <xsl:when test="./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">
                        <xsl:value-of select="./../n1:entryRelationship/n1:observation[n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']]/n1:code/@code" />
                    </xsl:when>
                    <xsl:when test="./../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16']">
                        <xsl:value-of select="./../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.18']/../n1:code/@code" />
                    </xsl:when>
                    <xsl:otherwise>
                        <xsl:call-template name="getImmunizationDiseaseMapping">
                            <xsl:with-param name="code" select="./../n1:value/@code" />
                        </xsl:call-template>
                    </xsl:otherwise>
                </xsl:choose>
            </xsl:variable>

            <xsl:variable name="isGroupVaccinationParent">
                <xsl:call-template name="isGruppenImmunization">
                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="position" select="position()" />

            <xsl:choose>
                <xsl:when test="$isGroupVaccinationParent='true'">
                    <xsl:for-each select="//n1:templateId
                            [
                                @root='1.2.40.0.34.6.0.11.3.1']/../n1:id[((not(@extension) or @extension='') and
                                (not($entryIdExtension) or $entryIdExtension = '') and @root=$entryIdRoot) or (@extension=$entryIdExtension and @root=$entryIdRoot)
                            ]/../n1:entryRelationship/n1:observation/n1:code[@code=$vaccinationCode]/../../../n1:entryRelationship/n1:observation">
                        <xsl:variable name="currentVaccinationCode" select="./n1:code/@code" />

                        <!-- do not show vaccination group parent -->
                        <xsl:if test="$currentVaccinationCode != $vaccinationCode">
                            <xsl:call-template name="renderChronologicalViewContainer">
                                <xsl:with-param name="section" select="'defaultGeneral'" />
                                <xsl:with-param name="entryIdRoot" select="$entryIdRoot" />
                                <xsl:with-param name="entryIdExtension" select="$entryIdExtension" />
                                <xsl:with-param name="vaccinationCode" select="$currentVaccinationCode" />
                                <xsl:with-param name="position" select="$position" />
                                <xsl:with-param name="knownDate" select="string(false())" />
                            </xsl:call-template>
                        </xsl:if>
                    </xsl:for-each>
                </xsl:when>
                <xsl:otherwise>
                    <xsl:call-template name="renderChronologicalViewContainer">
                        <xsl:with-param name="section" select="'defaultGeneral'" />
                        <xsl:with-param name="entryIdRoot" select="$entryIdRoot" />
                        <xsl:with-param name="entryIdExtension" select="$entryIdExtension" />
                        <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                        <xsl:with-param name="position" select="$position" />
                        <xsl:with-param name="knownDate" select="string(false())" />
                    </xsl:call-template>
                </xsl:otherwise>
            </xsl:choose>
        </xsl:for-each>
    </div>
</xsl:template>

<xsl:template name="checkChronologicalVaccinationInCorrectSection">
    <xsl:param name="section" />
    <xsl:param name="entryIdRoot" />
    <xsl:param name="entryIdExtension" />
    <xsl:param name="vaccinationCode" />
    <xsl:param name="position" />
    <xsl:param name="knownDate" />

    <xsl:variable name="isGruppenImpfungParent">
        <xsl:call-template name="isGruppenImmunization">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
        </xsl:call-template>
    </xsl:variable>

    <xsl:variable name="isInCorrectSection">
        <xsl:call-template name="isInCorrectSection">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
            <xsl:with-param name="currentSection" select="$section" />
        </xsl:call-template>
    </xsl:variable>

    <xsl:if test="$isInCorrectSection='true' and $isGruppenImpfungParent='false'">
        <xsl:call-template name="renderChronologicalViewContainer">
            <xsl:with-param name="section" select="$section" />
            <xsl:with-param name="entryIdRoot" select="$entryIdRoot" />
            <xsl:with-param name="entryIdExtension" select="$entryIdExtension" />
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
            <xsl:with-param name="position" select="$position" />
            <xsl:with-param name="knownDate" select="$knownDate" />
        </xsl:call-template>
    </xsl:if>
</xsl:template>

<xsl:template name="renderChronologicalViewContainer">
    <xsl:param name="section" />
    <xsl:param name="entryIdRoot" />
    <xsl:param name="entryIdExtension" />
    <xsl:param name="vaccinationCode" />
    <xsl:param name="position" />
    <xsl:param name="knownDate" select="string(true())" />

    <xsl:variable name="dropDownTitle">
        <xsl:call-template name="getImmunizationTargetName">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
        </xsl:call-template>
    </xsl:variable>

    <xsl:variable name="searchName">
        <xsl:call-template name="getSearchStringByVaccinationCode">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
        </xsl:call-template>
    </xsl:variable>

    <xsl:variable name="searchProduct">
        <xsl:call-template name="getNextImmunizationProductName">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
        </xsl:call-template>
        <xsl:text>;</xsl:text>

        <xsl:for-each select="//n1:templateId[@root='1.2.40.0.34.6.0.11.3.2']/../n1:code[@code=$vaccinationCode]/../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">

            <xsl:variable name="currentEntryIdRoot" select="../n1:id/@root" />
            <xsl:variable name="currentEntryIdExtension" select="../n1:id/@extension" />

            <xsl:call-template name="getVaccinationProductNameByEntryId">
                <xsl:with-param name="root" select="$currentEntryIdRoot" />
                <xsl:with-param name="extension" select="$currentEntryIdExtension" />
            </xsl:call-template>
            <xsl:text>;</xsl:text>
        </xsl:for-each>
    </xsl:variable>

    <xsl:variable name="entryIsVaccination">
        <xsl:call-template name="isVaccination">
            <xsl:with-param name="root" select="$entryIdRoot" />
            <xsl:with-param name="extension" select="$entryIdExtension" />
        </xsl:call-template>
    </xsl:variable>

    <xsl:variable name="entryIsAntiBody">
        <xsl:call-template name="isAntiBody">
            <xsl:with-param name="root" select="$entryIdRoot" />
            <xsl:with-param name="extension" select="$entryIdExtension" />
        </xsl:call-template>
    </xsl:variable>

    <xsl:variable name="antiBodyAborted">
        <xsl:call-template name="isAntiBodyStatusAborted">
            <xsl:with-param name="root" select="$entryIdRoot" />
            <xsl:with-param name="extension" select="$entryIdExtension" />
        </xsl:call-template>
    </xsl:variable>

    <xsl:variable name="rowId">
        <xsl:choose>
            <xsl:when test="$knownDate='true'">
                <xsl:value-of select="concat('row-', $vaccinationCode, '-', $position)" />
            </xsl:when>
            <xsl:otherwise>
                <xsl:value-of select="concat('row-unkdate-', $vaccinationCode, '-', $position)" />
            </xsl:otherwise>
        </xsl:choose>
    </xsl:variable>

    <div id="{$rowId}" class="panel-group headerRow {$section}Row"
         data-dropdown-title="{$dropDownTitle}" data-filter-target="{$vaccinationCode}" data-search-immunization-name="{$searchName}" data-search-immunization-product="{$searchProduct}" data-test-id="{$rowId}">
        <div class="panel panel-default textNormal">
            <div class="panel-heading">
                <div class="panel-title">
                    <div class="container vaccinationRowContainer">
                        <div class="row">
                            <div class="col-2 col-23p-vaccination media">
                                <h3 class="media-body my-auto my-center textVaccinationTitle text-break" data-test-id="row-{$vaccinationCode}-col-1">
                                    <xsl:call-template name="getImmunizationTargetName">
                                        <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                    </xsl:call-template>
                                </h3>
                                <span class="d-none d-md-block media-right my-auto my-center">
                                    <xsl:variable name="url">
                                        <xsl:call-template name="getInfoButtonLink">
                                            <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                        </xsl:call-template>
                                    </xsl:variable>
                                    <a class="btn infoButton" target="_blank" href="{$url}" />
                                </span>
                            </div>
                            <div class="col-1 col-10p-vaccination my-auto my-center text-break" data-test-id="row-{$vaccinationCode}-col-2">
                                <xsl:choose>
                                    <xsl:when test="$entryIsVaccination='true'">
                                        <xsl:call-template name="getVaccinationDateByEntryId">
                                            <xsl:with-param name="root" select="$entryIdRoot" />
                                            <xsl:with-param name="extension" select="$entryIdExtension" />
                                        </xsl:call-template>
                                    </xsl:when>
                                    <xsl:when test="$entryIsAntiBody='true'">
                                        <xsl:call-template name="getAntiBodyDateByEntryId">
                                            <xsl:with-param name="root" select="$entryIdRoot" />
                                            <xsl:with-param name="extension" select="$entryIdExtension" />
                                        </xsl:call-template>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <!-- disease -->
                                       <xsl:call-template name="getDiseaseDateByEntryId">
                                            <xsl:with-param name="root" select="$entryIdRoot" />
                                            <xsl:with-param name="extension" select="$entryIdExtension" />
                                        </xsl:call-template>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </div>
                            <div class="col-2 col-17p-vaccination my-auto my-center text-break">
                                <xsl:choose>
                                    <xsl:when test="$entryIsVaccination='true'">
                                        <xsl:text>Impfstoff: </xsl:text>
                                        <xsl:call-template name="getVaccinationProductNameByEntryId">
                                            <xsl:with-param name="root" select="$entryIdRoot" />
                                            <xsl:with-param name="extension" select="$entryIdExtension" />
                                        </xsl:call-template>
                                    </xsl:when>
                                    <xsl:when test="$entryIsAntiBody='true'">
                                        <xsl:choose>
                                            <xsl:when test="$antiBodyAborted='false'">
                                                <xsl:call-template name="getAntiBodySummaryByEntryId">
                                                    <xsl:with-param name="root" select="$entryIdRoot" />
                                                    <xsl:with-param name="extension" select="$entryIdExtension" />
                                                </xsl:call-template>

                                                <xsl:variable name="hasAntiBodyInterpretation">
                                                    <xsl:call-template name="hasAntiBodyInterpretationByEntryId">
                                                        <xsl:with-param name="root" select="$entryIdRoot" />
                                                        <xsl:with-param name="extension" select="$entryIdExtension" />
                                                    </xsl:call-template>
                                                </xsl:variable>

                                                <xsl:variable name="antiBodyComment">
                                                    <xsl:call-template name="getAntiBodyCommentByEntryId">
                                                        <xsl:with-param name="root" select="$entryIdRoot" />
                                                        <xsl:with-param name="extension" select="$entryIdExtension" />
                                                    </xsl:call-template>
                                                </xsl:variable>

                                                <xsl:if test="$hasAntiBodyInterpretation='true' and $antiBodyComment=''">
                                                    <p class="antiBodyInterpretation">
                                                        <strong><xsl:text>Ergebnis-Interpretation: </xsl:text></strong>
                                                        <xsl:call-template name="getAntiBodyInterpretationByEntryId">
                                                            <xsl:with-param name="root" select="$entryIdRoot" />
                                                            <xsl:with-param name="extension" select="$entryIdExtension" />
                                                        </xsl:call-template>
                                                    </p>
                                                </xsl:if>
                                            </xsl:when>
                                            <xsl:otherwise>
                                                <strong>Storniert: </strong>
                                                <xsl:call-template name="getAntiBodyTextByEntryId">
                                                    <xsl:with-param name="root" select="$entryIdRoot" />
                                                    <xsl:with-param name="extension" select="$entryIdExtension" />
                                                </xsl:call-template>
                                            </xsl:otherwise>
                                        </xsl:choose>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <!-- disease -->
                                        <xsl:text>Erkrankung: </xsl:text>
                                        <xsl:call-template name="getDiseaseNameByEntryId">
                                            <xsl:with-param name="root" select="$entryIdRoot" />
                                            <xsl:with-param name="extension" select="$entryIdExtension" />
                                        </xsl:call-template>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </div>
                            <xsl:choose>
                                <xsl:when test="$entryIsVaccination='true'">
                                    <div class="col-1 col-10p-vaccination my-auto my-center text-break">
                                        <xsl:variable name="vaccinationLotNumber">
                                            <xsl:call-template name="getVaccinationLotNumberByEntryId">
                                                <xsl:with-param name="root" select="$entryIdRoot" />
                                                <xsl:with-param name="extension" select="$entryIdExtension" />
                                            </xsl:call-template>
                                        </xsl:variable>
                                        <xsl:if test="$vaccinationLotNumber!=''">
                                            <div data-toggle="tooltip" title="Chargennummer" class="text-break">
                                                <xsl:text>Ch.-Nr.: </xsl:text>
                                                <xsl:value-of select="$vaccinationLotNumber" />
                                            </div>
                                        </xsl:if>
                                    </div>
                                </xsl:when>
                                <xsl:otherwise>
                                    <div class="col-3 col-24p-vaccination my-auto my-center text-break">
                                        <xsl:choose>
                                            <xsl:when test="$entryIsAntiBody='true'">
                                                <xsl:if test="$antiBodyAborted='false'">
                                                    <xsl:variable name="antiBodyComment">
                                                        <xsl:call-template name="getAntiBodyCommentByEntryId">
                                                            <xsl:with-param name="root" select="$entryIdRoot" />
                                                            <xsl:with-param name="extension" select="$entryIdExtension" />
                                                        </xsl:call-template>
                                                    </xsl:variable>

                                                    <xsl:if test="$antiBodyComment != ''">
                                                        <strong>
                                                            <xsl:variable name="hasAntiBodyCommentAuthor">
                                                                <xsl:call-template name="hasAntiBodyCommentAuthor">
                                                                    <xsl:with-param name="root" select="$entryIdRoot" />
                                                                    <xsl:with-param name="extension" select="$entryIdExtension" />
                                                                </xsl:call-template>
                                                            </xsl:variable>
                                                            <xsl:choose>
                                                                <xsl:when test="$hasAntiBodyCommentAuthor='true'">
                                                                    <xsl:text>Kommentar [</xsl:text>
                                                                    <xsl:call-template name="getAntiBodyCommentAuthorNameByEntryId">
                                                                        <xsl:with-param name="root" select="$entryIdRoot" />
                                                                        <xsl:with-param name="extension" select="$entryIdExtension" />
                                                                    </xsl:call-template>
                                                                    <xsl:text>]: </xsl:text>
                                                                </xsl:when>
                                                                <xsl:otherwise>
                                                                    <xsl:text>Kommentar: </xsl:text>
                                                                </xsl:otherwise>
                                                            </xsl:choose>
                                                        </strong>
                                                        <xsl:call-template name="truncate">
                                                            <xsl:with-param name="text" select="$antiBodyComment" />
                                                            <xsl:with-param name="maxLength" select="$commentMaxLength" />
                                                        </xsl:call-template>
                                                    </xsl:if>
                                                </xsl:if>
                                            </xsl:when>
                                            <xsl:otherwise>
                                                <xsl:variable name="diseaseComment">
                                                    <xsl:call-template name="getDiseaseCommentByEntryId">
                                                        <xsl:with-param name="root" select="$entryIdRoot" />
                                                        <xsl:with-param name="extension" select="$entryIdExtension" />
                                                    </xsl:call-template>
                                                </xsl:variable>
                                                <xsl:if test="$diseaseComment != ''">
                                                    <strong>
                                                        <xsl:variable name="hasDiseaseCommentAuthor">
                                                            <xsl:call-template name="hasDiseaseCommentAuthor">
                                                                <xsl:with-param name="root" select="$entryIdRoot" />
                                                                <xsl:with-param name="extension" select="$entryIdExtension" />
                                                            </xsl:call-template>
                                                        </xsl:variable>
                                                        <xsl:choose>
                                                            <xsl:when test="$hasDiseaseCommentAuthor='true'">
                                                                <xsl:text>Kommentar [</xsl:text>
                                                                <xsl:call-template name="getDiseaseCommentAuthorNameByEntryId">
                                                                    <xsl:with-param name="root" select="$entryIdRoot" />
                                                                    <xsl:with-param name="extension" select="$entryIdExtension" />
                                                                </xsl:call-template>
                                                                <xsl:text>]: </xsl:text>
                                                            </xsl:when>
                                                            <xsl:otherwise>
                                                                <xsl:text>Kommentar: </xsl:text>
                                                            </xsl:otherwise>
                                                        </xsl:choose>
                                                    </strong>
                                                    <xsl:call-template name="truncate">
                                                        <xsl:with-param name="text" select="$diseaseComment" />
                                                        <xsl:with-param name="maxLength" select="$commentMaxLength" />
                                                    </xsl:call-template>
                                                </xsl:if>
                                            </xsl:otherwise>
                                        </xsl:choose>
                                    </div>
                                </xsl:otherwise>
                            </xsl:choose>
                            <xsl:if test="$entryIsVaccination='true'">
                                <div class="col-1 col-14p-vaccination my-auto my-center text-break">
                                    <xsl:call-template name="getVaccinationDoseAndScheme">
                                        <xsl:with-param name="root" select="$entryIdRoot" />
                                        <xsl:with-param name="extension" select="$entryIdExtension" />
                                    </xsl:call-template>
                                </div>
                            </xsl:if>
                            <div class="col-1 col-14p-vaccination my-auto my-center text-break">
                                <xsl:choose>
                                    <xsl:when test="$entryIsVaccination='true'">
                                        <xsl:variable name="isVaccinationAuthorDeviceNameAvailable">
                                            <xsl:call-template name="isVaccinationAuthorDeviceNameAvailable">
                                                <xsl:with-param name="root" select="$entryIdRoot" />
                                                <xsl:with-param name="extension" select="$entryIdExtension" />
                                            </xsl:call-template>
                                        </xsl:variable>
                                        <xsl:variable name="vaccinationAuthorOrganizationName">
                                            <xsl:call-template name="getVaccinationAuthorOrganizationNameByEntryId">
                                                <xsl:with-param name="root" select="$entryIdRoot" />
                                                <xsl:with-param name="extension" select="$entryIdExtension" />
                                            </xsl:call-template>
                                        </xsl:variable>
                                        <xsl:variable name="vaccinationAuthorName">
                                            <xsl:call-template name="getVaccinationAuthorNameByEntryId">
                                                <xsl:with-param name="root" select="$entryIdRoot" />
                                                <xsl:with-param name="extension" select="$entryIdExtension" />
                                            </xsl:call-template>
                                        </xsl:variable>
                                        <xsl:choose>
                                            <xsl:when test="$isVaccinationAuthorDeviceNameAvailable = 'true' and $vaccinationAuthorOrganizationName != ''">
                                                <xsl:value-of select="$vaccinationAuthorOrganizationName" />
                                            </xsl:when>
                                            <xsl:when test="$vaccinationAuthorName = '' and $vaccinationAuthorOrganizationName = ''">
                                                <xsl:text>Keine Angabe</xsl:text>
                                            </xsl:when>
                                            <xsl:otherwise>
                                                <xsl:value-of select="$vaccinationAuthorName" />
                                                <xsl:if test="$vaccinationAuthorOrganizationName != ''">
                                                    <br />
                                                    <xsl:value-of select="$vaccinationAuthorOrganizationName" />
                                                </xsl:if>
                                            </xsl:otherwise>
                                        </xsl:choose>
                                    </xsl:when>
                                    <xsl:when test="$entryIsAntiBody='true'">
                                        <xsl:variable name="antiBodyAuthorOrganizationName">
                                            <xsl:call-template name="getAntiBodyAuthorOrganizationNameByEntryId">
                                                <xsl:with-param name="root" select="$entryIdRoot" />
                                                <xsl:with-param name="extension" select="$entryIdExtension" />
                                            </xsl:call-template>
                                        </xsl:variable>
                                        <xsl:variable name="isAntiBodyAuthorDeviceNameAvailable">
                                            <xsl:call-template name="isAntiBodyAuthorDeviceNameAvailable">
                                                <xsl:with-param name="root" select="$entryIdRoot" />
                                                <xsl:with-param name="extension" select="$entryIdExtension" />
                                            </xsl:call-template>
                                        </xsl:variable>
                                        <xsl:variable name="antiBodyAuthorName">
                                            <xsl:call-template name="getAntiBodyAuthorNameByEntryId">
                                                <xsl:with-param name="root" select="$entryIdRoot" />
                                                <xsl:with-param name="extension" select="$entryIdExtension" />
                                            </xsl:call-template>
                                        </xsl:variable>
                                        <xsl:choose>
                                            <xsl:when test="$isAntiBodyAuthorDeviceNameAvailable = 'true' and $antiBodyAuthorOrganizationName != ''">
                                                <xsl:value-of select="$antiBodyAuthorOrganizationName" />
                                            </xsl:when>
                                            <xsl:when test="$antiBodyAuthorName = '' and $antiBodyAuthorOrganizationName = ''">
                                                <xsl:text>Keine Angabe</xsl:text>
                                            </xsl:when>
                                            <xsl:otherwise>
                                                <xsl:value-of select="$antiBodyAuthorName" />
                                                <xsl:if test="$antiBodyAuthorOrganizationName != ''">
                                                    <br />
                                                    <xsl:value-of select="$antiBodyAuthorOrganizationName" />
                                                </xsl:if>
                                            </xsl:otherwise>
                                        </xsl:choose>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <xsl:variable name="isDiseaseAuthorDeviceNameAvailable">
                                            <xsl:call-template name="isDiseaseAuthorDeviceNameAvailable">
                                                <xsl:with-param name="root" select="$entryIdRoot" />
                                                <xsl:with-param name="extension" select="$entryIdExtension" />
                                            </xsl:call-template>
                                        </xsl:variable>
                                        <xsl:variable name="diseaseAuthorOrganizationName">
                                            <xsl:call-template name="getDiseaseAuthorOrganizationNameByEntryId">
                                                <xsl:with-param name="root" select="$entryIdRoot" />
                                                <xsl:with-param name="extension" select="$entryIdExtension" />
                                            </xsl:call-template>
                                        </xsl:variable>
                                        <xsl:variable name="diseaseAuthorName">
                                            <xsl:call-template name="getDiseaseAuthorNameByEntryId">
                                                <xsl:with-param name="root" select="$entryIdRoot" />
                                                <xsl:with-param name="extension" select="$entryIdExtension" />
                                            </xsl:call-template>
                                        </xsl:variable>
                                        <xsl:choose>
                                            <xsl:when test="$isDiseaseAuthorDeviceNameAvailable = 'true' and $diseaseAuthorOrganizationName != ''">
                                                <xsl:value-of select="$diseaseAuthorOrganizationName" />
                                            </xsl:when>
                                            <xsl:when test="$diseaseAuthorName = '' and $diseaseAuthorOrganizationName = ''">
                                                <xsl:text>Keine Angabe</xsl:text>
                                            </xsl:when>
                                            <xsl:otherwise>
                                                <xsl:value-of select="$diseaseAuthorName" />
                                                <xsl:if test="$diseaseAuthorOrganizationName != ''">
                                                    <br />
                                                    <xsl:value-of select="$diseaseAuthorOrganizationName" />
                                                </xsl:if>
                                            </xsl:otherwise>
                                        </xsl:choose>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </div>
                            <div class="col-1 col-12p-vaccination my-auto my-center media text-break">
                                <span class="media-body my-auto my-center">
                                    <xsl:choose>
                                        <xsl:when test="$entryIsVaccination='true'">
                                            <xsl:variable name="vaccinationCertificateAvailable">
                                                <xsl:call-template name="hasCertificateLinkForVaccinationEntryId">
                                                    <xsl:with-param name="root" select="$entryIdRoot" />
                                                    <xsl:with-param name="extension" select="$entryIdExtension" />
                                                 </xsl:call-template>
                                            </xsl:variable>
                                            <xsl:if test="$vaccinationCertificateAvailable='true'">
                                                <xsl:variable name="linkTarget">
                                                    <xsl:call-template name="getCertificateLinkForVaccinationEntryId">
                                                        <xsl:with-param name="root" select="$entryIdRoot" />
                                                        <xsl:with-param name="extension" select="$entryIdExtension" />
                                                    </xsl:call-template>
                                                </xsl:variable>
                                                <xsl:variable name="linkText">
                                                    <xsl:call-template name="getCertificateLinkTextForVaccinationEntryId">
                                                        <xsl:with-param name="root" select="$entryIdRoot" />
                                                        <xsl:with-param name="extension" select="$entryIdExtension" />
                                                    </xsl:call-template>
                                                </xsl:variable>
                                                <a class="certificate" target="_blank">
                                                    <xsl:attribute name="href">
                                                            <xsl:value-of select="$linkTarget" />
                                                    </xsl:attribute>
                                                    <xsl:value-of select="$linkText" />
                                                </a>
                                            </xsl:if>
                                        </xsl:when>
                                        <xsl:when test="$entryIsAntiBody='true'">
                                            <xsl:if test="$antiBodyAborted='false'">
                                                <xsl:variable name="antiBodyCertificateAvailable">
                                                    <xsl:call-template name="hasCertificateLinkForAntiBodyEntryId">
                                                        <xsl:with-param name="root" select="$entryIdRoot" />
                                                        <xsl:with-param name="extension" select="$entryIdExtension" />
                                                    </xsl:call-template>
                                                </xsl:variable>
                                                <xsl:if test="$antiBodyCertificateAvailable='true'">
                                                    <xsl:variable name="linkTarget">
                                                        <xsl:call-template name="getCertificateLinkForAntiBodyEntryId">
                                                            <xsl:with-param name="root" select="$entryIdRoot" />
                                                            <xsl:with-param name="extension" select="$entryIdExtension" />
                                                        </xsl:call-template>
                                                    </xsl:variable>
                                                    <xsl:variable name="linkText">
                                                        <xsl:call-template name="getCertificateLinkTextForAntiBodyEntryId">
                                                            <xsl:with-param name="root" select="$entryIdRoot" />
                                                            <xsl:with-param name="extension" select="$entryIdExtension" />
                                                        </xsl:call-template>
                                                    </xsl:variable>
                                                    <a class="certificate" target="_blank">
                                                        <xsl:attribute name="href">
                                                            <xsl:value-of select="$linkTarget" />
                                                        </xsl:attribute>
                                                        <xsl:value-of select="$linkText" />
                                                    </a>
                                                </xsl:if>
                                            </xsl:if>
                                        </xsl:when>
                                        <xsl:otherwise>
                                            <xsl:variable name="diseaseCertificateAvailable">
                                                <xsl:call-template name="hasCertificateLinkForDiseaseEntryId">
                                                    <xsl:with-param name="root" select="$entryIdRoot" />
                                                    <xsl:with-param name="extension" select="$entryIdExtension" />
                                                </xsl:call-template>
                                            </xsl:variable>
                                            <xsl:if test="$diseaseCertificateAvailable='true'">
                                                <xsl:variable name="linkTarget">
                                                    <xsl:call-template name="getCertificateLinkForDiseaseEntryId">
                                                        <xsl:with-param name="root" select="$entryIdRoot" />
                                                        <xsl:with-param name="extension" select="$entryIdExtension" />
                                                    </xsl:call-template>
                                                </xsl:variable>
                                                <xsl:variable name="linkText">
                                                    <xsl:call-template name="getCertificateLinkTextForDiseaseEntryId">
                                                        <xsl:with-param name="root" select="$entryIdRoot" />
                                                        <xsl:with-param name="extension" select="$entryIdExtension" />
                                                    </xsl:call-template>
                                                </xsl:variable>
                                                <a class="certificate" target="_blank">
                                                    <xsl:attribute name="href">
                                                        <xsl:value-of select="$linkTarget" />
                                                    </xsl:attribute>
                                                    <xsl:value-of select="$linkText" />
                                                </a>
                                            </xsl:if>
                                        </xsl:otherwise>
                                    </xsl:choose>
                                </span>
                                <xsl:if test="$disableVaccinationDetails='0'">
                                    <button class="d-block d-print-none media-right btn accordion-toggle collapsed accordionButton my-auto" id="{$rowId}-toggle"
                                            data-test-id="{$rowId}-toggle" data-toggle="collapse" data-target="#{$rowId}-body" data-parent="#{$rowId}" aria-expanded="false" />
                                </xsl:if>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <xsl:if test="$disableVaccinationDetails='0'">
            <div id="{$rowId}-body" data-test-id="{$rowId}-body" class="panel-collapse d-print-block collapse textSmall vaccinationHistoryContainer" data-parent="#{$rowId}">
                <div class="panel-body">
                    <div class="headerRowInner">
                        <xsl:call-template name="renderEntryHistoryContainer">
                            <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                        </xsl:call-template>
                    </div>
                </div>
            </div>
        </xsl:if>
    </div>
</xsl:template>

<xsl:template name="renderVaccinationDetails">
    <xsl:param name="title" />
    <xsl:param name="text" />
    <xsl:param name="textBold" select="string(false())" />
    <xsl:param name="underlined" select="string(false())" />

    <xsl:variable name="underlinedClass">
        <xsl:if test="$underlined='true'">
            <xsl:text>vaccinationDetailsCellUnderlined</xsl:text>
        </xsl:if>
    </xsl:variable>

    <xsl:variable name="textBoldClass">
        <xsl:if test="$textBold='true'">
            <xsl:text>vaccinationDetailsCellBold</xsl:text>
        </xsl:if>
    </xsl:variable>

    <div class="container vaccinationDetailsContainer d-print-inline">
        <div class="row">
            <div class="col-5 vaccinationDetailsCell vaccinationDetailsCellTitle text-break {$underlinedClass}">
                <xsl:value-of select="$title" />
            </div>
            <div class="col-7 vaccinationDetailsCell text-break {$textBoldClass}">
                <xsl:copy-of select="$text" />
            </div>
        </div>
    </div>
</xsl:template>

<xsl:template name="renderVaccinationDetailsTitle">
    <xsl:param name="title" />
    <xsl:param name="underlined" select="string(false())" />
    <xsl:param name="testId" select="''"/>

    <xsl:variable name="underlinedClass">
        <xsl:if test="$underlined='true'">
            <xsl:text>vaccinationDetailsCellUnderlined</xsl:text>
        </xsl:if>
    </xsl:variable>

    <div class="container vaccinationDetailsContainer">
        <div class="row">
            <div class="col vaccinationDetailsCell vaccinationDetailsCellTitle {$underlinedClass}" data-test-id="{$testId}">
                <xsl:value-of select="$title" />
            </div>
        </div>
    </div>
</xsl:template>

<xsl:template name="renderAutomatedRecommendedVaccinations">
    <xsl:param name="vaccinationCode" />

    <xsl:variable name="hasRecommendationSection">
        <xsl:call-template name="isCodedInRecommendationSection">
            <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
        </xsl:call-template>
    </xsl:variable>

    <xsl:if test="$hasRecommendationSection='true'">
        <div class="container">
            <div class="row headerRowInnerTableRow odd">

                <table class="table">
                    <tbody>
                        <tr>
                            <td class="headerRowInnerTableRowCol" width="10%">
                                <xsl:call-template name="getNextVaccinationRange">
                                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                </xsl:call-template>
                            </td>
                            <td class="headerRowInnerTableRowCol" width="56%">
                                <xsl:variable name="nextImmunizationProductName">
                                    <xsl:call-template name="getNextImmunizationProductName">
                                        <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                    </xsl:call-template>
                                </xsl:variable>
                                <xsl:if test="$nextImmunizationProductName != ''">
                                    <xsl:text>Empfohlener Impfstoff: </xsl:text>
                                    <xsl:value-of select="$nextImmunizationProductName" />
                                </xsl:if>
                            </td>
                            <td class="headerRowInnerTableRowCol" width="34%">
                                <xsl:call-template name="getNextVaccinationDoseAndScheme">
                                    <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                                </xsl:call-template>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </xsl:if>
</xsl:template>

<xsl:template name="renderNextManualRecommendedVaccinationView">
    <xsl:param name="vaccinationCode" />

    <xsl:variable name="entryIdRoot" select="//n1:substanceAdministration
        [
            @negationInd='false' and
            n1:templateId[@root='1.2.40.0.34.6.0.11.3.3'] and
            n1:author/n1:assignedAuthor/n1:id[@root != '1.2.40.0.34.6.104' or @nullFlavor='UNK'] and
            n1:entryRelationship/n1:observation/n1:code[@code = $vaccinationCode]
        ]
        /n1:id/@root" />
    <xsl:variable name="entryIdExtension" select="//n1:substanceAdministration
        [
            @negationInd='false' and
            n1:templateId[@root='1.2.40.0.34.6.0.11.3.3'] and
            n1:author/n1:assignedAuthor/n1:id[@root != '1.2.40.0.34.6.104' or @nullFlavor='UNK'] and
            n1:entryRelationship/n1:observation/n1:code[@code = $vaccinationCode]
        ]
        /n1:id/@extension" />

    <div class="container">
        <div class="row headerRowInnerTableRow odd">
            <table class="table">
                <tbody>
                    <tr>
                        <td class="headerRowInnerTableRowCol" width="10%">
                            <xsl:call-template name="getRecommendedVaccinationDateByEntryId">
                                <xsl:with-param name="root" select="$entryIdRoot"/>
                                <xsl:with-param name="extension" select="$entryIdExtension"/>
                            </xsl:call-template>
                        </td>
                        <td class="headerRowInnerTableRowCol" width="29%">
                            <xsl:call-template name="getRecommendedVaccinationImmunizationProductByEntryId">
                                <xsl:with-param name="root" select="$entryIdRoot"/>
                                <xsl:with-param name="extension" select="$entryIdExtension"/>
                            </xsl:call-template>
                        </td>
                        <td class="headerRowInnerTableRowCol">
                            <xsl:call-template name="getNextVaccinationDoseAndScheme">
                                <xsl:with-param name="vaccinationCode" select="$vaccinationCode"/>
                            </xsl:call-template>
                        </td>
                        <td class="headerRowInnerTableRowCol" width="18%">
                            <xsl:variable name="recommendedVaccinationAuthorOrganizationName">
                                <xsl:call-template name="getVaccinationIndicationAuthorOrganizationNameByEntryId">
                                    <xsl:with-param name="root" select="$entryIdRoot" />
                                    <xsl:with-param name="extension" select="$entryIdExtension" />
                                </xsl:call-template>
                            </xsl:variable>

                            <xsl:variable name="recommendedVaccinationAuthorName">
                                <xsl:call-template name="getRecommendedVaccinationAuthorNameByEntryId">
                                    <xsl:with-param name="root" select="$entryIdRoot" />
                                    <xsl:with-param name="extension" select="$entryIdExtension" />
                                </xsl:call-template>
                            </xsl:variable>

                            <xsl:if test="$recommendedVaccinationAuthorName != ''">
                                <xsl:value-of select="$recommendedVaccinationAuthorName" />
                            </xsl:if>
                            <xsl:if test="$recommendedVaccinationAuthorOrganizationName != '' and $recommendedVaccinationAuthorName != ''">
                                <br />
                            </xsl:if>
                            <xsl:if test="$recommendedVaccinationAuthorOrganizationName != ''">
                                <xsl:value-of select="$recommendedVaccinationAuthorOrganizationName" />
                            </xsl:if>
                            <xsl:if test="$recommendedVaccinationAuthorName = '' and $recommendedVaccinationAuthorOrganizationName = ''">
                                <xsl:text>Keine Angabe</xsl:text>
                            </xsl:if>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</xsl:template>

<xsl:template name="renderEntryHistoryContainer">
    <xsl:param name="vaccinationCode" />

    <xsl:variable name="vaccinationCodeReverseMapping">
        <xsl:call-template name="getImmunizationDiseaseMappingReverse">
            <xsl:with-param name="code" select="$vaccinationCode" />
        </xsl:call-template>
    </xsl:variable>

    <xsl:if test="//n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1'] and ../n1:entryRelationship/n1:observation/n1:code[@code=$vaccinationCode]] |
                  //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.16'] and ../../../n1:code[@code=$vaccinationCode]] |
                  //n1:effectiveTime[../n1:templateId[@root='1.2.40.0.34.6.0.11.3.9'] and ../n1:value[@code=$vaccinationCodeReverseMapping]]">
        <p class="recommendation-entryHistoryTitle" style="{$recommendationDefaultVisibilityStyle}" data-test-id="entry-history-{$vaccinationCode}">Bisherige Ereignisse</p>
    </xsl:if>

    <div class="container sortable" style="margin: 0px; padding: 0px;">
        <!-- vaccination -->
        <xsl:for-each select="//n1:code[@code=$vaccinationCode]/../../../n1:templateId[@root='1.2.40.0.34.6.0.11.3.1']">

            <xsl:variable name="currentEntryIdExtension" select="./../n1:id/@extension" />
            <xsl:variable name="currentEntryIdRoot" select="./../n1:id/@root" />

            <xsl:variable name="containerId" select="generate-id()" />

            <xsl:variable name="vaccinationAuthorName">
                <xsl:call-template name="getVaccinationAuthorNameByEntryId">
                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="vaccinationAuthorOrganizationName">
                <xsl:call-template name="getVaccinationAuthorOrganizationNameByEntryId">
                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="vaccinationAuthorDeviceName">
                <xsl:call-template name="getVaccinationAuthorDeviceNameByEntryId">
                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:variable name="isVaccinationAuthorDeviceNameAvailable">
                <xsl:call-template name="isVaccinationAuthorDeviceNameAvailable">
                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                </xsl:call-template>
            </xsl:variable>

            <xsl:call-template name="renderExpandableRowEntry">
                <xsl:with-param name="vaccinationCode" select="$vaccinationCode" />
                <xsl:with-param name="rawDate">
                    <xsl:call-template name="getVaccinationDateRawByEntryId" >
                        <xsl:with-param name="root" select="$currentEntryIdRoot" />
                        <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                    </xsl:call-template>
                </xsl:with-param>
                <xsl:with-param name="header-col-1-test-id" select="concat('row-', $vaccinationCode, '-body-row-col-vacc-', position())" />
                <xsl:with-param name="header-col-1">
                    <xsl:call-template name="getVaccinationDateByEntryId">
                        <xsl:with-param name="root" select="$currentEntryIdRoot" />
                        <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                    </xsl:call-template>
                </xsl:with-param>
                <xsl:with-param name="header-col-2">
                    <xsl:text>Impfstoff: </xsl:text>
                    <xsl:call-template name="getVaccinationProductNameByEntryId">
                        <xsl:with-param name="root" select="$currentEntryIdRoot" />
                        <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                    </xsl:call-template>
                </xsl:with-param>
                <xsl:with-param name="header-col-3">
                    <xsl:call-template name="getVaccinationDoseAndScheme">
                        <xsl:with-param name="root" select="$currentEntryIdRoot" />
                        <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                    </xsl:call-template>
                </xsl:with-param>
                <xsl:with-param name="header-col-4">
                    <xsl:choose>
                        <xsl:when test="$isVaccinationAuthorDeviceNameAvailable = 'true' and $vaccinationAuthorOrganizationName != ''">
                            <xsl:value-of select="$vaccinationAuthorOrganizationName" />
                        </xsl:when>
                        <xsl:when test="$vaccinationAuthorName = '' and $vaccinationAuthorOrganizationName = ''">
                            <xsl:text>Keine Angabe</xsl:text>
                        </xsl:when>
                        <xsl:otherwise>
                            <xsl:value-of select="$vaccinationAuthorName" />
                            <xsl:if test="$vaccinationAuthorOrganizationName != ''">
                                <br />
                                <xsl:value-of select="$vaccinationAuthorOrganizationName" />
                            </xsl:if>
                        </xsl:otherwise>
                    </xsl:choose>
                </xsl:with-param>
                <xsl:with-param name="header-col-5">
                    <xsl:variable name="vaccinationCertificateAvailable">
                        <xsl:call-template name="hasCertificateLinkForVaccinationEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>
                    <xsl:if test="$vaccinationCertificateAvailable='true'">
                        <xsl:variable name="linkTarget">
                            <xsl:call-template name="getCertificateLinkForVaccinationEntryId">
                                <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                            </xsl:call-template>
                        </xsl:variable>
                        <xsl:variable name="linkText">
                            <xsl:call-template name="getCertificateLinkTextForVaccinationEntryId">
                                <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                            </xsl:call-template>
                        </xsl:variable>
                        <a class="certificate" target="_blank">
                            <xsl:attribute name="href">
                                <xsl:value-of select="$linkTarget" />
                            </xsl:attribute>
                            <xsl:value-of select="$linkText" />
                        </a>
                    </xsl:if>
                </xsl:with-param>
                <xsl:with-param name="body-left">
                    <xsl:variable name="vaccinationManufacturer">
                        <xsl:call-template name="getVaccinationManufacturerByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="vaccinationProductLongText">
                        <xsl:call-template name="getVaccinationProductLongNameByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="hasVaccinationAmountForEntryId">
                        <xsl:call-template name="hasVaccinationAmountForEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="hasVaccinationExpirationDateForEntryId">
                        <xsl:call-template name="hasVaccinationExpirationDateForEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="hasVaccinationProductIdForEntryId">
                        <xsl:call-template name="hasVaccinationProductIdForEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="vaccinationPZN">
                        <xsl:call-template name="getVaccinationPZNByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="hasVaccinationRoutOfAdministration">
                        <xsl:call-template name="hasVaccinationRouteOfAdministrationForEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="vaccinationLotNumber">
                        <xsl:call-template name="getVaccinationLotNumberByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="vaccinationPharmCode">
                        <xsl:call-template name="getVaccinationPharmCodeByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="vaccinationPharmName">
                        <xsl:call-template name="getVaccinationPharmNameByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="showPharmDetailsContainer">
                        <xsl:choose>
                            <xsl:when test="$vaccinationManufacturer != '' or $vaccinationProductLongText != '' or $hasVaccinationAmountForEntryId = 'true' or
                                            $hasVaccinationExpirationDateForEntryId = 'true' or $hasVaccinationProductIdForEntryId = 'true' or $vaccinationPZN != '' or
                                            $vaccinationLotNumber != '' or $vaccinationPharmCode != '' or $vaccinationPharmName != '' or $hasVaccinationRoutOfAdministration = 'true'">
                                <xsl:value-of select="string(true())" />
                            </xsl:when>
                            <xsl:otherwise>
                                <xsl:value-of select="string(false())" />
                            </xsl:otherwise>
                        </xsl:choose>
                    </xsl:variable>

                    <xsl:if test="$showPharmDetailsContainer='true'">
                        <xsl:call-template name="renderVaccinationDetailsTitle">
                            <xsl:with-param name="title" select="'Arzneimittel:'" />
                            <xsl:with-param name="underlined" select="string(true())" />
                            <xsl:with-param name="testId" select="concat('row-', $vaccinationCode, '-sub-', $containerId, '-Arzneimittel')" />
                        </xsl:call-template>
                    </xsl:if>

                    <xsl:if test="$vaccinationManufacturer!=''">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Hersteller:in/Zulassungsinhaber:in:'" />
                            <xsl:with-param name="text" select="$vaccinationManufacturer" />
                        </xsl:call-template>
                    </xsl:if>

                    <xsl:if test="$vaccinationProductLongText!=''">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Zulassungsname:'" />
                            <xsl:with-param name="text" select="$vaccinationProductLongText" />
                        </xsl:call-template>
                    </xsl:if>

                    <xsl:if test="$hasVaccinationAmountForEntryId='true'">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Dosierung:'" />
                            <xsl:with-param name="text">
                                <xsl:call-template name="getVaccinationAmountByEntryId">
                                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                </xsl:call-template>
                            </xsl:with-param>
                        </xsl:call-template>
                    </xsl:if>

                    <xsl:if test="$hasVaccinationExpirationDateForEntryId='true'">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Verfallsdatum:'" />
                            <xsl:with-param name="text">
                                <xsl:call-template name="getVaccinationExpirationDateByEntryId">
                                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                </xsl:call-template>
                            </xsl:with-param>
                        </xsl:call-template>
                    </xsl:if>

                    <xsl:if test="$hasVaccinationProductIdForEntryId='true'">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Serialisierungsnummer:'" />
                            <xsl:with-param name="text">
                                <xsl:call-template name="getVaccinationProductIdByEntryId">
                                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                </xsl:call-template>
                            </xsl:with-param>
                        </xsl:call-template>
                    </xsl:if>

                    <xsl:if test="$vaccinationPZN!=''">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Pharmazentralnummer:'" />
                            <xsl:with-param name="text" select="$vaccinationPZN" />
                        </xsl:call-template>
                    </xsl:if>

                    <xsl:if test="$hasVaccinationRoutOfAdministration='true'">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Applikationsweg:'" />
                            <xsl:with-param name="text">
                                <xsl:call-template name="getVaccinationRouteOfAdministrationByEntryId">
                                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                </xsl:call-template>
                            </xsl:with-param>
                        </xsl:call-template>
                    </xsl:if>

                    <xsl:if test="$vaccinationLotNumber!=''">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Chargennummer:'" />
                            <xsl:with-param name="text" select="$vaccinationLotNumber" />
                        </xsl:call-template>
                    </xsl:if>

                    <xsl:if test="$vaccinationPharmCode!=''">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'ATC-Code:'" />
                            <xsl:with-param name="text" select="$vaccinationPharmCode" />
                        </xsl:call-template>
                    </xsl:if>

                    <xsl:if test="$vaccinationPharmName!=''">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Wirkstoffe:'" />
                            <xsl:with-param name="text" select="$vaccinationPharmName" />
                        </xsl:call-template>
                    </xsl:if>

                    <xsl:variable name="vaccinationBillingMedicalIndicationForEntryId">
                        <xsl:call-template name="hasVaccinationBillingMedicalIndicationForEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="vaccinationBillingVoucherCodeForEntryId">
                        <xsl:call-template name="hasVaccinationBillingVoucherCodeForEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="showBillingContainer">
                        <xsl:choose>
                            <xsl:when test="$vaccinationBillingMedicalIndicationForEntryId='true' or $vaccinationBillingVoucherCodeForEntryId='true'">
                                <xsl:value-of select="string(true())" />
                            </xsl:when>
                            <xsl:otherwise>
                                <xsl:value-of select="string(false())" />
                            </xsl:otherwise>
                        </xsl:choose>
                    </xsl:variable>

                    <xsl:variable name="billingContainerMargin">
                        <xsl:choose>
                            <xsl:when test="$showPharmDetailsContainer = 'true'">
                                <xsl:text>margin-top: 10px</xsl:text>
                            </xsl:when>
                            <xsl:otherwise></xsl:otherwise>
                        </xsl:choose>
                    </xsl:variable>

                    <xsl:if test="$showBillingContainer='true'">
                        <div style="{$billingContainerMargin}">
                            <xsl:call-template name="renderVaccinationDetailsTitle">
                                <xsl:with-param name="title" select="'Abrechenbarkeit:'" />
                                <xsl:with-param name="underlined" select="string(true())" />
                                <xsl:with-param name="testId" select="concat('row-', $vaccinationCode, '-sub-', $containerId, '-Abrechenbarkeit')" />
                            </xsl:call-template>

                            <xsl:if test="$vaccinationBillingMedicalIndicationForEntryId='true'">
                                <xsl:call-template name="renderVaccinationDetails">
                                    <xsl:with-param name="title" select="'Impfindikation:'" />
                                    <xsl:with-param name="text">
                                        <xsl:call-template name="getVaccinationBillingMedicalIndicationByEntryId">
                                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                        </xsl:call-template>
                                    </xsl:with-param>
                                </xsl:call-template>
                            </xsl:if>

                            <xsl:if test="$vaccinationBillingVoucherCodeForEntryId='true'">
                                 <xsl:call-template name="renderVaccinationDetails">
                                     <xsl:with-param name="title" select="'Impfgutschein:'" />
                                     <xsl:with-param name="text">
                                         <xsl:call-template name="getVaccinationBillingVoucherCodeByEntryId">
                                             <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                             <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                         </xsl:call-template>
                                     </xsl:with-param>
                                 </xsl:call-template>
                            </xsl:if>
                        </div>
                    </xsl:if>

                    <xsl:variable name="vaccinationSetting">
                        <xsl:call-template name="hasVaccinationSettingForEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="vaccinationProgramm">
                        <xsl:call-template name="hasVaccinationProgrammForEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="vaccinationSettingStyle">
                        <xsl:if test="$showBillingContainer='true' or $showPharmDetailsContainer='true'">
                            <xsl:text>margin-top: 10px</xsl:text>
                        </xsl:if>
                    </xsl:variable>

                    <xsl:if test="$vaccinationSetting='true' or $vaccinationProgramm='true'">
                        <div style="{$vaccinationSettingStyle}">
                            <xsl:if test="$vaccinationSetting='true'">
                                <div>
                                    <xsl:call-template name="renderVaccinationDetails">
                                        <xsl:with-param name="title" select="'Impfsetting:'" />
                                        <xsl:with-param name="text">
                                            <xsl:call-template name="getVaccinationSettingByEntryId">
                                                <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                                <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                            </xsl:call-template>
                                        </xsl:with-param>
                                    </xsl:call-template>
                                </div>
                            </xsl:if>
                            <xsl:if test="$vaccinationProgramm='true'">
                                <div>
                                    <xsl:call-template name="renderVaccinationDetails">
                                        <xsl:with-param name="title" select="'Impfprogramm:'" />
                                        <xsl:with-param name="text">
                                            <xsl:call-template name="getVaccinationProgrammByEntryId">
                                                <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                                <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                            </xsl:call-template>
                                        </xsl:with-param>
                                    </xsl:call-template>
                                </div>
                            </xsl:if>
                        </div>
                    </xsl:if>

                    <xsl:variable name="vaccinationDateStyle">
                        <xsl:if test="$showBillingContainer='true' or $vaccinationSetting='true' or $vaccinationProgramm='true'">
                            <xsl:text>margin-top: 10px</xsl:text>
                        </xsl:if>
                    </xsl:variable>

                    <div style="{$vaccinationDateStyle}">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Impfdatum:'" />
                            <xsl:with-param name="text">
                                <xsl:call-template name="getVaccinationDateLongByEntryId">
                                    <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                    <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                                </xsl:call-template>
                            </xsl:with-param>
                        </xsl:call-template>
                    </div>
                </xsl:with-param>
                <xsl:with-param name="body-right">
                    <xsl:variable name="vaccinationPlace">
                        <xsl:call-template name="getVaccinationPerformedPlaceByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:if test="$vaccinationPlace != ''">
                        <xsl:call-template name="renderVaccinationDetails">
                            <xsl:with-param name="title" select="'Impfort:'" />
                            <xsl:with-param name="text" select="$vaccinationPlace" />
                            <xsl:with-param name="underlined" select="string(true())" />
                        </xsl:call-template>
                    </xsl:if>

                    <xsl:variable name="vaccinationAuthorOrganizationRole">
                        <xsl:call-template name="getVaccinationAuthorRoleByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="vaccinationAuthorOrganizationAddress">
                        <xsl:call-template name="getVaccinationAuthorOrganizationAddressByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="vaccinationAuthorOrganizationTelecom">
                        <xsl:call-template name="getVaccinationAuthorOrganizationTelecomByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:choose>
                        <xsl:when test="$vaccinationAuthorName != '' or $vaccinationAuthorDeviceName != '' or $vaccinationAuthorOrganizationRole != '' or $vaccinationAuthorOrganizationName != '' or
                                        $vaccinationAuthorOrganizationAddress !='' or $vaccinationAuthorOrganizationTelecom != ''">
                            <xsl:variable name="authorTitle">
                                <xsl:choose>
                                    <xsl:when test="$isVaccinationAuthorDeviceNameAvailable='true'">
                                        <xsl:text>Datenerstellendes System:</xsl:text>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <xsl:text>Med. verantwortl. Person:</xsl:text>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </xsl:variable>
                            <xsl:call-template name="renderVaccinationDetails">
                                <xsl:with-param name="title" select="$authorTitle" />
                                <xsl:with-param name="text">

                                    <xsl:if test="$vaccinationAuthorName != ''">
                                        <xsl:value-of select="$vaccinationAuthorName" />
