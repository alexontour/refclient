                                </xsl:call-template>
                            </xsl:when>
                            <xsl:otherwise>
                                <xsl:call-template name="renderVaccinationDetails">
                                    <xsl:with-param name="title" select="'Kommentar:'" />
                                    <xsl:with-param name="text" select="$antiBodyComment" />
                                </xsl:call-template>
                            </xsl:otherwise>
                        </xsl:choose>
                    </xsl:if>
                </xsl:with-param>
                <xsl:with-param name="body-right">
                    <xsl:variable name="antiBodyAuthorRole">
                        <xsl:call-template name="getAntiBodyAuthorRoleByEntryId">
