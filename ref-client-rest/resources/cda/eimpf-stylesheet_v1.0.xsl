    <xsl:template name="getAntiBodyTextByEntryId">
        <xsl:param name="root" />
        <xsl:param name="extension" />

        <xsl:variable name="entry" select="//n1:id[(@extension=$extension and @root=$root) or ((not(@extension) or @extension = '') and (not($extension) or $extension = '') and @root=$root)]" />

        <xsl:variable name="antiBodyText">
            <xsl:if test="$entry/../n1:code/@code">
                <xsl:call-template name="getImmunizationAntiBody">
                    <xsl:with-param name="code" select="$entry/../n1:code/@code" />
                </xsl:call-template>
            </xsl:if>
        </xsl:variable>

        <xsl:choose>
            <xsl:when test="$antiBodyText != ''">
                <xsl:value-of select="$antiBodyText" />
            </xsl:when>
            <xsl:otherwise>
                <!-- fallback string -->
                <xsl:if test="$entry/../n1:code/@displayName">
                    <xsl:value-of select="$entry/../n1:code/@displayName" />
                    <xsl:if test="$entry/../n1:code/@code != ''">
                        <xsl:text> </xsl:text>
                    </xsl:if>
                </xsl:if>
                <xsl:if test="$entry/../n1:code/@code != '' and $entry/../n1:code/@displayName">
                    <xsl:text>(</xsl:text>
                    <xsl:value-of select="$entry/../n1:code/@code" />
                    <xsl:text>)</xsl:text>
                </xsl:if>
                <xsl:if test="$entry/../n1:code/@code != '' and not($entry/../n1:code/@displayName)">
                    <xsl:value-of select="$entry/../n1:code/@code" />
                </xsl:if>
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>

    <xsl:template name="getAntiBodyValueByEntryId">
        <xsl:param name="root" />
        <xsl:param name="extension" />

        <xsl:variable name="entry" select="//n1:id[(@extension=$extension and @root=$root) or ((not(@extension) or @extension = '') and (not($extension) or $extension = '') and @root=$root)]" />
        <xsl:variable name="value" select="$entry/../n1:value" />

        <xsl:choose>
            <xsl:when test="$value/@xsi:type='IVL_PQ' or $value/@xsi:type='IVL_INT'">
                <xsl:value-of select="$value/n1:low/@value" />
                <xsl:text>-</xsl:text>
                <xsl:value-of select="$value/n1:high/@value" />
                <xsl:if test="$value/n1:center/@value and $value/n1:width/@value">
                    <xsl:text> (</xsl:text>
                    <xsl:value-of select="$value/n1:center/@value" />
                    <xsl:text> +/- </xsl:text>
                    <xsl:value-of select="$value/n1:width/@value div 2" />
                    <xsl:text>)</xsl:text>
                </xsl:if>
            </xsl:when>
            <xsl:when test="$value/@xsi:type='RTO'">
                <xsl:value-of select="$value/n1:numerator/@value" />
                <xsl:text>:</xsl:text>
                <xsl:value-of select="$value/n1:denominator/@value" />
            </xsl:when>
            <xsl:otherwise>
                <!-- xsi:type="PQ" and "INT" as fallback -->
                <xsl:value-of select="$value/@value" />
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>

    <xsl:template name="getAntiBodyUnitByEntryId">
        <xsl:param name="root" />
        <xsl:param name="extension" />

        <xsl:variable name="entry" select="//n1:id[(@extension=$extension and @root=$root) or ((not(@extension) or @extension = '') and (not($extension) or $extension = '') and @root=$root)]" />
        <xsl:variable name="value" select="$entry/../n1:value" />

        <xsl:choose>
            <xsl:when test="$value/@xsi:type='IVL_PQ' or $value/@xsi:type='IVL_INT'">
                <xsl:value-of select="$value/n1:low/@unit" />
            </xsl:when>
            <xsl:when test="$value/@xsi:type='RTO'">
                <!-- "RTO" has no unit -->
                <xsl:text />
            </xsl:when>
            <xsl:otherwise>
                <!-- xsi:type="PQ" and "INT" (@unit for "INT" is optional) as fallback -->
                <xsl:value-of select="$value/@unit" />
            </xsl:otherwise>
        </xsl:choose>
    </xsl:template>

