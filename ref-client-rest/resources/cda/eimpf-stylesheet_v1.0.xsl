                        <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                    </xsl:call-template>
                </xsl:variable>

                <xsl:variable name="diseaseAuthorOrganizationName">
                    <xsl:call-template name="getDiseaseAuthorOrganizationNameByEntryId">
                        <xsl:with-param name="root" select="$currentEntryIdRoot" />
                        <xsl:with-param name="extension" select="$currentEntryIdExtension" />
