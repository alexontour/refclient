                        <xsl:variable name="participantVRFAddress">
                            <xsl:call-template name="getDiseaseParticipantVRFAddressByEntryId">
                                <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                            </xsl:call-template>
                        </xsl:variable>
                        <xsl:variable name="participantVRFTelecom">
                            <xsl:call-template name="getDiseaseParticipantVRFTelecomByEntryId">
                                <xsl:with-param name="root" select="$currentEntryIdRoot" />
                                <xsl:with-param name="extension" select="$currentEntryIdExtension" />
