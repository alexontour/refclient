                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="antiBodyAuthorOrganizationAddress">
                        <xsl:call-template name="getAntiBodyAuthorOrganizationAddressByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:variable name="antiBodyAuthorOrganizationTelecom">
                        <xsl:call-template name="getAntiBodyAuthorOrganizationTelecomByEntryId">
                            <xsl:with-param name="root" select="$currentEntryIdRoot" />
                            <xsl:with-param name="extension" select="$currentEntryIdExtension" />
                        </xsl:call-template>
                    </xsl:variable>

                    <xsl:choose>
                        <xsl:when test="$antiBodyAuthorName != '' or $antiBodyAuthorDeviceName != '' or $antiBodyAuthorRole != '' or $antiBodyAuthorOrganizationName != '' or
                                        $antiBodyAuthorOrganizationAddress !='' or $antiBodyAuthorOrganizationTelecom != ''">
                            <xsl:variable name="authorTitle">
                                <xsl:choose>
                                    <xsl:when test="$isAntiBodyAuthorDeviceNameAvailable='true'">
                                        <xsl:text>Datenerstellendes System:</xsl:text>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <xsl:text>Med. verantwortl. Person</xsl:text>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </xsl:variable>
                            <xsl:call-template name="renderVaccinationDetails">
                                <xsl:with-param name="title" select="$authorTitle" />
