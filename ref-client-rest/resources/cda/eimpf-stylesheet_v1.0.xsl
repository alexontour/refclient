                <xsl:with-param name="extension" select="$extension"/>
            </xsl:call-template>
        </xsl:if>

        <xsl:if test="$hasVaccinationDose='true'">
            <xsl:text>, </xsl:text>
        </xsl:if>

        <xsl:call-template name="getVaccinationSchemeByEntryId">
            <xsl:with-param name="root" select="$root"/>
            <xsl:with-param name="extension" select="$extension"/>
        </xsl:call-template>
    </xsl:template>

