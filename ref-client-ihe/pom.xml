<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>ref-client-ihe</artifactId>
	<name>ref-client-ihe</name>
	<parent>
		<groupId>elga</groupId>
		<artifactId>ref-client</artifactId>
		<version>1.0.0</version>
	</parent>
	<url>http://maven.apache.org</url>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<hapi.fhir.version>5.7.2</hapi.fhir.version>
		<jackson.version>2.10.1</jackson.version>
		<skip.assembly>false</skip.assembly>
		<husky.version>2.0-ALPHA</husky.version>
		<ipf.version>4.2.0</ipf.version>
		<log4j2.version>2.17.2</log4j2.version>
	</properties>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.axis2</groupId>
				<artifactId>axis2-mar-maven-plugin</artifactId>
				<version>1.7.9</version>
				<extensions>true</extensions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>${maven.resources.plugin.version}</version>
				<executions>
					<execution>
						<id>copy_schemaorg_apache_xmlbeans</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/classes/schemaorg_apache_xmlbeans</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}/resources/schemaorg_apache_xmlbeans</directory>
									<filtering>false</filtering>
								</resource>
							</resources>
							<encoding>${project.build.sourceEncoding}</encoding>
						</configuration>
					</execution>
					<execution>
						<id>copy_message_properties</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<overwrite>true</overwrite>
							<outputDirectory>${project.build.directory}/classes</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}/resources</directory>
									<filtering>false</filtering>
									<includes>
										<include>**/*.properties</include>
									</includes>
									<excludes>
										<exclude>**/*.xsd</exclude>
										<exclude>**/*.wsdl</exclude>
										<exclude>**/*.xml</exclude>
										<exclude>**/*.html</exclude>
										<exclude>**/*.xsl</exclude>
										<exclude>**/*.ucls</exclude>
										<exclude>**/*.config</exclude>
									</excludes>
								</resource>
							</resources>
							<encoding>${project.build.sourceEncoding}</encoding>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<repositories>
		<!-- Resolve supplied libraries and standard packages before the IHE fallback. -->
		<repository>
			<id>my-local-repo</id>
			<url>file://${project.basedir}/librariesNeeded/repo</url>
		</repository>
		<repository>
			<id>mvnrepository.com</id>
