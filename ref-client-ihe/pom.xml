	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.axis2</groupId>
				<artifactId>axis2-mar-maven-plugin</artifactId>
				<version>1.7.9</version>
				<extensions>true</extensions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>${maven.resources.plugin.version}</version>
				<executions>
					<execution>
						<id>copy_schemaorg_apache_xmlbeans</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/classes/schemaorg_apache_xmlbeans</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}/resources/schemaorg_apache_xmlbeans</directory>
									<filtering>false</filtering>
								</resource>
							</resources>
							<encoding>${project.build.sourceEncoding}</encoding>
						</configuration>
					</execution>
					<execution>
						<id>copy_message_properties</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<overwrite>true</overwrite>
							<outputDirectory>${project.build.directory}/classes</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}/resources</directory>
									<filtering>false</filtering>
									<includes>
										<include>**/*.properties</include>
									</includes>
									<excludes>
										<exclude>**/*.xsd</exclude>
										<exclude>**/*.wsdl</exclude>
										<exclude>**/*.xml</exclude>
										<exclude>**/*.html</exclude>
										<exclude>**/*.xsl</exclude>
										<exclude>**/*.ucls</exclude>
										<exclude>**/*.config</exclude>
									</excludes>
								</resource>
							</resources>
							<encoding>${project.build.sourceEncoding}</encoding>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
